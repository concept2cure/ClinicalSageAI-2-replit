<?xml version="1.0" encoding="UTF-8"?>
<!-- Health Canada eCTD Template v4.0 - Canadian regulatory submission structure.
     Module 1 follows the Health Canada "Preparation of Drug Regulatory Activities
     in the electronic Common Technical Document (eCTD) Format" guidance. Modules
     2-5 are ICH-harmonised and shared with the FDA/EMA backbones. -->
<ectd-submission xmlns="http://www.hc-sc.gc.ca/ectd/backbone" version="4.0">
  <administrative-information>
    <submission-info>
      <submission-type>original</submission-type>
      <submission-number/>
      <application-type>nds</application-type>
      <dossier-id/>
      <sequence-number>0000</sequence-number>
    </submission-info>
    <applicant-info>
      <applicant-name/>
      <contact-person/>
      <address/>
      <company-dossier-number/>
    </applicant-info>
  </administrative-information>

  <module-1 title="Administrative Information (Health Canada Regional)">
    <m1-0 title="Correspondence">
      <m1-0-1 title="Cover Letter"/>
      <m1-0-2 title="Health Canada Meeting Correspondence"/>
    </m1-0>
    <m1-1 title="Comprehensive Table of Contents"/>
    <m1-2 title="Administrative Information">
      <m1-2-1 title="Drug Submission Application Form (HC/SC)"/>
      <m1-2-2 title="Fee Form"/>
      <m1-2-3 title="Certification and Attestation Forms"/>
      <m1-2-4 title="Patent Information (Patented Medicines / Register)"/>
    </m1-2>
    <m1-3 title="Product Information">
      <m1-3-1 title="Product Monograph"/>
      <m1-3-2 title="Labels (Inner and Outer)"/>
      <m1-3-3 title="Package Insert / Consumer Information"/>
      <m1-3-4 title="Look-alike Sound-alike (LASA) Assessment"/>
    </m1-3>
    <m1-4 title="Health Canada Summaries">
      <m1-4-1 title="Certified Product Information Document (CPID)"/>
    </m1-4>
    <m1-5 title="Environmental Assessment"/>
    <m1-6 title="Risk Management Plan (Canadian Addendum)"/>
  </module-1>

  <module-2 title="Common Technical Document Summaries">
    <m2-1 title="CTD Table of Contents"/>
    <m2-2 title="Introduction"/>
    <m2-3 title="Quality Overall Summary">
      <m2-3-s title="Drug Substance"/>
      <m2-3-p title="Drug Product"/>
    </m2-3>
    <m2-4 title="Nonclinical Overview"/>
    <m2-5 title="Clinical Overview"/>
    <m2-6 title="Nonclinical Written and Tabulated Summaries"/>
    <m2-7 title="Clinical Summary"/>
  </module-2>

  <module-3 title="Quality">
    <m3-1 title="Table of Contents of Module 3"/>
    <m3-2 title="Body of Data (Drug Substance and Drug Product)"/>
    <m3-3 title="Literature References"/>
  </module-3>

  <module-4 title="Nonclinical Study Reports">
    <m4-1 title="Table of Contents of Module 4"/>
    <m4-2 title="Study Reports"/>
    <m4-3 title="Literature References"/>
  </module-4>

  <module-5 title="Clinical Study Reports">
    <m5-1 title="Table of Contents of Module 5"/>
    <m5-2 title="Tabular Listing of All Clinical Studies"/>
    <m5-3 title="Clinical Study Reports"/>
    <m5-4 title="Literature References"/>
  </module-5>

  <compliance-requirements>
    <required-sections>
      <section id="m1-3-1" mandatory="true" description="Product Monograph required for all NDS submissions"/>
      <section id="m1-2-1" mandatory="true" description="Drug Submission Application Form required"/>
      <section id="m2-3" mandatory="true" description="Quality Overall Summary required"/>
      <section id="m2-5" mandatory="true" description="Clinical Overview required"/>
    </required-sections>
    <validation-rules>
      <rule id="product-monograph-present" mandatory-content="indications,dosage,warnings,clinical-pharmacology"/>
      <rule id="bilingual-labeling" description="Labels and Product Monograph must satisfy Canadian bilingual (EN/FR) requirements"/>
    </validation-rules>
  </compliance-requirements>
</ectd-submission>
