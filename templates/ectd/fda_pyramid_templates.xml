
<?xml version="1.0" encoding="UTF-8"?>
<!-- FDA eCTD Pyramid Templates - Comprehensive Structure for All Application Types -->
<ectd-pyramid-templates xmlns="http://www.fda.gov/ectd/pyramid" version="4.0">
  
  <!-- IND (Investigational New Drug) Pyramid Template -->
  <pyramid-template type="IND" id="fda-ind-pyramid">
    <title>FDA IND eCTD Pyramid Structure</title>
    <description>Complete eCTD pyramid structure for IND submissions to FDA</description>
    
    <module-1 title="Administrative Information and Prescribing Information">
      <section id="1.0" title="Cover Letter" required="true">
        <guidance>Brief introduction to the submission with key highlights</guidance>
        <content-type>administrative</content-type>
        <estimated-pages>2-5</estimated-pages>
      </section>
      
      <section id="1.1" title="Comprehensive Table of Contents" required="true">
        <guidance>Complete listing of all documents in the submission</guidance>
        <content-type>navigation</content-type>
        <auto-generated>true</auto-generated>
      </section>
      
      <section id="1.2" title="Application Forms" required="true">
        <subsection id="1.2.1" title="Form FDA 1571" required="true">
          <guidance>Investigational New Drug Application form</guidance>
          <template-file>form_1571_template.pdf</template-file>
        </subsection>
        <subsection id="1.2.2" title="Form FDA 1572" required="false">
          <guidance>Statement of Investigator form (if applicable)</guidance>
          <template-file>form_1572_template.pdf</template-file>
        </subsection>
        <subsection id="1.2.3" title="Form FDA 3674" required="false">
          <guidance>Certification of Financial Interests</guidance>
          <template-file>form_3674_template.pdf</template-file>
        </subsection>
      </section>
      
      <section id="1.3" title="Product Information" required="true">
        <guidance>Basic product identification and classification</guidance>
        <content-requirements>
          <item>Generic name and proprietary name (if any)</item>
          <item>Chemical name and structure</item>
          <item>Therapeutic category</item>
          <item>Route of administration</item>
        </content-requirements>
      </section>
      
      <section id="1.4" title="Information about the Experts" required="true">
        <guidance>Qualifications of key personnel involved in the study</guidance>
        <content-requirements>
          <item>Principal Investigator CV</item>
          <item>Medical Monitor information</item>
          <item>Sponsor medical officer details</item>
        </content-requirements>
      </section>
      
      <section id="1.5" title="Specific Requirements for Different Regions" required="false">
        <guidance>US-specific regulatory requirements and regional information</guidance>
      </section>
    </module-1>
    
    <module-2 title="Common Technical Document Summaries">
      <section id="2.1" title="Table of Contents of Module 2" required="true">
        <auto-generated>true</auto-generated>
      </section>
      
      <section id="2.2" title="Introduction" required="true">
        <guidance>General introduction to the investigational product</guidance>
        <content-requirements>
          <item>Chemical or nonproprietary name</item>
          <item>All active ingredients</item>
          <item>Pharmacological class</item>
          <item>Proposed clinical use</item>
          <item>Approach to therapy</item>
        </content-requirements>
        <word-count>500-2000</word-count>
      </section>
      
      <section id="2.3" title="Quality Overall Summary" required="true">
        <subsection id="2.3.S" title="Drug Substance">
          <guidance>Summary of drug substance information</guidance>
          <content-requirements>
            <item>General information and nomenclature</item>
            <item>Manufacturing summary</item>
            <item>Characterization summary</item>
            <item>Control of drug substance summary</item>
            <item>Reference standards summary</item>
            <item>Container closure system summary</item>
            <item>Stability summary</item>
          </content-requirements>
        </subsection>
        <subsection id="2.3.P" title="Drug Product">
          <guidance>Summary of drug product information</guidance>
          <content-requirements>
            <item>Description and composition</item>
            <item>Pharmaceutical development summary</item>
            <item>Manufacturing summary</item>
            <item>Control of excipients summary</item>
            <item>Control of drug product summary</item>
            <item>Reference standards summary</item>
            <item>Container closure system summary</item>
            <item>Stability summary</item>
          </content-requirements>
        </subsection>
      </section>
      
      <section id="2.4" title="Nonclinical Overview" required="true">
        <guidance>Integrated overview of nonclinical data</guidance>
        <content-requirements>
          <item>Pharmacology overview</item>
          <item>Pharmacokinetics overview</item>
          <item>Toxicology overview</item>
          <item>Integrated summary and conclusions</item>
        </content-requirements>
        <word-count>5000-15000</word-count>
      </section>
      
      <section id="2.5" title="Clinical Overview" required="true">
        <guidance>Critical analysis of clinical data supporting the IND</guidance>
        <content-requirements>
          <item>Product development strategy</item>
          <item>Overview of biopharmaceutics</item>
          <item>Overview of clinical pharmacology</item>
          <item>Overview of efficacy (if applicable)</item>
          <item>Overview of safety</item>
          <item>Benefits and risks conclusions</item>
        </content-requirements>
        <word-count>10000-30000</word-count>
      </section>
      
      <section id="2.6" title="Nonclinical Written and Tabulated Summaries" required="true">
        <guidance>Detailed summaries of nonclinical studies</guidance>
      </section>
      
      <section id="2.7" title="Clinical Summary" required="false">
        <guidance>Detailed clinical summaries (if clinical data available)</guidance>
      </section>
    </module-2>
    
    <module-3 title="Quality">
      <section id="3.1" title="Table of Contents of Module 3" required="true">
        <auto-generated>true</auto-generated>
      </section>
      
      <section id="3.2" title="Body of Data" required="true">
        <subsection id="3.2.S" title="Drug Substance">
          <subsection id="3.2.S.1" title="General Information">
            <content-requirements>
              <item>Nomenclature</item>
              <item>Structure</item>
              <item>General properties</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.S.2" title="Manufacture">
            <content-requirements>
              <item>Manufacturer information</item>
              <item>Description of manufacturing process</item>
              <item>Control of materials</item>
              <item>Controls of critical steps</item>
              <item>Process validation and/or evaluation</item>
              <item>Manufacturing process development</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.S.3" title="Characterisation">
            <content-requirements>
              <item>Elucidation of structure</item>
              <item>Impurities</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.S.4" title="Control of Drug Substance">
            <content-requirements>
              <item>Specification</item>
              <item>Analytical procedures</item>
              <item>Validation of analytical procedures</item>
              <item>Batch analyses</item>
              <item>Justification of specification</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.S.5" title="Reference Standards or Materials">
            <content-requirements>
              <item>Reference standard characterization</item>
              <item>Certificate of analysis</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.S.6" title="Container Closure System">
            <content-requirements>
              <item>Description of container closure system</item>
              <item>Specification for primary packaging</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.S.7" title="Stability">
            <content-requirements>
              <item>Stability summary and conclusions</item>
              <item>Post-approval stability protocol</item>
              <item>Stability data</item>
            </content-requirements>
          </subsection>
        </subsection>
        
        <subsection id="3.2.P" title="Drug Product">
          <subsection id="3.2.P.1" title="Description and Composition of the Drug Product">
            <content-requirements>
              <item>Description</item>
              <item>Composition</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.P.2" title="Pharmaceutical Development">
            <content-requirements>
              <item>Components of the drug product</item>
              <item>Drug product</item>
              <item>Manufacturing process development</item>
              <item>Container closure system</item>
              <item>Microbiological attributes</item>
              <item>Compatibility</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.P.3" title="Manufacture">
            <content-requirements>
              <item>Manufacturer information</item>
              <item>Batch formula</item>
              <item>Description of manufacturing process</item>
              <item>Controls of critical steps</item>
              <item>Process validation</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.P.4" title="Control of Excipients">
            <content-requirements>
              <item>Specifications for excipients</item>
              <item>Analytical procedures</item>
              <item>Validation of analytical procedures</item>
              <item>Justification of specifications</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.P.5" title="Control of Drug Product">
            <content-requirements>
              <item>Specification</item>
              <item>Analytical procedures</item>
              <item>Validation of analytical procedures</item>
              <item>Batch analyses</item>
              <item>Characterisation of impurities</item>
              <item>Justification of specification</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.P.6" title="Reference Standards or Materials">
            <content-requirements>
              <item>Reference standard information</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.P.7" title="Container Closure System">
            <content-requirements>
              <item>Description</item>
              <item>Specification</item>
            </content-requirements>
          </subsection>
          <subsection id="3.2.P.8" title="Stability">
            <content-requirements>
              <item>Stability summary and conclusion</item>
              <item>Post-approval stability protocol</item>
              <item>Stability data</item>
            </content-requirements>
          </subsection>
        </subsection>
      </section>
      
      <section id="3.3" title="Literature References" required="false">
        <guidance>Supporting literature for quality information</guidance>
      </section>
    </module-3>
    
    <module-4 title="Nonclinical Study Reports">
      <section id="4.1" title="Table of Contents of Module 4" required="true">
        <auto-generated>true</auto-generated>
      </section>
      
      <section id="4.2" title="Study Reports" required="true">
        <subsection id="4.2.1" title="Pharmacology">
          <subsection id="4.2.1.1" title="Primary Pharmacodynamics">
            <guidance>Studies that investigate the mode of action and/or effects of the substance on physiological functions related to the therapeutic target</guidance>
          </subsection>
          <subsection id="4.2.1.2" title="Secondary Pharmacodynamics">
            <guidance>Studies that investigate the mode of action and/or effects of the substance on physiological functions not related to the therapeutic target</guidance>
          </subsection>
          <subsection id="4.2.1.3" title="Safety Pharmacology">
            <guidance>Studies that investigate the potential undesirable pharmacodynamic effects of a substance on physiological functions</guidance>
            <content-requirements>
              <item>CNS safety pharmacology</item>
              <item>Cardiovascular safety pharmacology</item>
              <item>Respiratory safety pharmacology</item>
            </content-requirements>
          </subsection>
          <subsection id="4.2.1.4" title="Pharmacodynamic Drug Interactions">
            <guidance>Studies investigating pharmacodynamic interactions</guidance>
          </subsection>
        </subsection>
        
        <subsection id="4.2.2" title="Pharmacokinetics">
          <subsection id="4.2.2.1" title="Analytical Methods and Validation Reports">
            <guidance>Bioanalytical method validation reports</guidance>
          </subsection>
          <subsection id="4.2.2.2" title="Absorption">
            <guidance>Studies on absorption characteristics</guidance>
          </subsection>
          <subsection id="4.2.2.3" title="Distribution">
            <guidance>Studies on distribution characteristics</guidance>
          </subsection>
          <subsection id="4.2.2.4" title="Metabolism">
            <guidance>Studies on metabolic pathways and metabolite identification</guidance>
          </subsection>
          <subsection id="4.2.2.5" title="Excretion">
            <guidance>Studies on elimination pathways</guidance>
          </subsection>
          <subsection id="4.2.2.6" title="Pharmacokinetic Drug Interactions">
            <guidance>Studies investigating pharmacokinetic interactions</guidance>
          </subsection>
          <subsection id="4.2.2.7" title="Other Pharmacokinetic Studies">
            <guidance>Additional PK studies not covered elsewhere</guidance>
          </subsection>
        </subsection>
        
        <subsection id="4.2.3" title="Toxicology">
          <subsection id="4.2.3.1" title="Single-Dose Toxicity">
            <guidance>Acute toxicity studies</guidance>
          </subsection>
          <subsection id="4.2.3.2" title="Repeat-Dose Toxicity">
            <guidance>Studies with repeated administration</guidance>
            <content-requirements>
              <item>Studies up to 4 weeks</item>
              <item>Studies from 4 weeks to 3 months</item>
              <item>Studies 3 months and longer</item>
            </content-requirements>
          </subsection>
          <subsection id="4.2.3.3" title="Genotoxicity">
            <guidance>Studies investigating genetic toxicity</guidance>
            <content-requirements>
              <item>In vitro gene mutation studies</item>
              <item>In vitro chromosome damage studies</item>
              <item>In vivo studies for genotoxicity</item>
            </content-requirements>
          </subsection>
          <subsection id="4.2.3.4" title="Carcinogenicity">
            <guidance>Studies investigating carcinogenic potential (if applicable)</guidance>
          </subsection>
          <subsection id="4.2.3.5" title="Reproductive and Developmental Toxicity">
            <guidance>Studies investigating effects on reproduction and development</guidance>
            <content-requirements>
              <item>Fertility and early embryonic development</item>
              <item>Embryo-fetal development</item>
              <item>Pre- and post-natal development</item>
            </content-requirements>
          </subsection>
          <subsection id="4.2.3.6" title="Local Tolerance">
            <guidance>Studies investigating local effects at site of administration</guidance>
          </subsection>
          <subsection id="4.2.3.7" title="Other Toxicity Studies">
            <guidance>Specialized toxicity studies</guidance>
            <content-requirements>
              <item>Antigenicity studies</item>
              <item>Immunotoxicity studies</item>
              <item>Mechanistic studies</item>
              <item>Dependence studies</item>
              <item>Metabolite toxicity studies</item>
              <item>Impurity toxicity studies</item>
              <item>Other studies</item>
            </content-requirements>
          </subsection>
        </subsection>
      </section>
      
      <section id="4.3" title="Literature References" required="false">
        <guidance>Supporting literature for nonclinical information</guidance>
      </section>
    </module-4>
    
    <module-5 title="Clinical Study Reports">
      <section id="5.1" title="Table of Contents of Module 5" required="true">
        <auto-generated>true</auto-generated>
      </section>
      
      <section id="5.2" title="Tabular Listing of All Clinical Studies" required="false">
        <guidance>Comprehensive listing of all clinical studies (if any clinical data)</guidance>
      </section>
      
      <section id="5.3" title="Clinical Study Reports" required="false">
        <guidance>Individual clinical study reports (if any clinical data available)</guidance>
        <subsection id="5.3.1" title="Reports of Biopharmaceutic Studies">
          <guidance>Bioavailability, bioequivalence, and other biopharmaceutic studies</guidance>
        </subsection>
        <subsection id="5.3.2" title="Reports of Studies Pertinent to Pharmacokinetics using Human Biomaterials">
          <guidance>In vitro studies using human biomaterials</guidance>
        </subsection>
        <subsection id="5.3.3" title="Reports of Human Pharmacokinetic Studies">
          <guidance>Clinical pharmacokinetic studies</guidance>
        </subsection>
        <subsection id="5.3.4" title="Reports of Human Pharmacodynamic Studies">
          <guidance>Clinical pharmacodynamic studies</guidance>
        </subsection>
        <subsection id="5.3.5" title="Reports of Efficacy and Safety Studies">
          <guidance>Clinical efficacy and safety studies</guidance>
        </subsection>
        <subsection id="5.3.6" title="Reports of Postmarketing Experience">
          <guidance>Post-marketing surveillance data (if applicable)</guidance>
        </subsection>
        <subsection id="5.3.7" title="Case Report Forms and Individual Patient Listings">
          <guidance>Supporting clinical data documentation</guidance>
        </subsection>
      </section>
      
      <section id="5.4" title="Literature References" required="false">
        <guidance>Supporting literature for clinical information</guidance>
      </section>
    </module-5>
  </pyramid-template>
  
  <!-- NDA (New Drug Application) Pyramid Template -->
  <pyramid-template type="NDA" id="fda-nda-pyramid">
    <title>FDA NDA eCTD Pyramid Structure</title>
    <description>Complete eCTD pyramid structure for NDA submissions to FDA</description>
    <inherits-from>fda-ind-pyramid</inherits-from>
    
    <!-- Enhanced requirements for NDA -->
    <module-1-enhancements>
      <additional-sections>
        <section id="1.6" title="Risk Evaluation and Mitigation Strategies (REMS)" required="conditional">
          <guidance>REMS proposal if required for safe use</guidance>
        </section>
        <section id="1.7" title="Proposed Labeling" required="true">
          <guidance>Draft labeling for the drug product</guidance>
          <content-requirements>
            <item>Prescribing Information</item>
            <item>Patient labeling (if applicable)</item>
            <item>Container and carton labeling</item>
          </content-requirements>
        </section>
      </additional-sections>
    </module-1-enhancements>
    
    <module-5-enhancements>
      <enhanced-requirements>
        <section id="5.2" required="true">
          <guidance>Must include comprehensive clinical study listings</guidance>
        </section>
        <section id="5.3" required="true">
          <guidance>Must include all pivotal clinical study reports</guidance>
          <minimum-studies>2</minimum-studies>
          <study-types>
            <type>Adequate and well-controlled studies</type>
            <type>Dose-ranging studies</type>
            <type>Drug-drug interaction studies</type>
            <type>Special population studies</type>
          </study-types>
        </section>
      </enhanced-requirements>
    </module-5-enhancements>
  </pyramid-template>
  
  <!-- BLA (Biologics License Application) Pyramid Template -->
  <pyramid-template type="BLA" id="fda-bla-pyramid">
    <title>FDA BLA eCTD Pyramid Structure</title>
    <description>Complete eCTD pyramid structure for BLA submissions to FDA</description>
    <inherits-from>fda-nda-pyramid</inherits-from>
    
    <!-- Biologics-specific enhancements -->
    <module-3-enhancements>
      <biologics-specific>
        <section id="3.2.S.2.3" title="Adventitious Agents Safety Evaluation" required="true">
          <guidance>Comprehensive adventitious agent testing and evaluation</guidance>
        </section>
        <section id="3.2.P.5.6" title="Immunogenicity" required="true">
          <guidance>Immunogenicity assessment and risk mitigation</guidance>
        </section>
        <section id="3.2.P.8.1" title="Stability Protocol for Biologics" required="true">
          <guidance>Biologics-specific stability considerations</guidance>
        </section>
      </biologics-specific>
    </module-3-enhancements>
    
    <module-4-enhancements>
      <biologics-toxicology>
        <section id="4.2.3.8" title="Immunotoxicity" required="true">
          <guidance>Enhanced immunotoxicity evaluation for biologics</guidance>
        </section>
        <section id="4.2.3.9" title="Tissue Cross-Reactivity" required="true">
          <guidance>Cross-reactivity studies in human tissues</guidance>
        </section>
      </biologics-toxicology>
    </module-4-enhancements>
  </pyramid-template>
  
  <!-- 510(k) Device Template -->
  <pyramid-template type="510K" id="fda-510k-pyramid">
    <title>FDA 510(k) Submission Structure</title>
    <description>Complete structure for 510(k) medical device submissions</description>
    
    <section id="1" title="Cover Letter" required="true">
      <guidance>Introduction and submission overview</guidance>
    </section>
    
    <section id="2" title="510(k) Summary or 510(k) Statement" required="true">
      <guidance>Either a 510(k) summary or statement of substantial equivalence</guidance>
    </section>
    
    <section id="3" title="Indications for Use Statement" required="true">
      <guidance>Specific intended use of the device</guidance>
    </section>
    
    <section id="4" title="Substantial Equivalence Comparison" required="true">
      <guidance>Detailed comparison with predicate device(s)</guidance>
      <content-requirements>
        <item>Predicate device identification</item>
        <item>Device description comparison</item>
        <item>Intended use comparison</item>
        <item>Technological characteristics</item>
        <item>Performance data comparison</item>
      </content-requirements>
    </section>
    
    <section id="5" title="Device Description" required="true">
      <guidance>Comprehensive description of the device</guidance>
    </section>
    
    <section id="6" title="Performance Testing" required="conditional">
      <guidance>Performance testing data to support substantial equivalence</guidance>
    </section>
    
    <section id="7" title="Software Documentation" required="conditional">
      <guidance>Software validation and verification (if applicable)</guidance>
    </section>
    
    <section id="8" title="Labeling" required="true">
      <guidance>Proposed labeling for the device</guidance>
    </section>
    
    <section id="9" title="Risk Analysis" required="conditional">
      <guidance>Risk assessment (if required)</guidance>
    </section>
  </pyramid-template>
  
  <!-- Validation Rules for Templates -->
  <validation-rules>
    <rule id="module-completeness">
      <description>All required modules must be present</description>
      <validation-type>structural</validation-type>
    </rule>
    
    <rule id="section-numbering">
      <description>Section numbering must follow eCTD conventions</description>
      <validation-type>format</validation-type>
    </rule>
    
    <rule id="content-requirements">
      <description>Required content elements must be addressed</description>
      <validation-type>content</validation-type>
    </rule>
    
    <rule id="ich-compliance">
      <description>Templates must comply with ICH M4 guidelines</description>
      <validation-type>regulatory</validation-type>
    </rule>
    
    <rule id="fda-specific">
      <description>FDA-specific requirements must be included</description>
      <validation-type>regional</validation-type>
    </rule>
  </validation-rules>
  
  <!-- Template Metadata -->
  <metadata>
    <version>4.0</version>
    <last-updated>2025-01-11</last-updated>
    <created-by>TrialSage eCTD Template System</created-by>
    <regulatory-basis>
      <guideline>ICH M4(R4)</guideline>
      <guideline>FDA eCTD Technical Specification</guideline>
      <guideline>21 CFR Part 314</guideline>
      <guideline>21 CFR Part 601</guideline>
    </regulatory-basis>
    <compatible-regions>
      <region>United States (FDA)</region>
    </compatible-regions>
  </metadata>
</ectd-pyramid-templates>
