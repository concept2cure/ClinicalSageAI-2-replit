<?xml version="1.0" encoding="UTF-8"?>
<!-- EMA eCTD Template v4.0 - European regulatory submission structure -->
<ectd-submission xmlns="http://www.ema.europa.eu/ectd/backbone" version="4.0">
  <administrative-information>
    <submission-info>
      <submission-type>initial</submission-type>
      <submission-number/>
      <application-type>cta</application-type>
      <eudract-number/>
      <sequence-number>0000</sequence-number>
    </submission-info>
    <sponsor-info>
      <sponsor-name/>
      <contact-person/>
      <address/>
      <eudract-sponsor-number/>
    </sponsor-info>
  </administrative-information>
  
  <module-1 title="Administrative Information and Product Information">
    <m1-1 title="Cover Letter"/>
    <m1-2 title="Administrative Forms">
      <m1-2-1 title="Application Form"/>
      <m1-2-2 title="Product Information"/>
    </m1-2>
    <m1-3 title="Product Information">
      <m1-3-1 title="Summary of Product Characteristics"/>
      <m1-3-2 title="Labelling"/>
      <m1-3-3 title="Package Leaflet"/>
    </m1-3>
    <m1-4 title="Information about the Experts"/>
    <m1-5 title="Specific Requirements for Different Types of Applications"/>
  </module-1>
  
  <module-2 title="Common Technical Document Summaries">
    <m2-1 title="Overall Summary of Module 2"/>
    <m2-2 title="Introduction">
      <m2-2-1 title="Chemical Name"/>
      <m2-2-2 title="General Properties"/>
      <m2-2-3 title="Proposed Clinical Use"/>
    </m2-2>
    <m2-3 title="Quality Overall Summary">
      <m2-3-s title="Drug Substance"/>
      <m2-3-p title="Drug Product"/>
      <m2-3-a title="Appendices"/>
    </m2-3>
    <m2-4 title="Non-clinical Overview">
      <m2-4-1 title="Pharmacology"/>
      <m2-4-2 title="Pharmacokinetics"/>
      <m2-4-3 title="Toxicology"/>
      <m2-4-4 title="Integrated Overview and Conclusions"/>
    </m2-4>
    <m2-5 title="Clinical Overview">
      <m2-5-1 title="Product Development"/>
      <m2-5-2 title="Overview of Biopharmaceutics"/>
      <m2-5-3 title="Overview of Clinical Pharmacology"/>
      <m2-5-4 title="Overview of Efficacy"/>
      <m2-5-5 title="Overview of Safety"/>
      <m2-5-6 title="Benefits and Risks Conclusions"/>
    </m2-5>
    <m2-6 title="Non-clinical Written and Tabulated Summaries"/>
    <m2-7 title="Clinical Summary">
      <m2-7-1 title="Summary of Biopharmaceutic Studies"/>
      <m2-7-2 title="Summary of Clinical Pharmacology Studies"/>
      <m2-7-3 title="Summary of Clinical Efficacy"/>
      <m2-7-4 title="Summary of Clinical Safety"/>
    </m2-7>
  </module-2>
  
  <module-3 title="Quality">
    <m3-1 title="Information on Drug Substance"/>
    <m3-2 title="Information on Drug Product"/>
    <m3-3 title="Literature References"/>
  </module-3>
  
  <module-4 title="Non-clinical Study Reports">
    <m4-1 title="Study Reports"/>
    <m4-2 title="Study Data Tabulations"/>
    <m4-3 title="Literature References"/>
  </module-4>
  
  <module-5 title="Clinical Study Reports">
    <m5-1 title="Tabular Listing of All Clinical Studies"/>
    <m5-2 title="Clinical Overview"/>
    <m5-3 title="Clinical Study Reports"/>
    <m5-4 title="Literature References"/>
  </module-5>
  
  <compliance-requirements>
    <eu-specific-requirements>
      <gdpr-compliance mandatory="true"/>
      <clinical-trials-directive mandatory="true"/>
      <pharmacovigilance-requirements mandatory="true"/>
    </eu-specific-requirements>
    <required-sections>
      <section id="m2-5" mandatory="true" description="Clinical Overview required for CTA submissions"/>
      <section id="m3-1" mandatory="true" description="Drug Substance information required"/>
      <section id="m1-3-1" mandatory="true" description="Summary of Product Characteristics required"/>
    </required-sections>
    <validation-rules>
      <rule id="clinical-overview-length" min-words="1000" max-words="30000"/>
      <rule id="eu-regulatory-compliance" mandatory-content="gcp-compliance,eu-legislation-references"/>
      <rule id="safety-assessment" mandatory-content="adverse-events,risk-assessment,benefit-risk"/>
    </validation-rules>
  </compliance-requirements>
</ectd-submission>