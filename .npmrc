; save=false is intentionally omitted. It suppresses package-lock.json writes on
; `npm install`, so the lockfile silently drifts from node_modules and dependency
; or security fixes fail to persist (npm ci then reinstalls the old versions).
; Keep save on so the lockfile stays authoritative; save-exact pins added deps.
package-lock=true
save-exact=true
legacy-peer-deps=true
registry=https://registry.npmjs.org/
