+  if (v.kind === 'bound') return boundProblem(v, parsed);
+  if (v.kind === 'approximate' && parsed?.kind !== 'approximate') return [reason('VALUE_KIND_MISMATCH', 'value.kind', 'The source value does not establish an approximation.')];
