+    expect(h.query.mock.calls[0][1]).toContainEqual([]);
+  });
+  it('applies permitted programs before window totals and LIMIT', async () => {
+    await listProjectDocuments(42, { limit: 1, allowedProgramIds: [program], currentOnly: true } as any);
