+const seam = vi.hoisted(() => ({ query: vi.fn(), extract: vi.fn(), load: vi.fn(), profile: vi.fn(), warn: vi.fn() }));
+vi.mock('../../../db.js', () => ({ pool: { query: seam.query, connect: async () => ({ query: seam.query, release: () => undefined }) } }));
