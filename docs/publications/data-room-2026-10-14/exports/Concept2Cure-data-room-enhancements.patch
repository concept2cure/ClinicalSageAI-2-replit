+    expect(await receipts.settleReadReceipts([entry(r.result)], [entry(r.result)], map, undefined, { signal: controller.signal })).toBe(0);
+    expect(h.queries).toContain('ROLLBACK'); expect(h.queries).not.toContain('COMMIT');
