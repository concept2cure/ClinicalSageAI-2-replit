+  if ([...row.keys()].some(k => !allowedLabels.has(k))) return [reason('UNSUPPORTED_CONTEXT_QUALIFIER', 'origin.valueAnchor', 'An additional source qualifier is outside the admitted row grammar and cannot be ignored.')];
+  const subjectField = meaning.kind === 'cmc_result' ? 'productRef' : meaning.kind === 'device_test' ? 'deviceRef' : 'assayRef';
+  if (typeof m[subjectField] === 'string' && /\band\b|\bor\b|[,;+]/i.test(String(m[subjectField]))) return [reason('AMBIGUOUS_SOURCE_SUBJECT', `meaning.${subjectField}`, 'A compound source subject does not identify one unambiguous result relation.')];
+  return [];
+}
+function compositeValue(c: CatalogFactCandidate): string {
+  const v = c.value;
+  return v.asWritten + ('unitAsWritten' in v && v.unitAsWritten && !norm(v.asWritten).endsWith(norm(v.unitAsWritten)) ? ` ${v.unitAsWritten}` : '');
+}
+function resultBindingProblems(c: CatalogFactCandidate, row: Map<string, string>): CatalogFactReason[] {
+  const failures: CatalogFactReason[] = [];
+  const property = semantic(String((c.meaning as unknown as Record<string, unknown>).property));
+  const statedProperty = row.get('property');
+  const results = [property, 'value', 'result'].filter(k => row.has(k));
+  const statedValue = row.get(results[0]);
+  if (results.length !== 1) failures.push(reason('AMBIGUOUS_RESULT_BINDING', 'value', 'The supported row must identify exactly one property result.'));
+  if (statedProperty ? semantic(statedProperty) !== property : !row.has(property)) failures.push(reason('PROPERTY_MISMATCH', 'meaning.property', 'The row states a different property, or does not identify this property.'));
+  if (!statedValue || norm(statedValue) !== norm(compositeValue(c)))
+    failures.push(reason('RESULT_BINDING_MISMATCH', 'value', 'The named property result does not preserve the complete written value and unit.'));
+  return failures;
+}
+function fieldContextProblems(c: CatalogFactCandidate, row: Map<string, string>, field: string, labels: string[]): ContextProblems {
+  const pending: CatalogFactReason[] = [], failures: CatalogFactReason[] = [];
+  const expected = (c.meaning as unknown as Record<string, unknown>)[field];
+  const actuals = labels.filter(label => row.has(label)).map(label => row.get(label)!);
+  if (expected === undefined) {
+    if (actuals.length) pending.push(reason('SOURCE_QUALIFIER_NOT_BOUND', `meaning.${field}`, 'A source-stated contextual qualifier must not be omitted from the candidate.'));
+    return { pending, failures };
+  }
+  if (expected === null || expected === 'not_established') return { pending: [reason('MISSING_CONTEXT', `meaning.${field}`, 'A required source context is not stated.')], failures };
+  if (actuals.length !== 1) return { pending: [reason('MISSING_CONTEXT', `meaning.${field}`, 'The supported row does not identify this context unambiguously.')], failures };
+  if (semantic(actuals[0]) !== semantic(String(expected))) failures.push(reason('CONTEXT_VALUE_MISMATCH', `meaning.${field}`, 'The source row identifies a different contextual value.'));
+  const witness = c.origin.witnesses.find(w => w.path === `meaning.${field}`);
+  if (!witness) return { pending: [reason('CONTEXT_WITNESS_REQUIRED', `meaning.${field}`, 'This context requires a source witness.')], failures };
+  const a = witness.anchor, valueAnchor = c.origin.valueAnchor;
+  if (a.range.start < valueAnchor.range.start || a.range.end > valueAnchor.range.end) failures.push(reason('REMOTE_CONTEXT_WITNESS', `meaning.${field}`, 'A remote witness cannot establish this row relation.'));
+  if (!verifyKeyDataAgainstText({ context: semantic(String(expected)) }, semantic(a.exactQuote)).verified) failures.push(reason('CONTEXT_NOT_IN_WITNESS', `meaning.${field}`, 'The contextual value is absent from its source witness.'));
+  return { pending, failures };
+}
+function meaningRelationProblems(meaning: CatalogFactMeaning): ContextProblems {
+  const pending: CatalogFactReason[] = [], failures: CatalogFactReason[] = [];
+  if (meaning.kind === 'ivd_diagnostic') {
+    if (['sensitivity', 'specificity'].includes(meaning.property) && meaning.referenceBasis === 'comparison_method') failures.push(reason('REFERENCE_MEANING_MISMATCH', 'meaning.referenceBasis', 'Agreement against a comparison method does not establish reference-standard sensitivity or specificity.'));
+    if (['positive_agreement', 'negative_agreement'].includes(meaning.property) && meaning.referenceBasis !== 'comparison_method') pending.push(reason('REFERENCE_MEANING_NOT_ESTABLISHED', 'meaning.referenceBasis', 'This preview does not establish comparator agreement without an explicit comparison method.'));
+  }
+  if (meaning.kind === 'device_test' && ((meaning.property === 'bench_result' && meaning.resultRole !== 'measured_result') || (meaning.property === 'acceptance_criterion' && meaning.resultRole !== 'acceptance_criterion')))
+    failures.push(reason('RESULT_ROLE_MISMATCH', 'meaning.resultRole', 'The bench result and acceptance criterion roles are distinct.'));
+  return { pending, failures };
+}
+function nonClinicalContext(c: CatalogFactCandidate): CatalogFactCheck {
+  if (c.meaning.kind === 'pharma_clinical') return check('not_established');
+  const rules = families[c.meaning.kind], row = sourceRow(c);
+  if (!row) return check('not_established', [reason('UNSUPPORTED_CONTEXT_FORM', 'origin.valueAnchor', 'Only an unambiguous single labelled, semicolon-separated source row is supported for this family.')]);
+  const admission = rowAdmissionProblems(c.meaning, rules, row);
+  if (admission.length) return check('not_established', admission);
+  const issues = [meaningRelationProblems(c.meaning), ...Object.entries(rules.labels).map(([field, labels]) => fieldContextProblems(c, row, field, labels))];
+  const failures = [...resultBindingProblems(c, row), ...issues.flatMap(i => i.failures)], pending = issues.flatMap(i => i.pending);
+  return failures.length ? check('failed', [...failures, ...pending]) : pending.length ? check('not_established', pending) : check('passed');
+}
+
+function clinicalContext(c: CatalogFactCandidate, source: CatalogFactSource): CatalogFactCheck {
+  const meaning = c.meaning;
+  if (meaning.kind !== 'pharma_clinical') return check('not_established');
+  if (meaning.frameState === 'incomplete') return check('not_established', meaning.missing.map(path => reason('CLINICAL_FRAME_INCOMPLETE', `meaning.partialFrame.${path}`, 'The clinical frame is incomplete.')));
+  const anchor = c.origin.valueAnchor;
+  // Parse only the exact bounded context. Whole-document inherited headers
+  // cannot establish a relationship outside the candidate's delivered quote.
+  const parsed = extractClaims({ id: source.documentId, role: 'other', text: anchor.exactQuote });
+  const candidates = parsed.claims.filter(claim => !!claim.value[meaning.component]);
+  if (!candidates.length) return check('not_established', [reason('CLINICAL_FORM_NOT_ESTABLISHED', 'meaning.frame', 'The existing clinical engine did not establish a complete anchored claim for this component.')]);
+  const matching = candidates.filter(claim => canonical(claim.frame) === canonical(meaning.frame as ClaimFrame) && norm(claim.value[meaning.component]!.raw) === norm(c.value.asWritten));
+  if (matching.length !== 1) return check(matching.length > 1 ? 'not_established' : 'failed', [reason(matching.length > 1 ? 'AMBIGUOUS_CLINICAL_CONTEXT' : 'CLINICAL_FRAME_MISMATCH', 'meaning.frame', 'The existing clinical engine does not identify one exact matching frame and written component.')]);
+  const required = Object.keys(meaning.frame).filter(k => !['scope', 'analysis'].includes(k) || Object.keys((meaning.frame as unknown as Record<string, object>)[k]).some(key => key !== 'subgroups' || (meaning.frame.scope.subgroups.length > 0)));
+  const missing = required.filter(k => !c.origin.witnesses.some(w => w.path === `meaning.frame.${k}`));
+  if (missing.length) return check('not_established', missing.map(k => reason('CONTEXT_WITNESS_REQUIRED', `meaning.frame.${k}`, 'The parsed clinical frame slot requires a source witness.')));
+  if (meaning.productRef && !c.origin.witnesses.some(w => w.path === 'meaning.productRef' && verifyKeyDataAgainstText({ product: meaning.productRef }, w.anchor.exactQuote).verified))
+    return check('not_established', [reason('CONTEXT_WITNESS_REQUIRED', 'meaning.productRef', 'The product context requires its own source witness.')]);
+  // A witness must cover the parser's recorded contextual clause. A remote
+  // occurrence of a frame label does not attest to the parsed relationship.
+  if (c.origin.witnesses.some(w => w.anchor.range.start !== anchor.range.start || w.anchor.range.end !== anchor.range.end))
+    return check('not_established', [reason('CLINICAL_CONTEXT_WITNESS_INCOMPLETE', 'origin.witnesses', 'Each clinical slot witness must cover the complete bounded context parsed by the existing engine; a bare figure or remote label is insufficient.')]);
+  if (matching[0].loc.start !== 0 || matching[0].loc.end !== anchor.exactQuote.length || Object.values(matching[0].loc.slotFrom).some(from => !['form', 'clause', 'sentence'].includes(from)))
+    return check('not_established', [reason('CLINICAL_CONTEXT_NOT_LOCAL', 'meaning.frame', 'This preview requires one exact local claim context; remote headings, tables, defaults, records and larger containing quotes cannot establish it.')]);
+  return check('passed');
+}
+
+export function verifySourceFactCandidate(candidate: unknown, source: CatalogFactSource): CatalogFactVerification {
+  const sourceView = { documentId: source.documentId, contentHash: source.contentHash, extractedTextSha256: source.extractedTextSha256 };
+  const out: CatalogFactVerification = { ok: false, checkerRevision: CATALOG_FACT_CHECKER_REVISION, candidateSha256: null, source: sourceView, transcription: check('failed'), context: check('not_established'), scientificQualification: 'unassessed', reviewState: 'not_recorded', persisted: false };
+  const validation = validateSourceFactBatch([candidate]);
+  if (!validation.ok) { out.transcription.reasons = validation.reasons; return out; }
+  const c = validation.candidates[0];
+  out.candidateSha256 = hash(canonical(c));
+  if (!UUID.test(source.documentId) || !SHA.test(source.contentHash) || !SHA.test(source.extractedTextSha256) || typeof source.extractedText !== 'string' || !source.extractedText.trim() || hash(source.extractedText) !== source.extractedTextSha256) {
+    out.transcription.reasons = [reason('SOURCE_TEXT_IDENTITY_INVALID', 'source', 'The server source must identify nonempty exact stored text and its actual SHA-256.')]; return out;
+  }
+  const problems = [...anchorProblems(c.origin.valueAnchor, source, 'origin.valueAnchor'), ...c.origin.witnesses.flatMap((w, i) => anchorProblems(w.anchor, source, `origin.witnesses[${i}].anchor`)), ...writtenProblems(c, source)];
+  if (problems.length) { out.transcription.reasons = problems; return out; }
+  out.ok = true;
+  out.transcription = check('passed');
+  out.context = source.extractionCaveat ? check('not_established', [reason('EXTRACTION_CAVEAT', 'source.extractionCaveat', 'Extraction caveats require original or layout review beyond this preview.')]) : c.meaning.kind === 'pharma_clinical' ? clinicalContext(c, source) : nonClinicalContext(c);
+  return out;
+}
diff --git a/server/services/vault/document-catalog-actor-access.ts b/server/services/vault/document-catalog-actor-access.ts
new file mode 100644
index 00000000..9dfbccaf
--- /dev/null
+++ b/server/services/vault/document-catalog-actor-access.ts
@@ -0,0 +1,70 @@
+/** Short interactive source reads share one connection, current role and
+ * canonical project policy. No transaction spans an embedding/provider await. */
+import { pool } from '../../db.js';
+import { getTenantScope } from '../../db/tenantStore.js';
+import { AnaProjectScopeError, readActiveAnaActorRole } from '../ana/project-scope-admission.js';
+import {
+  admitAnaSourceReadScope, revalidateAnaSourceReadScope,
+  type AnaSourceReadScopeInput, type AdmittedAnaSourceReadScope,
+} from '../ana/source-read-scope.js';
+import { setTenantContextTx } from '../tenant/governed-tenant-context.js';
+import type { Queryable } from './document-catalog.service.js';
+
+export type { AnaSourceReadScopeInput, AdmittedAnaSourceReadScope } from '../ana/source-read-scope.js';
+
+export async function withAnaSourceReadScope<T>(
+  input: AnaSourceReadScopeInput,
+  run: (q: Queryable, scope: AdmittedAnaSourceReadScope) => Promise<T>,
+): Promise<T> {
+  // Snapshot only identity input. A model's accessibleProgramIds/role cannot
+  // become authority merely by resembling an admitted DTO.
+  const pinned: AnaSourceReadScopeInput = {
+    organizationId: input.organizationId, userId: input.userId,
+    projectId: input.projectId, projectRef: input.projectRef,
+    requestedProgramId: input.requestedProgramId,
+  };
+  const ambient = getTenantScope();
+  if (!Number.isSafeInteger(pinned.organizationId) || Number(pinned.organizationId) <= 0 ||
+      !Number.isSafeInteger(pinned.userId) || Number(pinned.userId) <= 0 ||
+      !ambient || ambient.tenantId !== String(pinned.organizationId)) {
+    throw new AnaProjectScopeError(403, 'ANA_SOURCE_ACCESS_DENIED', 'A matching identified organization member is required to read sources.');
+  }
+  const q = await pool.connect().catch(() => {
+    throw new AnaProjectScopeError(503, 'ANA_SOURCE_ACCESS_UNAVAILABLE', 'Current source access could not be verified. No source content or complete listing was produced.');
+  });
+  try {
+    await q.query('BEGIN ISOLATION LEVEL READ COMMITTED');
+    await setTenantContextTx(q, Number(pinned.organizationId));
+    const role = await readActiveAnaActorRole(q, pinned);
+    await setTenantContextTx(q, Number(pinned.organizationId), role);
+    const scope = await admitAnaSourceReadScope(q, pinned);
+    if (scope.role !== role) {
+      throw new AnaProjectScopeError(403, 'ANA_SOURCE_SCOPE_CHANGED', 'Current organization membership changed before source admission. No source content was read.');
+    }
+    const result = await run(q, scope);
+    await revalidateAnaSourceReadScope(q, scope);
+    await q.query('COMMIT');
+    return result;
+  } catch (error) {
+    try { await q.query('ROLLBACK'); } catch { /* Preserve the read refusal. */ }
+    if (error instanceof AnaProjectScopeError) throw error;
+    throw new AnaProjectScopeError(503, 'ANA_SOURCE_ACCESS_UNAVAILABLE', 'Current source access could not be verified. No source content or complete listing was produced.');
+  } finally {
+    q.release();
+  }
+}
+
+/** Composite callers pin one initial scope and use this after independent
+ * read awaits. A freshly admitted accessible superset is not the old scope. */
+export function revalidateActorSourceScope(input: AnaSourceReadScopeInput, pinnedScope: AdmittedAnaSourceReadScope): Promise<void> {
+  const pinned = { ...pinnedScope, accessibleProgramIds: [...pinnedScope.accessibleProgramIds] };
+  return withAnaSourceReadScope(input, async (q, current) => {
+    if (current.organizationId !== pinned.organizationId || current.userId !== pinned.userId ||
+        current.role !== pinned.role || current.projectId !== pinned.projectId || current.programId !== pinned.programId ||
+        current.accessibleProgramIds.length !== pinned.accessibleProgramIds.length ||
+        current.accessibleProgramIds.some((id, index) => id !== pinned.accessibleProgramIds[index])) {
+      throw new AnaProjectScopeError(403, 'ANA_SOURCE_SCOPE_CHANGED', 'Current source access changed during this request. No stale source result was returned.');
+    }
+    await revalidateAnaSourceReadScope(q, pinned);
+  });
+}
diff --git a/server/services/vault/document-catalog-actor-captures.ts b/server/services/vault/document-catalog-actor-captures.ts
new file mode 100644
index 00000000..6e24fca7
--- /dev/null
+++ b/server/services/vault/document-catalog-actor-captures.ts
@@ -0,0 +1,148 @@
+/** Chat capture discovery applies current actor policy before counting and
+ * limiting. The first pass reads identities only, never private file headers. */
+import { AnaProjectScopeError } from '../ana/project-scope-admission.js';
+import { assertAnaUploadAccess } from '../ana/source-context-admission.js';
+import { assertAnaSourceProgramAllowed, type AdmittedAnaSourceReadScope, type AnaSourceReadScopeInput } from '../ana/source-read-scope.js';
+import { capturedDataEligibleSql, capturedDispositionChoiceSql, capturedBinaryAvailableSql } from '../document-data-disposition/eligibility.js';
+import { withAnaSourceReadScope } from './document-catalog-actor-access.js';
+import { anaSourceScopeNotice } from './document-catalog-actor-reads.js';
+import type { ChatUploadDigest, ChatUploadPage, Queryable } from './document-catalog.service.js';
+
+export interface ActorChatUploadPage extends ChatUploadPage {
+  total: number;
+  withheld: number;
+  actorFiltered: true;
+  admittedScope: AdmittedAnaSourceReadScope;
+  sourceAccessNotice: string;
+}
+const SHA = /^[0-9a-f]{64}$/i;
+const positive = (v: unknown): v is number => typeof v === 'number' && Number.isSafeInteger(v) && v > 0;
+const identityFailure = (): never => {
+  throw new AnaProjectScopeError(503, 'ANA_UPLOAD_IDENTITY_UNAVAILABLE', 'The exact authorized upload identity could not be verified. No complete file listing was produced.');
+};
+/** Same predicate in both identity admission and final counted page. Anchor
+ * uniqueness covers all same-org rows, before intersecting allowed programs. */
+function captureScopeSql(): string {
+  return `s.organization_id=$1 AND s.deleted_at IS NULL AND s.source_type='client_document'
+    AND s.is_current IS NOT FALSE AND ${capturedDataEligibleSql('s')}
+    AND f.organization_id=$1
+    AND (
+      (source_project.regulatory_program_id=ANY($2::uuid[])
+        AND rp.organization_id=$1 AND rp.deleted_at IS NULL
+        AND (SELECT count(*) FROM projects all_anchor WHERE all_anchor.organization_id=$1
+          AND all_anchor.regulatory_program_id=source_project.regulatory_program_id)=1)
+      OR ($4::boolean AND s.client_program_id IS NULL AND s.client_workspace_id IS NULL
+        AND s.provenance->>'origin'='chat_upload' AND s.created_by=$3 AND f.user_id=$3)
+    )`;
+}
+function captureJoinsSql(): string {
+  return `FROM cre_evidence_sources s
+    JOIN file_uploads f ON f.id=s.provenance->>'fileUploadId' AND f.organization_id=s.organization_id
+    LEFT JOIN projects source_project ON source_project.organization_id=s.organization_id
+      AND ((s.client_program_id IS NOT NULL AND source_project.regulatory_program_id=s.client_program_id
+          AND (s.client_workspace_id IS NULL OR s.client_workspace_id=source_project.id))
+        OR (s.client_program_id IS NULL AND s.client_workspace_id=source_project.id))
+    LEFT JOIN regulatory_programs rp ON rp.id=source_project.regulatory_program_id AND rp.organization_id=s.organization_id`;
+}
+function checkUnboundCapture(row: Record<string, unknown>, scope: AdmittedAnaSourceReadScope): void {
+  if (scope.projectId !== null || Number(row.upload_user_id) !== scope.userId || row.created_by !== scope.userId || row.source_origin !== 'chat_upload') identityFailure();
+}
+function checkBoundCapture(row: Record<string, unknown>, scope: AdmittedAnaSourceReadScope): void {
+  if (!positive(row.source_project_id) || row.program_organization_id !== scope.organizationId || row.program_deleted_at !== null ||
+      typeof row.resolved_program_id !== 'string' || Number(row.anchor_count) !== 1) identityFailure();
+  if ((row.client_workspace_id != null && row.client_workspace_id !== row.source_project_id) ||
+      (row.client_program_id != null && row.client_program_id !== row.resolved_program_id)) identityFailure();
+  assertAnaSourceProgramAllowed(scope, row.resolved_program_id);
+}
+function checkCaptureIdentity(row: Record<string, unknown>, scope: AdmittedAnaSourceReadScope): void {
+  if (!positive(row.id) || row.organization_id !== scope.organizationId || row.upload_organization_id !== scope.organizationId ||
+      typeof row.file_id !== 'string' || !row.file_id.trim()) identityFailure();
+  if (row.client_program_id == null && row.client_workspace_id == null) checkUnboundCapture(row, scope);
+  else checkBoundCapture(row, scope);
+}
+function checkCurrentCapture(row: Record<string, unknown>, scope: AdmittedAnaSourceReadScope, allowedFiles: readonly string[]): void {
+  checkCaptureIdentity(row, scope);
+  if (!allowedFiles.includes(String(row.file_id)) || typeof row.checksum !== 'string' || !SHA.test(row.checksum) ||
+      row.checksum !== row.upload_checksum || row.is_current === false ||
+      row.disposition === 'remove_data' || row.disposition === 'supersede') identityFailure();
+}
+function adaptCapture(row: Record<string, unknown>): ChatUploadDigest {
+  const meta = row.metadata && typeof row.metadata === 'object' && !Array.isArray(row.metadata) ? row.metadata as Record<string, unknown> : {};
+  return {
+    sourceId: Number(row.id), fileId: String(row.file_id),
+    fileName: typeof meta.originalName === 'string' ? meta.originalName : typeof row.title === 'string' ? row.title : 'document',
+    version: typeof row.version === 'string' ? row.version : null,
+    extractionStatus: typeof row.extraction_status === 'string' && row.extraction_status ? row.extraction_status : 'unknown',
+    dossier: meta.dossier ?? null, programId: typeof row.client_program_id === 'string' ? row.client_program_id : null,
+    uploadedAt: String(row.created_at),
+    ...(row.original_file_available === false ? { originalFileAvailable: false, sourceAccessNotice: 'Eligible extracted text retained; original file unavailable.' } : {}),
+  };
+}
+async function admittedUploadFiles(q: Queryable, scope: AdmittedAnaSourceReadScope, candidates: Array<Record<string, unknown>>): Promise<string[]> {
+  const allowedFiles: string[] = [];
+  for (const row of candidates) {
+    checkCaptureIdentity(row, scope);
+    const fileId = String(row.file_id);
+    if (allowedFiles.includes(fileId)) continue;
+    try {
+      await assertAnaUploadAccess(q, { organizationId: scope.organizationId, userId: scope.userId, fileIds: [fileId] });
+      allowedFiles.push(fileId);
+    } catch (error) {
+      // Denied extra parents exclude this upload without disclosing them.
+      // Unknown policy/SQL state remains unavailable.
+      if (!(error instanceof AnaProjectScopeError) || error.status !== 403) throw error;
+    }
+  }
+  return allowedFiles;
+}
+/** Internal admitted-scope primitive: q must be the same stamped connection
+ * as canonical admission. Identity input cannot self-attest to a scope. */
+export async function listChatUploadsInReadScope(
+  q: Queryable,
+  scope: AdmittedAnaSourceReadScope,
+  opts: { limit?: number } = {},
+): Promise<ActorChatUploadPage> {
+  scope = Object.freeze({ ...scope, accessibleProgramIds: Object.freeze([...scope.accessibleProgramIds]) });
+  const requestedLimit = opts.limit ?? 100;
+  const limit = Number.isSafeInteger(requestedLimit) ? Math.min(200, Math.max(1, requestedLimit)) : 100;
+  const params: unknown[] = [scope.organizationId, [...scope.accessibleProgramIds], scope.userId, scope.projectId === null];
+  const identities = `s.id, s.organization_id, s.client_program_id, s.client_workspace_id, s.created_by,
+    s.provenance->>'origin' AS source_origin,
+    f.id AS file_id, f.organization_id AS upload_organization_id, f.user_id AS upload_user_id,
+    source_project.id AS source_project_id, source_project.regulatory_program_id AS resolved_program_id,
+    rp.organization_id AS program_organization_id, rp.deleted_at AS program_deleted_at,
+    (SELECT count(*) FROM projects all_anchor WHERE all_anchor.organization_id=$1
+      AND all_anchor.regulatory_program_id=source_project.regulatory_program_id) AS anchor_count`;
+  const candidateRows = await q.query(`SELECT ${identities} ${captureJoinsSql()} WHERE ${captureScopeSql()} ORDER BY s.id`, params);
+  // No org-wide top-N is filtered after the fact. Canonical upload admission
+  // examines every recorded parent before the final count/rank/LIMIT query.
+  const allowedFiles = await admittedUploadFiles(q, scope, candidateRows.rows);
+  params.push(allowedFiles, limit);
+  const page = await q.query(`SELECT ${identities}, s.title, s.version, s.extraction_status, s.provenance, s.metadata, s.created_at,
+    s.checksum, f.checksum_sha256 AS upload_checksum, s.is_current,
+    ${capturedDispositionChoiceSql('s')} AS disposition,
+    ${capturedBinaryAvailableSql('s')} AS original_file_available,
+    COUNT(*) OVER () AS scope_total
+    ${captureJoinsSql()} WHERE ${captureScopeSql()} AND f.id=ANY($5::text[])
+    ORDER BY s.created_at DESC, s.id DESC LIMIT $6`, params);
+  const uploads = page.rows.map(row => {
+    checkCurrentCapture(row, scope, allowedFiles);
+    return adaptCapture(row);
+  });
+  // Counts include rows outside this returned page. Repeat admission over the
+  // complete pre-count admitted file set, so a newly private parent on an
+  // unreturned upload cannot leave a stale supposedly authorized total.
+  for (const fileId of allowedFiles) {
+    await assertAnaUploadAccess(q, { organizationId: scope.organizationId, userId: scope.userId, fileIds: [fileId] });
+  }
+  const total = page.rows.length ? Number(page.rows[0].scope_total) : 0;
+  if (!Number.isSafeInteger(total) || total < uploads.length || page.rows.some(row => Number(row.scope_total) !== total)) identityFailure();
+  return { uploads, total, withheld: total - uploads.length, hasMore: total > uploads.length,
+    actorFiltered: true, admittedScope: scope, sourceAccessNotice: anaSourceScopeNotice(scope) };
+}
+export function listChatUploadsForActor(input: AnaSourceReadScopeInput, opts: { limit?: number } = {}): Promise<ActorChatUploadPage> {
+  const pinned = { organizationId: input.organizationId, userId: input.userId, projectId: input.projectId,
+    projectRef: input.projectRef, requestedProgramId: input.requestedProgramId };
+  const limit = opts.limit;
+  return withAnaSourceReadScope(pinned, (q, scope) => listChatUploadsInReadScope(q, scope, { limit }));
+}
diff --git a/server/services/vault/document-catalog-actor-reads.ts b/server/services/vault/document-catalog-actor-reads.ts
new file mode 100644
index 00000000..cdc9516d
--- /dev/null
+++ b/server/services/vault/document-catalog-actor-reads.ts
@@ -0,0 +1,121 @@
+/** Actor-aware interactive facades compose raw catalog queries with canonical
+ * read admission; raw primitives remain available for authorized background work. */
+import { createHash } from 'node:crypto';
+import { AnaProjectScopeError } from '../ana/project-scope-admission.js';
+import { assertAnaSourceProgramAllowed, type AnaSourceReadScopeInput, type AdmittedAnaSourceReadScope } from '../ana/source-read-scope.js';
+import { withAnaSourceReadScope } from './document-catalog-actor-access.js';
+import type { CatalogDocumentRow, ProjectDocumentPage, Queryable } from './document-catalog.service.js';
+
+export interface AnaCatalogSourceAccess {
+  actorFiltered: true;
+  currentVersion: boolean;
+  retainedTextOnly: boolean;
+  currentUseEligible: boolean;
+  receiptEligible: boolean;
+  scope: 'open_project' | 'accessible_projects';
+  notice: string;
+}
+export interface ActorCatalogDocumentRow extends CatalogDocumentRow {
+  isCurrent: boolean;
+  admittedScope: AdmittedAnaSourceReadScope;
+  sourceAccess: AnaCatalogSourceAccess;
+  /** SHA of the exact server-loaded extraction; metadata delivery does not
+   * establish that the extraction body was delivered or read. */
+  extractedTextSha256: string | null;
+}
+export interface ActorProjectDocumentPage extends ProjectDocumentPage {
+  admittedScope: AdmittedAnaSourceReadScope;
+  actorFiltered: true;
+  sourceAccessNotice: string;
+}
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const SHA = /^[0-9a-f]{64}$/i;
+const unavailable = (): never => {
+  throw new AnaProjectScopeError(503, 'ANA_SOURCE_IDENTITY_UNAVAILABLE', 'The exact source identity or current extraction could not be verified. No source content was returned.');
+};
+export function anaSourceScopeNotice(scope: AdmittedAnaSourceReadScope): string {
+  return scope.projectId === null
+    ? 'This listing covers only the current actor’s accessible projects and eligible creator-owned unbound uploads. It does not describe every file in the organization.'
+    : 'This listing covers only the admitted open project. It does not describe files in other projects.';
+}
+function checkedSource(doc: CatalogDocumentRow, scope: AdmittedAnaSourceReadScope): void {
+  if (doc.organizationId !== scope.organizationId || !UUID.test(doc.id) || !SHA.test(doc.contentHash) || typeof doc.isCurrent !== 'boolean') unavailable();
+  assertAnaSourceProgramAllowed(scope, doc.programId);
+  if (doc.disposition === 'remove_data' || doc.disposition === 'supersede') unavailable();
+  if (doc.catalog?.contentHash !== undefined && doc.catalog.contentHash !== doc.contentHash) unavailable();
+  if (doc.extractedText !== null && typeof doc.extractedText !== 'string') unavailable();
+}
+function sourceChanged(before: CatalogDocumentRow, after: CatalogDocumentRow): boolean {
+  return before.id !== after.id || before.programId !== after.programId || before.contentHash !== after.contentHash ||
+    before.extractedText !== after.extractedText || before.isCurrent !== after.isCurrent ||
+    before.disposition !== after.disposition || before.originalFileAvailable !== after.originalFileAvailable;
+}
+function hasReceiptCatalog(doc: CatalogDocumentRow): boolean {
+  return doc.catalog !== null && doc.catalog.contentHash === doc.contentHash && doc.catalog.status !== 'extraction_failed';
+}
+function actorDocument(doc: CatalogDocumentRow, scope: AdmittedAnaSourceReadScope, includeText: boolean): ActorCatalogDocumentRow {
+  const isCurrent = doc.isCurrent === true;
+  const retained = doc.disposition === 'keep_data' || doc.originalFileAvailable === false;
+  const textReady = includeText && typeof doc.extractedText === 'string' && doc.extractedText.trim().length > 0;
+  const notices = [anaSourceScopeNotice(scope)];
+  if (!isCurrent) notices.push('This is a historical version. It is available for historical reading and cannot earn a new current-source read receipt or serve as a current drafting source.');
+  if (retained) notices.push('Eligible extracted text was retained; the original file is unavailable and is not reopened by this read.');
+  return {
+    ...doc, extractedText: includeText ? doc.extractedText : null, isCurrent, admittedScope: scope,
+    extractedTextSha256: doc.extractedText !== null ? createHash('sha256').update(doc.extractedText).digest('hex') : null,
+    sourceAccess: { actorFiltered: true, currentVersion: isCurrent, retainedTextOnly: retained,
+      currentUseEligible: isCurrent, receiptEligible: isCurrent && textReady && hasReceiptCatalog(doc),
+      scope: scope.projectId === null ? 'accessible_projects' : 'open_project', notice: notices.join(' ') },
+  };
+}
+interface ReadDeps {
+  load: (documentId: string, organizationId: number, opts: { includeText?: boolean; executor?: Queryable; programId?: string; currentOnly?: boolean; allowedProgramIds?: readonly string[] }) => Promise<CatalogDocumentRow | null>;
+}
+export async function runLoadDocumentForActor(
+  input: AnaSourceReadScopeInput & { documentId: string },
+  opts: { includeText?: boolean; currentOnly?: boolean },
+  deps: ReadDeps,
+): Promise<ActorCatalogDocumentRow | null> {
+  const pinned = { organizationId: input.organizationId, userId: input.userId, projectId: input.projectId,
+    projectRef: input.projectRef, requestedProgramId: input.requestedProgramId, documentId: input.documentId };
+  const includeText = opts.includeText === true;
+  const currentOnly = opts.currentOnly === true;
+  if (typeof pinned.documentId !== 'string' || !UUID.test(pinned.documentId)) {
+    throw new AnaProjectScopeError(400, 'ANA_SOURCE_SELECTION_INVALID', 'Choose a valid source identifier.');
+  }
+  return withAnaSourceReadScope(pinned, async (q, scope) => {
+    // A metadata-only facade still checks the actual stored extraction and
+    // exposes its digest, then strips the body from its returned projection.
+    const loadOpts = { includeText: true, executor: q, currentOnly, allowedProgramIds: scope.accessibleProgramIds,
+      ...(scope.programId ? { programId: scope.programId } : {}) };
+    const doc = await deps.load(pinned.documentId, scope.organizationId, loadOpts);
+    if (!doc) return null;
+    checkedSource(doc, scope);
+    if (doc.id.toLowerCase() !== pinned.documentId.toLowerCase()) unavailable();
+    // A fresh final source read catches extraction/source changes while other
+    // asynchronous database admission work completed. It is a point-in-time
+    // guard, not a continuous delivery or provider acknowledgement.
+    const final = await deps.load(pinned.documentId, scope.organizationId, loadOpts);
+    if (!final) throw new AnaProjectScopeError(409, 'ANA_SOURCE_CHANGED', 'The source changed before it could be returned. Read its current version again.');
+    checkedSource(final, scope);
+    if (sourceChanged(doc, final)) {
+      throw new AnaProjectScopeError(409, 'ANA_SOURCE_CHANGED', 'The source changed before it could be returned. Read its current version again.');
+    }
+    return actorDocument(final, scope, includeText);
+  });
+}
+export async function runListProjectDocumentsForActor(
+  input: AnaSourceReadScopeInput,
+  opts: { limit?: number },
+  list: (organizationId: number, opts: { programId?: string | null; limit?: number; executor?: Queryable; allowedProgramIds?: readonly string[]; currentOnly?: boolean }) => Promise<ProjectDocumentPage>,
+): Promise<ActorProjectDocumentPage> {
+  const pinned = { organizationId: input.organizationId, userId: input.userId, projectId: input.projectId,
+    projectRef: input.projectRef, requestedProgramId: input.requestedProgramId };
+  const limit = opts.limit;
+  return withAnaSourceReadScope(pinned, async (q, scope) => {
+    const page = await list(scope.organizationId, { programId: scope.programId, limit,
+      executor: q, allowedProgramIds: scope.accessibleProgramIds, currentOnly: true });
+    for (const doc of page.documents) assertAnaSourceProgramAllowed(scope, doc.programId);
+    return { ...page, actorFiltered: true, admittedScope: scope, sourceAccessNotice: anaSourceScopeNotice(scope) };
+  });
+}
diff --git a/server/services/vault/document-catalog-admission.ts b/server/services/vault/document-catalog-admission.ts
new file mode 100644
index 00000000..2828f11d
--- /dev/null
+++ b/server/services/vault/document-catalog-admission.ts
@@ -0,0 +1,94 @@
+/** Shared catalog actor admission. Uses the existing project policy on the
+ * caller's transaction connection; a token/ALS role cannot replace live membership. */
+import type { RequestSqlClient } from '../../db/requestDb';
+import { getTenantScope } from '../../db/tenantStore.js';
+import { GOVERNED_WRITE_ROLES } from '../../middleware/orgMembership.js';
+import { admitAnaProjectScope, AnaProjectScopeError } from '../ana/project-scope-admission.js';
+import { setTenantContextTx } from '../tenant/governed-tenant-context.js';
+
+export class CatalogAdmissionError extends Error {
+  constructor(readonly status: number, readonly code: string, message: string) {
+    super(message); this.name = 'CatalogAdmissionError';
+  }
+}
+
+export interface CatalogActorArgs { organizationId: number; userId: number | null; programId: string }
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const positive = (v: unknown): v is number => typeof v === 'number' && Number.isSafeInteger(v) && v > 0;
+
+function catalogTenantPreflight(args: CatalogActorArgs): string | null | undefined {
+  const scope = getTenantScope();
+  if (!positive(args.organizationId) || !UUID.test(args.programId) || !scope || scope.tenantId !== String(args.organizationId)) {
+    throw new CatalogAdmissionError(403, 'CATALOG_SCOPE_REQUIRED', 'The catalog request has no matching organization scope. Nothing was changed.');
+  }
+  if (!positive(args.userId)) throw new CatalogAdmissionError(401, 'ACTOR_REQUIRED', 'An identified organization member is required. Nothing was changed.');
+  return scope.role;
+}
+
+async function catalogMembershipRole(client: RequestSqlClient, args: CatalogActorArgs, opts: { write?: boolean; hold?: boolean }): Promise<string> {
+  const membership = await client.query(
+    `SELECT ou.role FROM organization_users ou
+       JOIN users u ON u.id = ou.user_id JOIN organizations o ON o.id = ou.organization_id
+      WHERE ou.user_id = $1 AND ou.organization_id = $2 AND u.status = 'active' AND o.status = 'active'
+      ${opts.hold ? 'FOR SHARE OF ou, u, o' : ''}`,
+    [args.userId, args.organizationId],
+  );
+  const role = membership.rows.length === 1 && typeof membership.rows[0].role === 'string'
+    ? membership.rows[0].role.trim().toLowerCase() : null;
+  if (!role) throw new CatalogAdmissionError(403, 'CATALOG_ACCESS_DENIED', 'Current organization membership could not be established. Nothing was changed.');
+  if (opts.write && !GOVERNED_WRITE_ROLES.has(role)) {
+    throw new CatalogAdmissionError(403, 'VAULT_WRITE_ROLE_REQUIRED', 'Your current organization role can read the Vault but cannot change its catalog. Nothing was changed.');
+  }
+  return role;
+}
+
+async function holdCatalogProject(client: RequestSqlClient, args: CatalogActorArgs, projectId: number): Promise<void> {
+  const program = await client.query(
+    'SELECT id FROM regulatory_programs WHERE id = $1 AND organization_id = $2 AND deleted_at IS NULL FOR SHARE',
+    [args.programId, args.organizationId],
+  );
+  const project = await client.query(
+    'SELECT id FROM projects WHERE id = $1 AND organization_id = $2 AND regulatory_program_id = $3 FOR UPDATE',
+    [projectId, args.organizationId, args.programId],
+  );
+  if (program.rows.length !== 1 || project.rows.length !== 1 || project.rows[0].id !== projectId) {
+    throw new CatalogAdmissionError(404, 'DOCUMENT_NOT_FOUND', 'No such document in this project.');
+  }
+  // Parent FOR UPDATE also fences FK-bound policy insertions. Existing
+  // policy rows are held against revocation until this short write commits.
+  await client.query('SELECT project_id FROM project_visibility_settings WHERE project_id = $1 AND organization_id = $2 FOR SHARE', [projectId, args.organizationId]);
+  await client.query('SELECT project_id FROM project_members WHERE project_id = $1 AND organization_id = $2 FOR SHARE', [projectId, args.organizationId]);
+  await client.query('SELECT id FROM concept2cure_artifacts WHERE project_id = $1 AND organization_id = $2 FOR SHARE', [projectId, args.organizationId]);
+  await client.query(`SELECT ra.id FROM concept2cure_review_assignments ra JOIN concept2cure_artifacts a ON a.id = ra.artifact_id
+    WHERE ra.organization_id = $1 AND a.organization_id = $1 AND a.project_id = $2 FOR SHARE OF ra`, [args.organizationId, projectId]);
+}
+
+export async function admitCatalogActor(
+  client: RequestSqlClient,
+  args: CatalogActorArgs,
+  opts: { write?: boolean; hold?: boolean } = {},
+): Promise<{ role: string; projectId: number }> {
+  await setTenantContextTx(client, args.organizationId, catalogTenantPreflight(args));
+  const role = await catalogMembershipRole(client, args, opts);
+  // Stamp the fresh role, rather than letting a stale request role authorize DML.
+  await setTenantContextTx(client, args.organizationId, role);
+  try {
+    let admitted = await admitAnaProjectScope(client, { ...args, projectRef: args.programId });
+    if (!positive(admitted.projectId) || admitted.programId?.toLowerCase() !== args.programId.toLowerCase()) {
+      throw new CatalogAdmissionError(409, 'CATALOG_PROJECT_UNRESOLVED', 'The project relationship could not be verified. Nothing was changed.');
+    }
+    const projectId = admitted.projectId;
+    if (opts.hold) {
+      await holdCatalogProject(client, args, projectId);
+      admitted = await admitAnaProjectScope(client, { ...args, projectRef: args.programId });
+      if (admitted.projectId !== projectId || admitted.programId?.toLowerCase() !== args.programId.toLowerCase()) {
+        throw new CatalogAdmissionError(409, 'CATALOG_PROJECT_UNRESOLVED', 'The project relationship changed. Nothing was changed.');
+      }
+    }
+    return { role, projectId };
+  } catch (err) {
+    if (err instanceof CatalogAdmissionError) throw err;
+    if (err instanceof AnaProjectScopeError) throw new CatalogAdmissionError(err.status, err.code, err.message);
+    throw err;
+  }
+}
