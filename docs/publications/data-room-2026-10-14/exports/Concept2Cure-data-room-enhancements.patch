+    await expect(admit({ requestedProgramId: FOREIGN })).rejects.toMatchObject({ code: 'ANA_PROJECT_NOT_FOUND' });
+    await pg.query('UPDATE regulatory_programs SET deleted_at=now() WHERE id=$1', [PUBLIC]);
