@@ -0,0 +1,24 @@
+/** Exact recorded-source identity guards. These do not replace actor/project
+ * admission and do not create actor-aware organization-wide recall policy. */
+import type { CatalogDocumentRow } from './document-catalog.service.js';
+import { catalogableDocument } from './document-catalog-eligibility.js';
+
+export class CatalogSourceScopeError extends Error {
+  readonly code = 'CATALOG_SOURCE_SCOPE_INVALID';
+  constructor() { super('The recorded catalog source and live program scope could not be verified. No catalog listing or recall was produced.'); }
+}
+
+export function assertCatalogListingScope(rows: Array<Record<string, unknown>>, organizationId: number): void {
+  if (!rows.every(row => row.organization_id === organizationId && row.program_organization_id === organizationId && row.program_deleted_at === null)) {
+    throw new CatalogSourceScopeError();
+  }
+}
+
+export function catalogableExpectedProgram(doc: CatalogDocumentRow | null, expectedProgramId?: string):
+  ReturnType<typeof catalogableDocument> | { ok: false; code: 'SOURCE_PROGRAM_CHANGED'; refusal: string } {
+  const availability = catalogableDocument(doc);
+  if (availability.ok && expectedProgramId !== undefined && (typeof expectedProgramId !== 'string' || availability.document.programId.toLowerCase() !== expectedProgramId.toLowerCase())) {
+    return { ok: false, code: 'SOURCE_PROGRAM_CHANGED', refusal: 'The document’s program changed since this request was admitted. Open its current project and read it again. Nothing was saved.' };
+  }
+  return availability;
+}
diff --git a/server/services/vault/document-catalog-write-integrity.ts b/server/services/vault/document-catalog-write-integrity.ts
new file mode 100644
index 00000000..56374716
--- /dev/null
+++ b/server/services/vault/document-catalog-write-integrity.ts
@@ -0,0 +1,84 @@
+/** Exact source admission and persistence receipts for existing catalog writes. */
+import { createHash } from 'node:crypto';
+import { lockDocumentDispositionProgram } from '../document-data-disposition/program-lock.js';
+import { vaultDataEligibleSql, vaultBinaryAvailableSql } from '../document-data-disposition/eligibility.js';
+import { supersededSql } from './vault-version-family.js';
+import { CatalogAdmissionError } from './document-catalog-admission.js';
+type Client = import('pg').PoolClient;
+
+export const HASH_RE = /^[0-9a-f]{64}$/i;
+export const textDigest = (text: string): string => createHash('sha256').update(text, 'utf8').digest('hex');
+
+/** The explicit table order also fences arbitrary successor/extraction DML;
+ * an individual predecessor lock does not block a successor INSERT. */
+export async function reserveCatalogWrite(client: Client, organizationId: number, programId: string): Promise<void> {
+  await client.query('BEGIN ISOLATION LEVEL READ COMMITTED');
+  await client.query("SET LOCAL statement_timeout = '30s'");
+  await lockDocumentDispositionProgram(client, organizationId, programId);
+  await client.query('LOCK TABLE vault.document_catalog IN ROW EXCLUSIVE MODE');
+  await client.query('LOCK TABLE vault.documents IN SHARE MODE');
+}
+
+export interface CatalogSourceRow extends Record<string, any> {
+  id: string; program_id: string; organization_id: number; content_hash: string;
+  extracted_text: string | null; catalog_content_hash: string | null;
+}
+
+export async function lockedCatalogSource(client: Client, args: { documentId: string; programId: string; organizationId: number }): Promise<CatalogSourceRow> {
+  const { rows } = await client.query(
+    `SELECT d.id, d.program_id, d.organization_id, d.document_title, d.content_hash, d.extracted_text,
+            ${vaultDataEligibleSql('d')} AS data_eligible, ${vaultBinaryAvailableSql('d')} AS original_file_available,
+            ${supersededSql('d')} AS superseded, c.content_hash AS catalog_content_hash,
+            c.catalog_status, c.extraction_method, c.extraction_error
+       FROM vault.documents d LEFT JOIN vault.document_catalog c ON c.document_id = d.id
+      WHERE d.id = $1 AND d.program_id = $2 AND d.organization_id = $3 AND d.deleted_at IS NULL
+        AND EXISTS (SELECT 1 FROM regulatory_programs rp WHERE rp.id = d.program_id
+                    AND rp.organization_id = $3 AND rp.deleted_at IS NULL)
+      FOR UPDATE OF d`,
+    [args.documentId, args.programId, args.organizationId],
+  );
+  if (rows.length !== 1 || rows[0].id !== args.documentId || rows[0].program_id?.toLowerCase() !== args.programId.toLowerCase()
+      || rows[0].organization_id !== args.organizationId) {
+    throw new CatalogAdmissionError(404, 'DOCUMENT_NOT_FOUND', 'No such current document in this project. Nothing was saved.');
+  }
+  return rows[0];
+}
+
+export function sourceProblem(row: Record<string, any>, organizationId: number): string | null {
+  if (row.data_eligible !== true) return 'SOURCE_DATA_WITHDRAWN';
+  if (row.superseded !== false) return 'SOURCE_SUPERSEDED';
+  if (row.organization_id !== organizationId || typeof row.content_hash !== 'string' || !HASH_RE.test(row.content_hash)) return 'SOURCE_IDENTITY_UNVERIFIED';
+  if (row.catalog_content_hash !== row.content_hash) return 'SOURCE_VERSION_CHANGED';
+  if (typeof row.extracted_text !== 'string' || !row.extracted_text.trim() || row.catalog_status === 'extraction_failed') return 'EXTRACTION_UNAVAILABLE';
+  return null;
+}
+
+export function requireWritableSource(row: CatalogSourceRow, organizationId: number, expectedHash?: string, expectedText?: string): string {
+  const problem = sourceProblem(row, organizationId) ?? (row.original_file_available !== true ? 'SOURCE_ORIGINAL_UNAVAILABLE' : null);
+  if (problem) throw new CatalogAdmissionError(409, problem, 'This source is no longer eligible for catalog changes. Review its current source status. Nothing was saved.');
+  if (expectedHash !== undefined && expectedHash !== row.content_hash) {
+    throw new CatalogAdmissionError(409, 'CONFLICT', 'This document has a newer version than the one shown. Reload and review it. Nothing was saved.');
+  }
+  const digest = textDigest(row.extracted_text!);
+  if (expectedText !== undefined && (!HASH_RE.test(expectedText) || expectedText.toLowerCase() !== digest)) {
+    throw new CatalogAdmissionError(409, 'EXTRACTION_CHANGED', 'The extracted text changed after it was shown. Reload and review the current source. Nothing was saved.');
+  }
+  return digest;
+}
+
+export function requireUpdateReceipt(result: { rows: any[]; rowCount: number | null }, documentId: string, contentHash: string): void {
+  if (result.rowCount !== 1 || result.rows.length !== 1 || result.rows[0].document_id !== documentId
+      || result.rows[0].content_hash !== contentHash || typeof result.rows[0].revision !== 'string') {
+    throw new CatalogAdmissionError(409, 'CATALOG_NOT_SAVED', 'The catalog write did not return one verified persistence receipt. Nothing was saved.');
+  }
+}
+
+export function missingVectorOperation(err: unknown): boolean {
+  const { code, message } = (err ?? {}) as { code?: unknown; message?: unknown };
+  return typeof message === 'string' && (
+    (code === '42703' && /column (?:"embedding"|'embedding'|embedding\b)/i.test(message))
+    || (code === '42704' && /type ["']?vector["']? does not exist/i.test(message))
+    || (code === '0A000' && /\bvector\b/i.test(message))
+  );
+}
+
diff --git a/server/services/vault/retrieval-source-access.ts b/server/services/vault/retrieval-source-access.ts
new file mode 100644
index 00000000..bae6470d
--- /dev/null
+++ b/server/services/vault/retrieval-source-access.ts
@@ -0,0 +1,68 @@
+/** Short actor/source fences for the existing AnA retrieval adapters. */
+import type { AdmittedAnaSourceReadScope } from '../ana/source-read-scope.js';
+import { revalidateAnaSourceReadScope, assertAnaSourceProgramAllowed } from '../ana/source-read-scope.js';
+import { AnaProjectScopeError } from '../ana/project-scope-admission.js';
+import { supersededSql } from './vault-version-family.js';
+import { vaultDataEligibleSql } from '../document-data-disposition/eligibility.js';
+
+export type RetrievalQueryable = { query: (sql: string, params?: unknown[]) => Promise<{ rows: any[] }> };
+export interface RetrievalSourceIdentity { documentId: string; programId: string; contentHash: string; }
+
+export function pinRetrievalReadScope(scope: AdmittedAnaSourceReadScope): AdmittedAnaSourceReadScope {
+  return Object.freeze({ ...scope, accessibleProgramIds: Object.freeze([...scope.accessibleProgramIds]) });
+}
+
+export function assertRetrievalScope(scope: AdmittedAnaSourceReadScope, organizationId: number, programId: string | null): void {
+  if (scope.organizationId !== organizationId || scope.programId !== programId) {
+    throw new AnaProjectScopeError(403, 'ANA_SOURCE_SCOPE_MISMATCH', 'The requested source scope does not match this conversation.');
+  }
+}
+
+/** Provider work belongs outside this callback; only short database reads run here. */
+export async function withRetrievalReadScope<T>(
+  scope: AdmittedAnaSourceReadScope,
+  run: (q: RetrievalQueryable, current: AdmittedAnaSourceReadScope) => Promise<T>,
+): Promise<T> {
+  const { withAnaSourceReadScope } = await import('./document-catalog-actor-access.js');
+  return withAnaSourceReadScope({
+    organizationId: scope.organizationId, userId: scope.userId,
+    projectId: scope.projectId, requestedProgramId: scope.programId,
+  }, async (q, current) => {
+    await revalidateAnaSourceReadScope(q, scope);
+    return run(q, current);
+  });
+}
+
+/** Never turn a changed selected source into a silently shortened result/count. */
+export async function verifyRetrievalSources(
+  q: RetrievalQueryable, scope: AdmittedAnaSourceReadScope, identities: readonly RetrievalSourceIdentity[],
+): Promise<void> {
+  if (!identities.length) return;
+  const unique = new Map<string, RetrievalSourceIdentity>();
+  for (const identity of identities) {
+    assertAnaSourceProgramAllowed(scope, identity.programId);
+    if (!/^[0-9a-f]{64}$/i.test(identity.contentHash)) {
+      throw new AnaProjectScopeError(503, 'ANA_SOURCE_IDENTITY_UNAVAILABLE', 'The source identity could not be verified. Nothing was returned.');
+    }
+    const prior = unique.get(identity.documentId);
+    if (prior && (prior.contentHash !== identity.contentHash || prior.programId !== identity.programId)) {
+      throw new AnaProjectScopeError(503, 'ANA_SOURCE_IDENTITY_UNAVAILABLE', 'The source identity could not be verified. Nothing was returned.');
+    }
+    unique.set(identity.documentId, { ...identity });
+  }
+  const { rows } = await q.query(
+    `SELECT d.id::text AS document_id, d.program_id::text AS program_id, d.content_hash
+       FROM vault.documents d
+       JOIN regulatory_programs p ON p.id=d.program_id AND p.organization_id=$1 AND p.deleted_at IS NULL
+      WHERE d.organization_id=$1 AND d.id::text=ANY($2::text[])
+        AND d.program_id=ANY($3::uuid[]) AND d.deleted_at IS NULL
+        AND ${vaultDataEligibleSql('d')} AND NOT ${supersededSql('d')}`,
+    [scope.organizationId, [...unique.keys()], [...scope.accessibleProgramIds]],
+  );
+  if (rows.length !== unique.size || new Set(rows.map(row => String(row.document_id))).size !== unique.size || rows.some(row => {
+    const expected = unique.get(String(row.document_id));
+    return !expected || row.program_id !== expected.programId || row.content_hash !== expected.contentHash;
+  })) {
+    throw new AnaProjectScopeError(409, 'ANA_SOURCE_CHANGED', 'Source access or identity changed during retrieval. Search again before using these sources.');
+  }
+}
