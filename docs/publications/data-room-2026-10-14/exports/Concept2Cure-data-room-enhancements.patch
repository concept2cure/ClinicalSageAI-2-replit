+  return row;
+}
+interface ContextProblems { pending: CatalogFactReason[]; failures: CatalogFactReason[] }
+function rowAdmissionProblems(meaning: CatalogFactMeaning, rules: FamilyRules, row: Map<string, string>): CatalogFactReason[] {
