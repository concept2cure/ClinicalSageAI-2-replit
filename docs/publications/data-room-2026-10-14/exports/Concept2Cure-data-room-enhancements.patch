+const doc = '20000000-0000-4000-8000-000000000002';
+beforeEach(() => { vi.clearAllMocks(); h.rows = []; h.query.mockImplementation(async () => ({ rows: h.rows })); });
+describe('server-only catalog actor query filters', () => {
