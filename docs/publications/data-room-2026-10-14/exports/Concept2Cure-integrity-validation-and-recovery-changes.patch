+
+  it('classifies an unavailable resolver without inventing a run', async () => {
+    withoutExternalEndpoint();
+    vi.stubEnv('EVALIDATOR_USE_FDA_CRITERIA_FALLBACK', '');
+    const validator = await resolveExternalValidator();
