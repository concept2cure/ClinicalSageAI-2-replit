import os from 'node:os'; import path from 'node:path'; import { promises as fs, createWriteStream } from 'node:fs';
import { CsrPdfWriter } from '../../../../server/services/csr/csr-pdf-writer';
import { planListings } from '../../../../server/services/csr/csr-listings';
import { verifyListingReceipt } from '../../../../server/services/csr/csr-listing-verify';
import { scaleEnvelope, scaleAdlb } from '../../../../server/services/csr/__tests__/support/csr-scale-synthetic';
const N = Number(process.argv[2] ?? 3000);
const env = scaleEnvelope(N); const lab = scaleAdlb(env);
const src = { study: env.studyData, participants: env.participants, laboratory: lab, protocolDeviations: [] };
const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'csr-phase-'));
const gc = (globalThis as any).gc; gc(); 
const base = process.memoryUsage().heapUsed; let peak = base;
const t = setInterval(() => { peak = Math.max(peak, process.memoryUsage().heapUsed); }, 10);
const def = planListings(src).generated.find(d => d.number === '16.2.8')!;
const w = new CsrPdfWriter({ path: path.join(dir, 'lab.pdf'), title: 'lab', runningHeader: 'lab', stamp: new Date(0), landscape: true });
w.heading('Listing 16.2.8', 1, 'L16.2.8');
const receipt = createWriteStream(path.join(dir, 'r.ndjson'));
const rows = await w.table({ headers: def.headers, widths: def.widths }, (function* () { for (const r of def.rows()) yield { cells: r.cells, bookmark: r.bookmark, subjectId: r.subjectId }; })(), row => { receipt.write(JSON.stringify({ subjectId: (row as any).subjectId, cells: row.cells }) + '\n'); });
receipt.end(); await new Promise(r => receipt.on('close', r));
const written = await w.finish();
const genPeak = peak; gc(); const afterGen = process.memoryUsage().heapUsed; peak = afterGen;
const v = await verifyListingReceipt('16.2.8', path.join(dir, 'r.ndjson'), src as any, def.headers);
clearInterval(t);
const MiB = (b: number) => Math.round(b / 2 ** 20);
console.log(JSON.stringify({ subjects: N, rows, pages: written.pages, bytes: written.bytes, baseHeapMiB: MiB(base), generationPeakGrowthMiB: MiB(genPeak - base), heapRetainedAfterGenerationMiB: MiB(afterGen - base), verificationPeakGrowthMiB: MiB(peak - afterGen), verified: v.ok }));
await fs.rm(dir, { recursive: true, force: true });
