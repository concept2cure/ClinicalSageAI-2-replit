+// ── ANA-SUMMARY S5 plays (scratch copy; not the W1 harness) ──────────────────
+// "s5 tasks …": a four-part plan, each part's work dispatched while that part is
+// the one in progress, the plan advanced beside the work (it lands after the
+// work was dispatched, so the work keeps its task). Part 3 reads two documents
+// that do not exist, so both of its steps fail, and AnA still marks it complete.
+// Part 4 is marked complete with no step at all.
+const S5_TASKS = ['Find the stability reports', 'List the project documents', 'Read the two archived reports', 'Summarise the shelf-life claims'];
+const s5Plan = (...st) => ({ name: 'update_plan', input: { steps: S5_TASKS.map((title, i) => ({ title, status: st[i] })) } });
+const S5_MISSING = ['00000000-0000-4000-8000-0000000005a1', '00000000-0000-4000-8000-0000000005a2'];
+
+function planS5(t) {
+  if (!/\bs5 tasks\b/i.test(t.rawAsk)) return null;
+  const plans = t.results.filter(r => r.name === 'update_plan').length;
+  const withPlan = (p, ...st) => (p.tool ? { ...p, more: [...(p.more || []), s5Plan(...st)] } : p);
+  if (plans === 0) return { ...t.tool('update_plan', s5Plan('in_progress', 'pending', 'pending', 'pending').input, 'I will take this in four parts.') };
+  if (plans === 1) return withPlan(t.tool('search_project_documents', { query: 'stability' }, 'Searching the Vault for the stability reports.'), 'completed', 'in_progress', 'pending', 'pending');
+  if (plans === 2) return withPlan(t.tool('list_project_documents', {}, ''), 'completed', 'completed', 'in_progress', 'pending');
+  if (plans === 3) {
+    const first = t.tool('read_project_document', { document_id: S5_MISSING[0] }, 'Reading the two archived reports.');
+    if (!first.tool) return first;
+    return { ...first, more: [{ name: 'read_project_document', input: { document_id: S5_MISSING[1] } }, s5Plan('completed', 'completed', 'completed', 'in_progress')] };
+  }
+  if (plans === 4) return { ...t.tool('update_plan', s5Plan('completed', 'completed', 'completed', 'completed').input, 'Marking the last part done.') };
+  return { text: 'The archived reports could not be read, so the shelf-life claims come from the stability protocol only.' };
+}
