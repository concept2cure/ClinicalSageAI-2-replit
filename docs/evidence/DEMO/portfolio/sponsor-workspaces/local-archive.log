## the scratch script, verbatim
// One-off, LOCAL database only: archive the first portfolio projects (created in the organisation's own
// workspace) through the route Project settings uses: POST /api/c2c/projects/:id/archive { reason },
// with the headers the UI sends (Authorization, x-organization-id, x-client-id). Dry run unless --apply.
import { devLogin } from '/home/user/ClinicalSageAI-2-replit/tests/validation/lib/harness.mjs';
const BASE = 'http://127.0.0.1:5000';
const apply = process.argv.includes('--apply');
const auth = await devLogin(BASE, 'jm.smith@concept2cure.pro');
const tok = auth.accessToken;
const claims = JSON.parse(Buffer.from(tok.split('.')[1], 'base64url').toString('utf8'));
const call = async (method, p, body, extra = {}) => {
  const res = await fetch(BASE + p, { method, headers: { Origin: BASE, Accept: 'application/json', Authorization: `Bearer ${tok}`, ...(body ? { 'Content-Type': 'application/json' } : {}), ...extra }, body: body ? JSON.stringify(body) : undefined });
  const text = await res.text(); let json = null; try { json = JSON.parse(text); } catch {}
  return { status: res.status, json, text };
};
console.log(`# ${new Date().toISOString()} ${apply ? 'APPLY' : 'DRY RUN'} — signed in as ${claims.email ?? 'jm.smith@concept2cure.pro'} (user ${claims.userId}, organisation ${claims.organizationId}) at ${BASE}`);
const list = await call('GET', '/api/c2c/projects?limit=200');
if (list.status !== 200 || list.json?.meta?.hasMore) throw new Error(`project list: ${list.status} hasMore=${list.json?.meta?.hasMore}`);
const sponsorNames = new Set(['Varnhollow Oncology (fictional demo)', 'Petrelline Rare Therapeutics (fictional demo)', 'Quillmont Immunology (fictional demo)', 'Halcyra Vaccines (fictional demo)']);
const clients = await call('GET', '/api/clients');
const sponsorIds = new Set((clients.json?.clients ?? []).filter((c) => sponsorNames.has(c.name)).map((c) => Number(c.id)));
const rows = list.json.data.filter((p) => String(p.title ?? p.name).startsWith('[Demo · Portfolio] ') && !sponsorIds.has(Number(p.client_workspace_id)));
console.log(`# ${rows.length} active portfolio project(s) outside the sponsor workspaces (sponsor workspace ids: ${[...sponsorIds].join(', ') || 'none yet'})`);
const reason = 'Demo data correction (local database): the fictional portfolio sponsors move to their own client workspaces; this first copy, created in the organisation\'s own workspace, is archived and the pack recreates it in its sponsor\'s workspace.';
for (const p of rows) {
  const line = `${p.id}  workspace ${p.client_workspace_id} (${p.client_name})  status ${p.status}  ${p.title ?? p.name}`;
  if (!apply) { console.log(`would archive  ${line}`); continue; }
  const r = await call('POST', `/api/c2c/projects/${encodeURIComponent(p.id)}/archive`, { reason }, { 'x-organization-id': String(claims.organizationId), 'x-client-id': String(p.client_workspace_id) });
  const named = r.json?.ok === true && String(r.json?.projectId ?? '').toLowerCase() === String(p.id).toLowerCase();
  console.log(`archive ${r.status} ${named ? 'CONFIRMED' : 'NOT CONFIRMED'}  ${line}  → ${JSON.stringify(r.json ?? r.text).slice(0, 300)}`);
}
if (apply) {
  const after = await call('GET', '/api/c2c/projects?limit=200&includeArchived=true');
  const mine = new Set(rows.map((p) => p.id));
  for (const p of (after.json?.data ?? []).filter((x) => mine.has(x.id))) console.log(`after: ${p.id} status ${p.status}`);
  console.log(`# reason sent (verbatim, in each project's audit row): ${reason}`);
}
