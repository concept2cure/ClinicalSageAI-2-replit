{
  "family": "c2c-production-api",
  "containerDefinitions": [
    {
      "dependsOn": [
        {
          "condition": "HEALTHY",
          "containerName": "clamav"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "5000"
        },
        {
          "name": "TRUST_PROXY_HOPS",
          "value": "2"
        },
        {
          "name": "CLAMAV_HOST",
          "value": "127.0.0.1"
        },
        {
          "name": "CLAMAV_PORT",
          "value": "3310"
        },
        {
          "name": "CONCEPT2CURE_SIGNER_MODE",
          "value": "kms"
        },
        {
          "name": "CONCEPT2CURE_SIGNER_KMS_KEY_ID",
          "value": "alias/fda-signing-key-2026"
        },
        {
          "name": "CONCEPT2CURE_SIGNER_KMS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "RLS_ENFORCE",
          "value": "on"
        },
        {
          "name": "AUDIT_TRAIL_ENABLED",
          "value": "true"
        },
        {
          "name": "AUDIT_REQUIRE_ENFORCE",
          "value": "true"
        },
        {
          "name": "AI_SENSITIVE_DATA_POLICY_MODE",
          "value": "enforce"
        },
        {
          "name": "AI_PROVIDER_PLACEMENT_APPROVALS",
          "value": "{\"anthropic\":{\"region\":\"global\",\"zeroRetentionApproved\":true,\"approvedDataClasses\":[\"pii\"],\"approvedIntendedUses\":[\"drafting\"]}}"
        },
        {
          "name": "APP_URL",
          "value": "https://app.example.com"
        },
        {
          "name": "ALLOWED_ORIGINS",
          "value": "https://app.example.com"
        },
        {
          "name": "MCP_ENABLED",
          "value": "true"
        },
        {
          "name": "MCP_PUBLIC_URL",
          "value": "https://app.example.com"
        },
        {
          "name": "MCP_CLIENT_REDIRECT_ALLOWLIST",
          "value": "https://claude.ai,https://claude.com"
        },
        {
          "name": "STORAGE_PROVIDER",
          "value": "s3"
        },
        {
          "name": "AWS_S3_BUCKET",
          "value": "c2c-prod-vault"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "SMTP_HOST",
          "value": "email-smtp.us-east-1.amazonaws.com"
        },
        {
          "name": "SMTP_PORT",
          "value": "465"
        },
        {
          "name": "SMTP_FROM",
          "value": "noreply@example.com"
        },
        {
          "name": "PLATFORM_ADMIN_EMAILS",
          "value": "owner@example.com"
        },
        {
          "name": "BUSINESS_CENTER_EMAILS",
          "value": "owner@example.com"
        }
      ],
      "essential": true,
      "healthCheck": {
        "command": [
          "CMD",
          "node",
          "-e",
          "require('http').get('http://localhost:5000/healthz',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
        ],
        "interval": 30,
        "retries": 3,
        "startPeriod": 60,
        "timeout": 10
      },
      "image": "xxa88v5i:v1.0.0",
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/c2c-production/api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      },
      "name": "api",
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "fbvgp7o3"
        },
        {
          "name": "APP_DATABASE_URL",
          "valueFrom": "jq5k7tme"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "dad73h86"
        },
        {
          "name": "REFRESH_TOKEN_SECRET",
          "valueFrom": "os1ccs71"
        },
        {
          "name": "MFA_ENCRYPTION_KEY",
          "valueFrom": "2vfxpjrc"
        },
        {
          "name": "AUDIT_HMAC_KEY",
          "valueFrom": "i2d9k8t7"
        },
        {
          "name": "AUDIT_HMAC_SECRET",
          "valueFrom": "0t5oyo8l"
        },
        {
          "name": "AUDIT_EXPORT_SIGNING_KEY",
          "valueFrom": "bpsprrjb"
        },
        {
          "name": "AUDIT_ATTESTATION_KEY",
          "valueFrom": "f19ha42l"
        },
        {
          "name": "CONNECTOR_ENCRYPTION_KEY",
          "valueFrom": "gel85xp7"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "40xixms7"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "c3pknxm6"
        },
        {
          "name": "SMTP_USER",
          "valueFrom": "69bbwfrx"
        },
        {
          "name": "SMTP_PASS",
          "valueFrom": "8q8dx7oy"
        },
        {
          "name": "APP_SERVICE_DB_PASSWORD",
          "valueFrom": "49njr51l"
        },
        {
          "name": "SETUP_TOKEN",
          "valueFrom": "oi83hrxd"
        }
      ]
    },
    {
      "environment": [
        {
          "name": "CLAMD_CONF_StreamMaxLength",
          "value": "100M"
        },
        {
          "name": "CLAMD_CONF_AlertExceedsMax",
          "value": "yes"
        }
      ],
      "essential": true,
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "clamdcheck.sh"
        ],
        "interval": 30,
        "retries": 3,
        "startPeriod": 300,
        "timeout": 10
      },
      "image": "clamav/clamav:1.4.6@sha256:57deb108fc4c72778aa83eafbca7bb7153e28c3f57c005afd38d31f16da86f23",
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/c2c-production/api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "clamav"
        }
      },
      "memory": 4096,
      "name": "clamav"
    }
  ],
  "taskDefinitionArn": "arn:aws:ecs:us-east-1:123456789012:task-definition/c2c-production-api:1"
}