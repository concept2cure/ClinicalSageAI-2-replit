+/** Runs `run`; a privilege refusal (42501) answers 404 and returns null, anything else propagates. */
+async function mutateOr404<T>(res: express.Response, run: () => Promise<T>): Promise<T | null> {
+  try {
+    return await run();
+  } catch (error) {
+    if ((error as { code?: string }).code !== '42501') throw error;
+    res.sendStatus(404);
+    return null;
+  }
+}
