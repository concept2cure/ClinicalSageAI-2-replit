+    expect(cmd).toBeInstanceOf(PutObjectCommand);
+    expect(cmd.input).toMatchObject({
+      Bucket: 'c2c-part11-evidence',
+      Key: 'audit-chain-anchors/2031/01/01.json',
+      IfNoneMatch: '*',
+      ChecksumSHA256: expect.stringMatching(/^[A-Za-z0-9+/]{43}=$/),
+    });
+    expect(store.location).toBe('s3://c2c-part11-evidence/audit-chain-anchors/');
+  });
+
+  it('an existing key is AnchorExistsError; any other failure is thrown as it is', async () => {
+    const exists = s3(() => {
+      throw Object.assign(new Error('At least one of the pre-conditions you specified did not hold'), { name: 'PreconditionFailed', $metadata: { httpStatusCode: 412 } });
+    });
+    await expect(exists.store.putOnce('k', 'b')).rejects.toBeInstanceOf(AnchorExistsError);
+    const denied = s3(() => {
+      throw Object.assign(new Error('Access Denied'), { name: 'AccessDenied', $metadata: { httpStatusCode: 403 } });
