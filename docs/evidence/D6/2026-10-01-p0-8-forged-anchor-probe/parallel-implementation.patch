+    expect(all).toEqual([
+      { key: 'audit-chain-anchors/2031/01/01.json', versions: 2, deleteMarkers: 0, body: 'first' },
+      { key: 'audit-chain-anchors/2031/01/02.json', versions: 1, deleteMarkers: 1, body: 'only' },
+    ]);
+    const listed = send.mock.calls.map(([c]) => c).filter((c) => c instanceof ListObjectVersionsCommand) as ListObjectVersionsCommand[];
+    expect(listed.map((c) => c.input.Prefix)).toEqual(['audit-chain-anchors/', 'audit-chain-anchors/']);
+    expect(listed[1].input).toMatchObject({ KeyMarker: 'audit-chain-anchors/2031/01/01.json', VersionIdMarker: 'v2' });
+  });
+});
+
+describe('the anchor document', () => {
+  it('round-trips, and a changed head no longer matches its digest', () => {
+    const anchor = buildChainAnchor([head], new Date('2031-01-01T02:00:00Z'));
+    expect(parseChainAnchor(JSON.stringify(anchor))).toEqual(anchor);
+    const altered = { ...anchor, heads: [{ ...head, id: '00000000-0000-0000-0000-000000000008' }] };
+    expect(() => parseChainAnchor(JSON.stringify(altered))).toThrow(/digest/);
+    expect(() => parseChainAnchor('{"version":2}')).toThrow(/version-1/);
+  });
+});
+
+describe('configuration', () => {
+  it('no AUDIT_ANCHOR_BUCKET: no store, and the check says unverifiable, never ok', async () => {
+    expect(resolveAnchorStore({})).toBeNull();
+    expect(resolveAnchorStore({ AUDIT_ANCHOR_BUCKET: '  ' })).toBeNull();
+    const store = resolveAnchorStore({ AUDIT_ANCHOR_BUCKET: 'c2c-part11-evidence', AUDIT_ANCHOR_PREFIX: 'anchors/' });
+    expect(store?.location).toBe('s3://c2c-part11-evidence/anchors/');
+    const query = vi.fn();
+    const check = await verifyAndAnchorChainHeads({ query }, { store: null, chainOk: true });
+    expect(check.status).toBe('unverifiable');
+    expect(check.reason).toMatch(/AUDIT_ANCHOR_BUCKET/);
+    expect(query).not.toHaveBeenCalled();
+  });
+
+  it('a store that cannot be read is an error, not a pass', async () => {
+    const check = await verifyAndAnchorChainHeads(
+      { query: vi.fn() },
+      { store: { location: 's3://x/', prefix: 'p', putOnce: vi.fn(), readAll: async () => { throw new Error('AccessDenied'); } }, chainOk: true },
+    );
+    expect(check).toMatchObject({ status: 'error', reason: expect.stringMatching(/AccessDenied/) });
+  });
+
+  it('writes under the prefix the store lists, so a configured prefix is checked too', async () => {
+    const store = resolveAnchorStore({ AUDIT_ANCHOR_BUCKET: 'c2c-part11-evidence', AUDIT_ANCHOR_PREFIX: 'anchors' })!;
+    const putOnce = vi.spyOn(store, 'putOnce').mockResolvedValue(undefined);
+    vi.spyOn(store, 'readAll').mockResolvedValue([]);
+    const query = vi.fn(async () => ({ rows: [{ tenant_id: 7, id: head.id, chain_seq: '41', sha256_chain: head.sha256Chain, created_at: head.createdAt }] }));
+    const check = await verifyAndAnchorChainHeads({ query }, { store, chainOk: true, now: new Date('2031-01-01T02:00:00Z') });
+    expect(check.anchoredKey).toBe('anchors/2031/01/01.json');
+    expect(putOnce.mock.calls[0][0]).toBe('anchors/2031/01/01.json');
+  });
+});
diff --git a/server/services/audit/chain-anchor.ts b/server/services/audit/chain-anchor.ts
new file mode 100644
index 000000000..abf25216b
--- /dev/null
+++ b/server/services/audit/chain-anchor.ts
@@ -0,0 +1,393 @@
+/**
+ * audit/chain-anchor — every tenant's audit_logs chain head, anchored outside
+ * the database (security plan P0-8, the anchored half; DP-04).
+ *
+ * The sha256 chain (chain.ts) detects a row changed or removed from the middle:
+ * every later link stops deriving. It cannot detect the NEWEST rows removed.
+ * What remains is a valid, shorter chain. Nor can it detect the whole database
+ * restored from an older backup. The triggers and grants stop the application
+ * doing either; they do not stop the database's owner, a superuser, or a
+ * restore.
+ *
+ * So once a day the sweep (jobs/auditChainIntegritySweep.ts) writes each
+ * tenant's head (row id, chain_seq, sha256_chain, created_at) to the
+ * object-locked evidence bucket, and on every run checks every head ever
+ * anchored against the database:
+ *
+ *   - the row is still there with the same sha256_chain: ok;
+ *   - the row is gone and a recorded archive batch (audit_log_archives, the
+ *     archive door's own record) spans its created_at: accounted for;
+ *   - otherwise: broken. The newest rows were removed, the database went
+ *     back in time, or the head was rewritten.
+ *
+ * Why every anchor and not only the latest: the runtime can write anchors, so
+ * it could write a newer one naming an older head after truncating. An older
+ * anchor still names the removed head, and it cannot be removed or replaced:
+ *
+ *   - each key is written once (If-None-Match: *);
+ *   - the bucket's Object Lock retains every version;
+ *   - the verifier reads every version and every delete marker, and treats a
+ *     second version or a delete marker on an anchor as broken.
+ *
+ * A forged anchor can only raise a false alarm. It cannot hide a removal.
+ *
+ * Read-only on the database. The one write is the anchor object.
+ */
+
+import { createHash } from 'crypto';
+import {
+  S3Client,
+  PutObjectCommand,
+  GetObjectCommand,
+  ListObjectVersionsCommand,
+  type S3ClientConfig,
+} from '@aws-sdk/client-s3';
+import { stableStringify } from '../../../shared/canonical-json.js';
+import { AUDIT_CHAIN_HEAD_ORDER_SQL, type PoolClient } from './chain.js';
+
+export const CHAIN_ANCHOR_VERSION = 1;
+export const DEFAULT_ANCHOR_PREFIX = 'audit-chain-anchors';
+
+/** One tenant's chain head at the moment of anchoring. */
+export interface AnchoredHead {
+  tenantId: number;
+  /** audit_logs.id (uuid). */
+  id: string;
+  /** audit_logs.chain_seq as text; null for a legacy head. */
+  chainSeq: string | null;
+  sha256Chain: string;
+  /** audit_logs.created_at as the database renders it, for the archive check. */
+  createdAt: string;
+}
+
+export interface ChainAnchor {
+  version: typeof CHAIN_ANCHOR_VERSION;
+  store: 'audit_logs';
+  anchoredAt: string;
+  heads: AnchoredHead[];
+  /** sha256 of the canonical JSON of every field above. */
+  digest: string;
+}
+
+/** An anchor object as the store holds it. */
+export interface StoredAnchor {
+  key: string;
+  /** How many versions the key has. A written-once anchor has exactly one. */
+  versions: number;
+  /** Delete markers on the key. An anchor never has one. */
+  deleteMarkers: number;
+  /** The body of the OLDEST version: what was written first. */
+  body: string;
+}
+
+/** Where anchors live. The production store is S3AnchorStore. */
+export interface AnchorStore {
+  /** For logs: s3://bucket/prefix. */
+  readonly location: string;
+  /** The key prefix every anchor is written and listed under. */
+  readonly prefix: string;
+  /** Write a key once. Throws AnchorExistsError when the key already exists. */
+  putOnce(key: string, body: string): Promise<void>;
+  /** Every anchor key under the prefix, with its version history. */
+  readAll(): Promise<StoredAnchor[]>;
+}
+
+export class AnchorExistsError extends Error {
+  readonly code = 'AUDIT_ANCHOR_EXISTS';
+  constructor(key: string) {
+    super(`audit anchor ${key} already exists; an anchor is written once`);
+  }
+}
+
+// ── The anchor document ──────────────────────────────────────────────────────
+
+function digestOf(anchor: Omit<ChainAnchor, 'digest'>): string {
+  return createHash('sha256').update(stableStringify(anchor), 'utf8').digest('hex');
+}
+
+export function buildChainAnchor(heads: AnchoredHead[], anchoredAt: Date): ChainAnchor {
+  const body: Omit<ChainAnchor, 'digest'> = {
+    version: CHAIN_ANCHOR_VERSION,
+    store: 'audit_logs',
+    anchoredAt: anchoredAt.toISOString(),
+    heads,
+  };
+  return { ...body, digest: digestOf(body) };
+}
+
+/** Parse a stored anchor. Throws on anything that is not an intact version-1 anchor. */
+export function parseChainAnchor(text: string): ChainAnchor {
+  const parsed = JSON.parse(text) as ChainAnchor;
+  if (parsed?.version !== CHAIN_ANCHOR_VERSION || parsed.store !== 'audit_logs' || !Array.isArray(parsed.heads)) {
+    throw new Error('not a version-1 audit_logs chain anchor');
+  }
+  const { digest, ...rest } = parsed;
+  if (digestOf(rest) !== digest) throw new Error('anchor digest does not match its contents');
+  return parsed;
+}
+
+/** One key per UTC day: <prefix>/2026/10/01.json. */
+export function anchorKeyFor(prefix: string, at: Date): string {
+  const yyyy = at.getUTCFullYear();
+  const mm = String(at.getUTCMonth() + 1).padStart(2, '0');
+  const dd = String(at.getUTCDate()).padStart(2, '0');
+  return `${prefix}/${yyyy}/${mm}/${dd}.json`;
+}
+
+// ── The database side ────────────────────────────────────────────────────────
+
+/** Every tenant's head, in the chain's own order (chain.ts). Needs an unscoped connection. */
+export async function readChainHeads(client: PoolClient): Promise<AnchoredHead[]> {
+  const { rows } = await client.query(
+    `SELECT DISTINCT ON (tenant_id)
+            tenant_id, id::text AS id, chain_seq::text AS chain_seq, sha256_chain,
+            created_at::text AS created_at
+       FROM audit_logs
+      WHERE sha256_chain IS NOT NULL
+      ORDER BY tenant_id, ${AUDIT_CHAIN_HEAD_ORDER_SQL}`,
+  );
+  return rows.map((r) => ({
+    tenantId: Number(r.tenant_id),
+    id: String(r.id),
+    chainSeq: r.chain_seq == null ? null : String(r.chain_seq),
+    sha256Chain: String(r.sha256_chain),
+    createdAt: String(r.created_at),
+  }));
+}
+
+export type AnchorCheckStatus = 'ok' | 'broken' | 'error' | 'unverifiable';
+
+export interface AnchorCheck {
+  status: AnchorCheckStatus;
+  /** Distinct anchored heads checked against the database. */
+  rowsChecked?: number;
+  /** tenant:<id> row:<uuid>, or the anchor key. Never content. */
+  firstFailure?: string;
+  reason?: string;
+  /** The key written by this run, when one was. */
+  anchoredKey?: string;
+}
+
+interface HeadFinding {
+  head: AnchoredHead;
+  outcome: 'present' | 'archived' | 'missing' | 'rewritten';
+}
+
+/** Check heads against audit_logs and, for an absent row, the archive record. */
+async function findHeads(client: PoolClient, heads: AnchoredHead[]): Promise<HeadFinding[]> {
+  if (heads.length === 0) return [];
+  const { rows } = await client.query(
+    `SELECT h.ord, a.sha256_chain AS stored,
+            (a.id IS NULL AND EXISTS (
+               SELECT 1 FROM audit_log_archives x
+                WHERE h.created_at::timestamp BETWEEN x.min_created_at AND x.max_created_at
+            )) AS archived
+       FROM unnest($1::uuid[], $2::int[], $3::text[]) WITH ORDINALITY AS h(id, tenant_id, created_at, ord)
+       LEFT JOIN audit_logs a ON a.id = h.id AND a.tenant_id = h.tenant_id
+      ORDER BY h.ord`,
+    [heads.map((h) => h.id), heads.map((h) => h.tenantId), heads.map((h) => h.createdAt)],
+  );
+  return rows.map((r, i) => {
+    const head = heads[i];
+    if (r.stored == null) return { head, outcome: r.archived === true ? 'archived' : 'missing' };
+    return { head, outcome: r.stored === head.sha256Chain ? 'present' : 'rewritten' };
+  });
+}
+
+/** Every head every anchor names, once each. */
+function distinctHeads(anchors: ChainAnchor[]): AnchoredHead[] {
+  const seen = new Map<string, AnchoredHead>();
+  for (const a of anchors) for (const h of a.heads) seen.set(`${h.tenantId}:${h.id}:${h.sha256Chain}`, h);
+  return [...seen.values()];
+}
+
+/** The objects themselves: written once, never hidden, intact. */
+function readAnchors(stored: StoredAnchor[]): { anchors: ChainAnchor[]; failure?: AnchorCheck } {
+  const anchors: ChainAnchor[] = [];
+  for (const s of stored.slice().sort((a, b) => a.key.localeCompare(b.key))) {
+    if (s.deleteMarkers > 0) {
+      return { anchors, failure: { status: 'broken', firstFailure: s.key, reason: 'an anchor was hidden behind a delete marker' } };
+    }
+    if (s.versions > 1) {
+      return { anchors, failure: { status: 'broken', firstFailure: s.key, reason: `an anchor was written ${s.versions} times` } };
+    }
+    try {
+      anchors.push(parseChainAnchor(s.body));
+    } catch (err) {
+      const reason = `an anchor is not intact: ${err instanceof Error ? err.message : String(err)}`;
+      return { anchors, failure: { status: 'broken', firstFailure: s.key, reason } };
+    }
+  }
+  return { anchors };
+}
+
+/**
+ * Check every anchor against the database, then anchor today's heads.
+ *
+ * Today's anchor is written only when the chain itself verified and no anchor
+ * check failed, so a tampered state is never anchored. Never throws.
+ */
+export async function verifyAndAnchorChainHeads(
+  client: PoolClient,
+  opts: { store: AnchorStore | null; chainOk: boolean; now?: Date },
+): Promise<AnchorCheck> {
+  const { store, chainOk } = opts;
+  if (!store) {
+    return {
+      status: 'unverifiable',
+      reason: 'AUDIT_ANCHOR_BUCKET not configured: the chain head is anchored nowhere outside the database',
+    };
+  }
+  let check: AnchorCheck;
+  try {
+    const { anchors, failure } = readAnchors(await store.readAll());
+    if (failure) return failure;
+    const heads = distinctHeads(anchors);
+    const findings = await findHeads(client, heads);
+    const bad = findings.find((f) => f.outcome === 'missing' || f.outcome === 'rewritten');
+    if (bad) {
+      return {
+        status: 'broken',
+        rowsChecked: findings.length,
+        firstFailure: `tenant:${bad.head.tenantId} row:${bad.head.id}`,
+        reason:
+          bad.outcome === 'missing'
+            ? 'an anchored chain head is no longer in audit_logs and no archive batch accounts for it'
+            : 'an anchored chain head is in audit_logs with a different sha256_chain',
+      };
+    }
+    check =
+      anchors.length === 0
+        ? { status: 'unverifiable', rowsChecked: 0, reason: 'no earlier anchor to check against; the first is written now' }
+        : { status: 'ok', rowsChecked: findings.length };
+  } catch (err) {
+    return { status: 'error', reason: `anchors could not be checked: ${err instanceof Error ? err.message : String(err)}` };
+  }
+
+  if (!chainOk) {
+    return { ...check, reason: [check.reason, 'not anchored today: the chain did not verify'].filter(Boolean).join('; ') };
+  }
+  const now = opts.now ?? new Date();
+  // The store's own prefix: the one it lists, and the one the grant covers.
+  const key = anchorKeyFor(store.prefix, now);
+  try {
+    const anchor = buildChainAnchor(await readChainHeads(client), now);
+    await store.putOnce(key, JSON.stringify(anchor));
+    return { ...check, anchoredKey: key };
+  } catch (err) {
+    if (err instanceof AnchorExistsError) return check;
+    return {
+      status: 'error',
+      rowsChecked: check.rowsChecked,
+      reason: `today's anchor could not be written to ${store.location}: ${err instanceof Error ? err.message : String(err)}`,
+    };
+  }
+}
+
+// ── S3 (the object-locked evidence bucket) ───────────────────────────────────
+
+export interface S3AnchorStoreConfig {
+  bucket: string;
+  prefix?: string;
+  region?: string;
+  /** Test injection. */
+  client?: Pick<S3Client, 'send'>;
+  clientConfig?: S3ClientConfig;
+}
+
+async function bodyText(body: unknown): Promise<string> {
+  const b = body as { transformToString?: () => Promise<string> } | undefined;
+  if (b?.transformToString) return b.transformToString();
+  throw new Error('S3 returned no readable body');
+}
+
+export class S3AnchorStore implements AnchorStore {
+  private readonly client: Pick<S3Client, 'send'>;
+  private readonly bucket: string;
+  readonly prefix: string;
+  readonly location: string;
+
+  constructor(cfg: S3AnchorStoreConfig) {
+    this.bucket = cfg.bucket;
+    this.prefix = (cfg.prefix ?? DEFAULT_ANCHOR_PREFIX).replace(/\/+$/, '');
+    this.location = `s3://${this.bucket}/${this.prefix}/`;
+    this.client = cfg.client ?? new S3Client({ region: cfg.region ?? process.env.AWS_REGION, ...cfg.clientConfig });
+  }
+
+  async putOnce(key: string, body: string): Promise<void> {
+    try {
+      await this.client.send(
+        new PutObjectCommand({
+          Bucket: this.bucket,
+          Key: key,
+          Body: body,
+          ContentType: 'application/json',
+          // Written once: S3 refuses the put when the key exists (412).
+          IfNoneMatch: '*',
+          // Object Lock requires an integrity checksum on the put.
+          ChecksumSHA256: createHash('sha256').update(body, 'utf8').digest('base64'),
+        }),
+      );
+    } catch (err) {
+      const e = err as { name?: string; $metadata?: { httpStatusCode?: number } };
+      if (e?.name === 'PreconditionFailed' || e?.$metadata?.httpStatusCode === 412) throw new AnchorExistsError(key);
+      throw err;
+    }
+  }
+
+  /** Every version and delete marker under the prefix, by key. */
+  private async listVersions(): Promise<{
+    versions: Map<string, Array<{ id: string; at: number }>>;
+    markers: Map<string, number>;
+  }> {
+    const versions = new Map<string, Array<{ id: string; at: number }>>();
+    const markers = new Map<string, number>();
+    let keyMarker: string | undefined;
+    let versionMarker: string | undefined;
+    do {
+      const page = await this.client.send(
+        new ListObjectVersionsCommand({
+          Bucket: this.bucket,
+          Prefix: `${this.prefix}/`,
+          KeyMarker: keyMarker,
+          VersionIdMarker: versionMarker,
+        }),
+      );
+      for (const v of page.Versions ?? []) {
+        if (!v.Key || !v.VersionId) continue;
+        const list = versions.get(v.Key) ?? [];
+        list.push({ id: v.VersionId, at: v.LastModified ? new Date(v.LastModified).getTime() : 0 });
+        versions.set(v.Key, list);
+      }
+      for (const d of page.DeleteMarkers ?? []) {
+        if (d.Key) markers.set(d.Key, (markers.get(d.Key) ?? 0) + 1);
+      }
+      keyMarker = page.IsTruncated ? page.NextKeyMarker : undefined;
+      versionMarker = page.IsTruncated ? page.NextVersionIdMarker : undefined;
+    } while (keyMarker);
+    return { versions, markers };
+  }
+
+  async readAll(): Promise<StoredAnchor[]> {
+    const { versions, markers } = await this.listVersions();
+    const out: StoredAnchor[] = [];
+    for (const key of new Set([...versions.keys(), ...markers.keys()])) {
+      const list = (versions.get(key) ?? []).sort((a, b) => a.at - b.at);
+      const oldest = list[0];
+      const body = oldest
+        ? await bodyText(
+            (await this.client.send(new GetObjectCommand({ Bucket: this.bucket, Key: key, VersionId: oldest.id }))).Body,
+          )
+        : '';
+      out.push({ key, versions: list.length, deleteMarkers: markers.get(key) ?? 0, body });
+    }
+    return out;
+  }
+}
+
+/** The production anchor store, from AUDIT_ANCHOR_BUCKET; null when none is configured. */
+export function resolveAnchorStore(env: NodeJS.ProcessEnv = process.env): S3AnchorStore | null {
+  const bucket = (env.AUDIT_ANCHOR_BUCKET ?? '').trim();
+  if (!bucket) return null;
+  return new S3AnchorStore({ bucket, prefix: env.AUDIT_ANCHOR_PREFIX?.trim() || undefined });
+}
diff --git a/terraform/modules/audit-anchor-access/main.tf b/terraform/modules/audit-anchor-access/main.tf
new file mode 100644
index 000000000..65de83cbb
--- /dev/null
+++ b/terraform/modules/audit-anchor-access/main.tf
@@ -0,0 +1,92 @@
+// Audit chain anchors: what the application task may do in the object-locked
+// evidence bucket (security plan P0-8, the anchored half).
+//
+// Once a day the audit integrity sweep writes every tenant's audit_logs chain
+// head to the evidence bucket, and on every run reads every anchor back
+// (server/services/audit/chain-anchor.ts). An anchor is what shows the newest
+// audit rows removed, or the database restored from an older backup: the hash
+// chain cannot show either. So the task may add anchors and read them, and
+// nothing that removes or replaces one:
+//
+//   - PutObject only with If-None-Match: *, so each key is written once;
+//   - GetObject, GetObjectVersion and ListBucketVersions under the prefix
+//     (the sweep reads every version and every delete marker);
+//   - the bucket's own KMS key, only through S3 and only for this bucket;
+//   - no DeleteObject, no retention or legal-hold change, no governance bypass.
+//
+// The bucket's Object Lock (modules/compliance-evidence) keeps every version
+// for the retention period, whatever any principal is granted.
+
+terraform {
+  required_providers {
+    aws = {
+      source = "hashicorp/aws"
+    }
+  }
+}
+
+locals {
+  anchors = "${var.bucket_arn}/${var.prefix}/*"
+
+  # Plain jsonencode() so the module test can assert it without AWS.
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Sid       = "WriteEachAnchorOnce"
+        Effect    = "Allow"
+        Action    = ["s3:PutObject"]
+        Resource  = local.anchors
+        Condition = { StringEquals = { "s3:if-none-match" = "*" } }
+      },
+      {
+        Sid      = "ReadEveryVersionOfEveryAnchor"
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:GetObjectVersion"]
+        Resource = local.anchors
+      },
+      {
+        Sid       = "ListAnchorVersions"
+        Effect    = "Allow"
+        Action    = ["s3:ListBucketVersions"]
+        Resource  = var.bucket_arn
+        Condition = { StringLike = { "s3:prefix" = ["${var.prefix}/*"] } }
+      },
+      {
+        # The bucket encrypts under its own key with bucket keys on, so the
+        # encryption context is the bucket's ARN.
+        Sid      = "UseTheEvidenceKeyThroughS3ForThisBucket"
+        Effect   = "Allow"
+        Action   = ["kms:GenerateDataKey", "kms:Decrypt"]
+        Resource = var.kms_key_arn
+        Condition = {
+          StringEquals = {
+            "kms:ViaService"                   = "s3.${var.region}.amazonaws.com"
+            "kms:EncryptionContext:aws:s3:arn" = var.bucket_arn
+          }
+        }
+      },
+    ]
+  })
+
+  # What the server reads (resolveAnchorStore in chain-anchor.ts).
+  environment = [
+    { name = "AUDIT_ANCHOR_BUCKET", value = var.bucket_name },
+    { name = "AUDIT_ANCHOR_PREFIX", value = var.prefix },
+  ]
+}
+
+resource "aws_iam_role_policy" "anchors" {
+  name   = "audit-chain-anchors"
+  role   = var.role_name
+  policy = local.policy
+}
+
+output "policy" {
+  value = local.policy
+}
+
+output "environment" {
+  description = "The task environment entries that point the sweep at the anchors."
+  value       = local.environment
+}
diff --git a/terraform/modules/audit-anchor-access/tests/anchor_access.tftest.hcl b/terraform/modules/audit-anchor-access/tests/anchor_access.tftest.hcl
new file mode 100644
index 000000000..ddeda1917
--- /dev/null
+++ b/terraform/modules/audit-anchor-access/tests/anchor_access.tftest.hcl
@@ -0,0 +1,96 @@
+# What the application task may do with audit chain anchors in the
+# object-locked evidence bucket (security plan P0-8). The sweep writes each
+# day's anchor once and reads every version back
+# (server/services/audit/chain-anchor.ts). If the task could replace, delete or
+# unlock an anchor, whoever removed audit rows could remove the record of them
+# too.
+#
+#   cd terraform/modules/audit-anchor-access
+#   terraform init -backend=false && terraform test
+
+mock_provider "aws" {}
+
+variables {
+  role_name   = "c2c-production-ecs-task"
+  bucket_name = "c2c-production-part11-evidence"
+  bucket_arn  = "arn:aws:s3:::c2c-production-part11-evidence"
+  kms_key_arn = "arn:aws:kms:us-east-1:123456789012:key/evidence"
+  region      = "us-east-1"
+}
+
+run "an_anchor_is_written_once_and_never_removed" {
+  command = plan
+
+  # Every put is conditional on the key not existing.
+  assert {
+    condition = alltrue([
+      for st in jsondecode(output.policy).Statement :
+      try(st.Condition.StringEquals["s3:if-none-match"], "") == "*"
+      if contains(flatten([st.Action]), "s3:PutObject")
+    ])
+    error_message = "The task may put an anchor without If-None-Match: *, so it could overwrite one."
+  }
+
+  # Nothing that removes, unlocks or re-dates an object, and no wildcard action.
+  assert {
+    condition = length(setintersection(
+      toset(flatten([for st in jsondecode(output.policy).Statement : st.Action])),
+      toset([
+        "s3:*", "s3:Delete*", "s3:DeleteObject", "s3:DeleteObjectVersion",
+        "s3:PutObjectRetention", "s3:PutObjectLegalHold", "s3:BypassGovernanceRetention",
+        "s3:PutBucketObjectLockConfiguration", "s3:PutBucketVersioning", "s3:PutBucketPolicy",
+        "s3:PutLifecycleConfiguration", "kms:*",
+      ])
+    )) == 0
+    error_message = "The task holds an action that can remove, unlock or re-date an anchor."
+  }
+
+  # Objects only under the prefix; the bucket itself only to list versions there.
+  assert {
+    condition = alltrue([
+      for st in jsondecode(output.policy).Statement :
+      alltrue([
+        for r in flatten([st.Resource]) :
+        r == "arn:aws:s3:::c2c-production-part11-evidence/audit-chain-anchors/*" ||
+        (r == var.bucket_arn && jsonencode(flatten([st.Action])) == jsonencode(["s3:ListBucketVersions"]) &&
+        jsonencode(try(st.Condition.StringLike["s3:prefix"], null)) == jsonencode(["audit-chain-anchors/*"])) ||
+        r == var.kms_key_arn
+      ])
+    ])
+    error_message = "The task reaches evidence outside the anchor prefix."
+  }
+
+  # The evidence key, through S3, for this bucket only.
+  assert {
+    condition = alltrue([
+      for st in jsondecode(output.policy).Statement :
+      st.Resource == var.kms_key_arn &&
+      try(st.Condition.StringEquals["kms:ViaService"], "") == "s3.us-east-1.amazonaws.com" &&
+      try(st.Condition.StringEquals["kms:EncryptionContext:aws:s3:arn"], "") == var.bucket_arn
+      if anytrue([for a in flatten([st.Action]) : startswith(a, "kms:")])
+    ])
+    error_message = "The task may use the evidence key outside S3 or for another bucket."
+  }
+
+  assert {
+    condition     = aws_iam_role_policy.anchors.role == "c2c-production-ecs-task"
+    error_message = "The grant is not on the application task role."
+  }
+
+  # The server reads exactly these names.
+  assert {
+    condition = jsonencode(output.environment) == jsonencode([
+      { name = "AUDIT_ANCHOR_BUCKET", value = "c2c-production-part11-evidence" },
+      { name = "AUDIT_ANCHOR_PREFIX", value = "audit-chain-anchors" },
+    ])
+    error_message = "The task environment does not point the sweep at the anchors."
+  }
+}
+
+run "a_prefix_with_a_slash_at_either_end_is_refused" {
+  command = plan
+  variables {
+    prefix = "/audit-chain-anchors/"
+  }
+  expect_failures = [var.prefix]
+}
