+function s3(handler: (cmd: unknown) => unknown) {
+  const send = vi.fn(async (cmd: unknown) => handler(cmd));
+  return { send, store: new S3AnchorStore({ bucket: 'c2c-part11-evidence', client: { send } as never }) };
+}
+
