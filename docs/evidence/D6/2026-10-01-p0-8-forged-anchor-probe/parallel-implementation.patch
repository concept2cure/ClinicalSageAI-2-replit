diff --git a/terraform/stack/audit_anchor.tf b/terraform/stack/audit_anchor.tf
new file mode 100644
index 000000000..253c87a03
--- /dev/null
+++ b/terraform/stack/audit_anchor.tf
@@ -0,0 +1,22 @@
+# ── Audit chain anchors (security plan P0-8, the anchored half) ──────────────
+#
+# The audit integrity sweep writes every tenant's audit_logs chain head to the
+# object-locked evidence bucket once a day and checks every anchor on each run
+# (server/services/audit/chain-anchor.ts). The hash chain cannot show its
+# newest rows removed, or the database restored from an older backup; the
+# anchors can. The grant (modules/audit-anchor-access) lets the task add
+# anchors and read them back, and nothing that removes or replaces one.
+#
+# The task finds the anchors through module.audit_anchor.environment
+# (AUDIT_ANCHOR_BUCKET, AUDIT_ANCHOR_PREFIX). Without them the sweep reports
+# the anchor check as unverifiable every day, never as passed.
+
+module "audit_anchor" {
+  source = "../modules/audit-anchor-access"
+  # The role's name is the last segment of its ARN (a role ARN may carry a path).
+  role_name   = regex("[^/]+$", module.ecs.task_role_arn)
+  bucket_name = module.evidence.evidence_bucket
+  bucket_arn  = module.evidence.evidence_bucket_arn
+  kms_key_arn = module.evidence.kms_key_arn
+  region      = var.region
+}
diff --git a/tests/db/audit-chain-anchor.dbtest.ts b/tests/db/audit-chain-anchor.dbtest.ts
new file mode 100644
index 000000000..a2f546775
--- /dev/null
+++ b/tests/db/audit-chain-anchor.dbtest.ts
@@ -0,0 +1,267 @@
+/**
+ * The audit_logs chain heads, anchored outside the database (security plan
+ * P0-8, the anchored half; acceptance: "truncating the newest rows fails the
+ * anchored verification").
+ *
+ * The sha256 chain cannot show its newest rows removed: what remains is a
+ * valid, shorter chain. That is shown here first: verifyAuditChain passes after
+ * the removal. The anchors written by the daily sweep (chain-anchor.ts) are
+ * what catch it.
+ *
+ * Real PostgreSQL built by install-fresh + deploy-migrate. The rows are
+ * written by the production writer (writeChainedAuditRow). The removals are
+ * done as the database owner with the trigger disabled: the actor the anchor
+ * exists for, since the runtime role can do none of it (P0-8 grant half). The
+ * bucket is an in-memory stand-in with S3 Object Lock's semantics: a key is
+ * written once, and every version and delete marker stays visible. The S3
+ * store itself is covered in server/services/audit/__tests__/chain-anchor.test.ts.
+ */
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { Pool } from 'pg';
+import { databaseUrl } from '../setup.db';
+import { writeChainedAuditRow } from '../../server/services/auditService';
+import { verifyAuditChain } from '../../server/services/audit/chain';
+import {
+  AnchorExistsError,
+  buildChainAnchor,
+  readChainHeads,
+  verifyAndAnchorChainHeads,
+  type AnchorStore,
+  type AnchoredHead,
+  type StoredAnchor,
+} from '../../server/services/audit/chain-anchor';
+
+/** One tenant per case, so a case's removals cannot reach another's chain. */
+const TENANTS = { truncated: 90651, forged: 90652, rewritten: 90653, archived: 90654, steady: 90655 } as const;
+const ALL = Object.values(TENANTS);
+const ACTION = 'dbtest.chain_anchor';
+
+let owner: Pool;
+const day = (n: number) => new Date(Date.UTC(2031, 0, n, 2, 0, 0));
+
+/** An object-locked bucket: a key is written once; every version and delete marker stays visible. */
+class LockedBucket implements AnchorStore {
+  readonly location = 'memory://evidence/audit-chain-anchors/';
+  readonly prefix = 'audit-chain-anchors';
+  readonly objects = new Map<string, { versions: string[]; deleteMarkers: number }>();
+  async putOnce(key: string, body: string): Promise<void> {
+    if (this.objects.has(key)) throw new AnchorExistsError(key);
+    this.objects.set(key, { versions: [body], deleteMarkers: 0 });
+  }
+  async readAll(): Promise<StoredAnchor[]> {
+    return [...this.objects].map(([key, o]) => ({
+      key,
+      versions: o.versions.length,
+      deleteMarkers: o.deleteMarkers,
+      body: o.versions[0],
+    }));
+  }
+}
+
+async function writeRows(tenantId: number, n: number): Promise<void> {
+  const c = await owner.connect();
+  try {
+    for (let i = 0; i < n; i++) {
+      await c.query('BEGIN');
+      await writeChainedAuditRow(c, {
+        tenantId,
+        action: ACTION,
+        resourceType: 'anchor_probe',
+        resourceId: `${tenantId}-${i}-${Date.now()}`,
+        details: { i },
+      });
+      await c.query('COMMIT');
+    }
+  } finally {
+    c.release();
+  }
+}
+
+async function headOf(tenantId: number): Promise<AnchoredHead> {
+  const c = await owner.connect();
+  try {
+    const head = (await readChainHeads(c)).find((h) => h.tenantId === tenantId);
+    if (!head) throw new Error(`no head for tenant ${tenantId}`);
+    return head;
+  } finally {
+    c.release();
+  }
+}
+
+/** The owner, with the trigger off: what the anchor is for. */
+async function asOwnerWithout(trigger: string, table: string, sql: string, params: unknown[]): Promise<void> {
+  const c = await owner.connect();
+  try {
+    await c.query('BEGIN');
+    await c.query(`ALTER TABLE ${table} DISABLE TRIGGER ${trigger}`);
+    await c.query(sql, params);
+    await c.query(`ALTER TABLE ${table} ENABLE TRIGGER ${trigger}`);
+    await c.query('COMMIT');
+  } catch (err) {
+    await c.query('ROLLBACK');
+    throw err;
+  } finally {
+    c.release();
+  }
+}
+
+/** Remove a tenant's newest n rows. */
+async function truncateNewest(tenantId: number, n: number): Promise<string[]> {
+  const { rows } = await owner.query(
+    `SELECT id::text AS id FROM audit_logs WHERE tenant_id = $1 ORDER BY chain_seq DESC NULLS LAST LIMIT $2`,
+    [tenantId, n],
+  );
+  const ids = rows.map((r) => r.id as string);
+  await asOwnerWithout('trg_audit_logs_no_delete', 'audit_logs', 'DELETE FROM audit_logs WHERE id = ANY($1::uuid[])', [ids]);
+  return ids;
+}
+
+async function sweep(bucket: AnchorStore, now: Date, chainOk = true) {
+  const c = await owner.connect();
+  try {
+    return await verifyAndAnchorChainHeads(c, { store: bucket, chainOk, now });
+  } finally {
+    c.release();
+  }
+}
+
+async function chainOf(tenantId: number) {
+  const c = await owner.connect();
+  try {
+    return await verifyAuditChain(c, { tenantId });
+  } finally {
+    c.release();
+  }
+}
+
+let archiveMarker: string;
+
+beforeAll(async () => {
+  owner = new Pool({ connectionString: databaseUrl, max: 3 });
+  for (const t of ALL) await writeRows(t, 3);
+  archiveMarker = `dbtest-chain-anchor-${process.pid}-${Date.now()}`;
+});
+
+afterAll(async () => {
+  await asOwnerWithout('trg_audit_logs_no_delete', 'audit_logs', 'DELETE FROM audit_logs WHERE tenant_id = ANY($1::int[])', [ALL]);
+  await asOwnerWithout(
+    'trg_audit_log_archives_no_delete',
+    'audit_log_archives',
+    'DELETE FROM audit_log_archives WHERE locator = $1',
+    [archiveMarker],
+  );
+  await owner.end();
+});
+
+describe('anchoring', () => {
+  it('the first run has nothing to check against, and anchors every tenant’s head', async () => {
+    const bucket = new LockedBucket();
+    const first = await sweep(bucket, day(1));
+    expect(first.status).toBe('unverifiable');
+    expect(first.anchoredKey).toBe('audit-chain-anchors/2031/01/01.json');
+    const anchored = JSON.parse(bucket.objects.get(first.anchoredKey!)!.versions[0]);
+    expect(anchored.heads).toContainEqual(await headOf(TENANTS.steady));
+  });
+
+  it('untouched, the next run checks every anchored head, and anchors again', async () => {
+    const bucket = new LockedBucket();
+    await sweep(bucket, day(1));
+    await writeRows(TENANTS.steady, 2);
+    const second = await sweep(bucket, day(2));
+    expect(second.status).toBe('ok');
+    expect(second.rowsChecked).toBeGreaterThanOrEqual(ALL.length);
+    expect(second.anchoredKey).toBe('audit-chain-anchors/2031/01/02.json');
+    // A second run on the same day finds today's anchor written, and says so by not writing.
+    const again = await sweep(bucket, day(2));
+    expect(again).toMatchObject({ status: 'ok' });
+    expect(again.anchoredKey).toBeUndefined();
+  });
+
+  it('a chain that did not verify is not anchored', async () => {
+    const bucket = new LockedBucket();
+    const run = await sweep(bucket, day(1), false);
+    expect(run.anchoredKey).toBeUndefined();
+    expect(run.reason).toMatch(/not anchored today/);
+    expect(bucket.objects.size).toBe(0);
+  });
+});
+
+describe('what the chain cannot see, the anchor does', () => {
+  it('the newest rows removed: the chain still verifies, the anchored verification fails', async () => {
+    const bucket = new LockedBucket();
+    await sweep(bucket, day(1));
+    const anchoredHead = await headOf(TENANTS.truncated);
+    const removed = await truncateNewest(TENANTS.truncated, 2);
+    expect(removed).toContain(anchoredHead.id);
+
+    // The gap: a valid, shorter chain.
+    const chain = await chainOf(TENANTS.truncated);
+    expect(chain.ok).toBe(true);
+
+    const run = await sweep(bucket, day(2));
+    expect(run.status).toBe('broken');
+    expect(run.firstFailure).toBe(`tenant:${TENANTS.truncated} row:${anchoredHead.id}`);
+    expect(run.reason).toMatch(/no longer in audit_logs/);
+    expect(run.anchoredKey).toBeUndefined();
+  });
+
+  it('a newer anchor naming the older head does not hide the removal', async () => {
+    const bucket = new LockedBucket();
+    await sweep(bucket, day(1));
+    const anchoredHead = await headOf(TENANTS.forged);
+    await truncateNewest(TENANTS.forged, 1);
+    // Whoever removed the rows writes tomorrow's anchor over the shorter chain.
+    const c = await owner.connect();
+    try {
+      await bucket.putOnce('audit-chain-anchors/2031/01/02.json', JSON.stringify(buildChainAnchor(await readChainHeads(c), day(2))));
+    } finally {
+      c.release();
+    }
+    const run = await sweep(bucket, day(3));
+    expect(run.status).toBe('broken');
+    expect(run.firstFailure).toBe(`tenant:${TENANTS.forged} row:${anchoredHead.id}`);
+  });
+
+  it('a head rewritten in place fails', async () => {
+    const bucket = new LockedBucket();
+    await sweep(bucket, day(1));
+    const head = await headOf(TENANTS.rewritten);
+    await asOwnerWithout('trg_audit_logs_no_update', 'audit_logs', 'UPDATE audit_logs SET sha256_chain = $2 WHERE id = $1', [
+      head.id,
+      'f'.repeat(64),
+    ]);
+    const run = await sweep(bucket, day(2));
+    expect(run).toMatchObject({ status: 'broken', firstFailure: `tenant:${TENANTS.rewritten} row:${head.id}` });
+    expect(run.reason).toMatch(/different sha256_chain/);
+  });
+
+  it('an anchor written twice, or hidden behind a delete marker, is itself a failure', async () => {
+    const bucket = new LockedBucket();
+    const first = await sweep(bucket, day(1));
+    const object = bucket.objects.get(first.anchoredKey!)!;
+    object.versions.push(object.versions[0]);
+    expect(await sweep(bucket, day(2))).toMatchObject({ status: 'broken', firstFailure: first.anchoredKey, reason: expect.stringMatching(/written 2 times/) });
+    object.versions.pop();
+    object.deleteMarkers = 1;
+    expect(await sweep(bucket, day(2))).toMatchObject({ status: 'broken', reason: expect.stringMatching(/delete marker/) });
+  });
+});
+
+describe('the archive door', () => {
+  it('a head the archive door removed is accounted for by the archive record, and only by it', async () => {
+    const bucket = new LockedBucket();
+    await sweep(bucket, day(1));
+    const head = await headOf(TENANTS.archived);
+    await asOwnerWithout('trg_audit_logs_no_delete', 'audit_logs', 'DELETE FROM audit_logs WHERE id = $1', [head.id]);
+    // Without the door's record, the removal is a failure.
+    expect((await sweep(bucket, day(2))).status).toBe('broken');
+    // The record the door writes for the batch that held it.
+    await owner.query(
+      `INSERT INTO audit_log_archives (row_count, min_created_at, max_created_at, cutoff, locator, sha256)
+       VALUES (1, $1::timestamp, $1::timestamp, $1::timestamp + interval '1 second', $2, $3)`,
+      [head.createdAt, archiveMarker, 'a'.repeat(64)],
+    );
+    const run = await sweep(bucket, day(2));
+    expect(run.status).toBe('ok');
+  });
+});
