+// @vitest-environment jsdom
+/**
+ * The trial master file inside the Vault's Required documents view
+ * (surfaces/VaultTrialMasterFile.tsx; P-74, P-75; the founder, 2026-11-10: "I
+ * don't see the TMF on the vault UI anywhere").
+ *
+ * The transport is mocked. The completeness answers are computed by the
+ * service's own pure assessment (server/services/etmf/tmf-completeness.ts)
+ * over a small in-memory set of filings, so a filing or a removal changes what
+ * the next read says the way the server's would.
+ *
+ * What is pinned:
+ *   - it is a section of Required documents, never a view of its own, and it
+ *     reads nothing until that view is opened;
+ *   - which study: one is used, several are chosen between, none is said;
+ *   - the verdict in a sentence; not determined is never complete or incomplete;
+ *     a read with nothing to check states no verdict;
+ *   - the zones, each record by its catalog name, with what it is filed against;
+ *   - a refusal said as itself, and a failed read never an empty trial master file;
+ *   - filing: a version picked from this project's Vault, a reason of at least
+ *     8 characters, and the reference the Vault returned; removing with a reason;
+ *   - no write control for a role that may not write the Vault;
+ *   - the inspection package: saved, or the failure with its reason;
+ *   - the header's "Inspection readiness" shows Required documents and brings
+ *     the section into view, and no longer opens the separate screen.
+ */
+import React from 'react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { cleanup, fireEvent, render, screen, waitFor, within } from '@testing-library/react';
+import { createHash } from 'node:crypto';
+
+const H = vi.hoisted(() => ({ apiRequest: vi.fn(), canWrite: true, locked: new Set<string>(), saved: [] as Array<{ name: string; blob: Blob }> }));
+vi.mock('@/lib/queryClient', async (original) => ({ ...(await original<typeof import('@/lib/queryClient')>()), apiRequest: H.apiRequest }));
+vi.mock('../surfaces/VaultViewOnly', async (original) => ({ ...(await original<typeof import('../surfaces/VaultViewOnly')>()), useVaultCanWrite: () => H.canWrite }));
+vi.mock('../download', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('../download')>()),
+  downloadBlob: (name: string, blob: Blob) => { H.saved.push({ name, blob }); return true; },
+}));
+/* The release's verdicts: a surface in `locked` is outside it, as production reports one (filingPathNoDeadEnds.test.tsx). */
+vi.mock('../navEntitlements', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('../navEntitlements')>()),
+  useNavEntitlements: () => ({
+    verdictFor: (id: string) => (H.locked.has(id) ? { id, label: id, entitled: false, source: 'launch-scope', requiredTier: null } : null),
+    resolved: true, masterAdmin: false, platformAdmin: false, tier: null,
+  }),
+}));
+
+import { ApiRequestError, extractApiError } from '@/lib/queryClient';
+import { assessTmfCompleteness, type TmfDocumentEvidence } from '../../../../../server/services/etmf/tmf-completeness';
+import { TMF_REFERENCE_MODEL, tmfArtifactName } from '@shared/constants/domain/tmf-reference-model';
+import { Vault } from '../surfaces/Vault';
+import { VAULT_TMF_SECTION_ID, VaultTrialMasterFile, tmfVerdict } from '../surfaces/VaultTrialMasterFile';
+import { PID, mockVaultApi, ok, props, vaultPayload } from './_vault-surface-fixtures';
+
+const STUDY = { studyId: 'BX-204-201', programId: PID, title: 'BX-204 in plaque psoriasis', phase: '2', indication: 'Plaque psoriasis', status: 'draft', updatedAt: null };
+const EXTENSION = { ...STUDY, studyId: 'BX-204-301', title: 'BX-204 long-term extension', phase: '3' };
+const PLAN_DOC = '22222222-2222-4222-8222-222222222222';
+const PROTOCOL_DOC = '33333333-3333-4333-8333-333333333333';
+const DOCS = [{ docId: PLAN_DOC, title: 'Monitoring Plan v2' }, { docId: PROTOCOL_DOC, title: 'Protocol BX-204-201 v1.0' }];
+const ESSENTIAL = TMF_REFERENCE_MODEL.flatMap((z) => z.artifacts.filter((a) => a.essential).map((a) => a.code));
+const BASE = `/api/etmf/trials/${STUDY.studyId}`;
+
+type FilingRow = { id: string; artifactCode: string; documentRef: string | null; filedAt: string };
+const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } });
+/* The refusals as their senders write them, read into the error apiRequest throws by its own reader (extractApiError). */
+const GATE = (code: string, message: string) => ({ error: { code, message } }); // server/middleware/moduleEntitlementGate.ts
+const ROUTE = (code: string, message: string) => ({ success: false, error: code, message }); // server/routes/etmf.routes.ts
+const ROLE = { error: 'Insufficient permissions' }; // the role guard: no code
+const NOT_RELEASED = GATE('LAUNCH_SCOPE', 'This part of the product is not in this release.');
+const NOT_LICENSED = GATE('MODULE_NOT_LICENSED', 'This module is not part of your subscription.');
+const NO_STUDY = ROUTE('STUDY_NOT_FOUND', 'No study with this id is in a project you can open. Nothing was read or changed.');
+const FAILED = ROUTE('INTERNAL', 'eTMF request failed.');
+function refusal(status: number, payload: unknown): ApiRequestError {
+  const { message, code } = extractApiError(payload, status);
+  return new ApiRequestError(message, status, payload, code);
+}
+const filing = (artifactCode: string, documentRef: string | null, n = 1): FilingRow =>
+  ({ id: `f${n}f${n}f${n}f${n}-0000-4000-8000-00000000000${n}`, artifactCode, documentRef, filedAt: '2026-11-02T09:30:00.000Z' });
+
+/* The server's state for one study: its live filings and the Vault documents that exist. */
+let studies: unknown[];
+let filings: FilingRow[];
+let vaultDocs: Set<string>;
+let refuseWith: Partial<Record<'studies' | 'completeness' | 'filings' | 'file' | 'remove' | 'package', () => Response>>;
+
+function evidenceOf(row: FilingRow): TmfDocumentEvidence {
+  const ref = (row.documentRef ?? '').trim();
+  if (!ref) return 'no_document';
+  const id = /^vault:\/\/(.+)$/.exec(ref)?.[1];
+  if (!id) return 'unverifiable';
+  return vaultDocs.has(id) ? 'verified' : 'unresolved';
+}
+/* As GET …/completeness answers: the service's assessment of the live filings, with the study it is about. */
+const completenessNow = () => ({
+  ...assessTmfCompleteness({
+    providedArtifacts: filings.map((f) => f.artifactCode),
+    scope: 'essential',
+    documentEvidence: Object.fromEntries(filings.map((f) => [f.artifactCode, evidenceOf(f)])),
+  }),
+  study: { id: 7, studyId: STUDY.studyId, programId: PID, protocolId: 'BX-204-201', title: STUDY.title, phase: STUDY.phase, indication: STUDY.indication, status: 'draft' },
+});
+
+const PACKAGE = new TextEncoder().encode('PK-inspection-package');
+const packageSha = createHash('sha256').update(PACKAGE).digest('hex');
+const packageResponse = (sha: string) => new Response(PACKAGE, {
+  status: 200,
+  headers: { 'Content-Type': 'application/zip', 'Content-Disposition': 'attachment; filename="BX-204-201_inspection-package.zip"', 'X-TMF-SHA256': sha, 'X-TMF-Ready': 'false' },
+});
+
+const SEARCH = { data: { query: 'plan', total: 1, limit: 25, offset: 0,
+  results: [{ id: PLAN_DOC, title: 'Monitoring Plan v2', version: '2', current: true, snippet: null, contentHash: 'a'.repeat(64) }] } };
+/** The refusal a case has set for a route, thrown or returned as the transport would; null when the route answers. */
+const refused = (route: keyof typeof refuseWith) => refuseWith[route]?.() ?? null;
+function fileIt(body: unknown): Response {
+  const sent = body as { artifactCode?: string; documentRef?: string };
+  const row = filing(String(sent.artifactCode), sent.documentRef ?? null, 9);
+  filings = [...filings.filter((f) => f.artifactCode !== row.artifactCode), row];
+  return json(row, 201);
+}
+function removeIt(url: string): Response {
+  filings = filings.filter((f) => f.id !== decodeURIComponent(url.slice('/api/etmf/artifacts/'.length)));
+  return new Response(null, { status: 204 });
+}
+const ROUTES: Array<{ method: string; match: (url: string) => boolean; answer: (url: string, body: unknown) => Response }> = [
+  { method: 'GET', match: (u) => u === `/api/study-design?program_id=${PID}`, answer: () => refused('studies') ?? json({ designs: studies }) },
+  { method: 'GET', match: (u) => u === `${BASE}/completeness?scope=essential`, answer: () => refused('completeness') ?? json(completenessNow()) },
+  { method: 'GET', match: (u) => u === `${BASE}/artifacts`, answer: () => refused('filings') ?? json(filings) },
+  { method: 'GET', match: (u) => u === `${BASE}/inspection-package?scope=essential`, answer: () => refused('package') ?? packageResponse(packageSha) },
+  { method: 'GET', match: (u) => u.startsWith(`/api/c2c/project-vault/${PID}/search?q=`), answer: () => json(SEARCH) },
+  { method: 'POST', match: (u) => u === `${BASE}/artifacts`, answer: (_u, body) => refused('file') ?? fileIt(body) },
+  { method: 'DELETE', match: (u) => u.startsWith('/api/etmf/artifacts/'), answer: (u) => refused('remove') ?? removeIt(u) },
+];
+/** The routes the section calls, answered from the state above; null for any other request. */
+async function tmfApi(method: string, url: string, body?: unknown): Promise<Response | null> {
+  const route = ROUTES.find((r) => r.method === method && r.match(url));
+  return route ? route.answer(url, body) : null;
+}
+
+const calls = (method: string, match: (url: string) => boolean) =>
+  H.apiRequest.mock.calls.filter(([m, u]) => m === method && match(String(u)));
+const etmfCalls = () => H.apiRequest.mock.calls.filter(([, u]) => String(u).startsWith('/api/etmf') || String(u).startsWith('/api/study-design'));
+const record = (code: string) => screen.getByTestId(`vault-tmf-record-${code}`);
+const section = () => render(<VaultTrialMasterFile projectId={PID} active documents={DOCS} />);
+
+beforeEach(() => {
+  H.canWrite = true; H.saved = []; H.locked.clear();
+  studies = [STUDY];
+  vaultDocs = new Set([PLAN_DOC, PROTOCOL_DOC]);
+  filings = [filing('protocol', `vault://${PROTOCOL_DOC}`, 1)];
