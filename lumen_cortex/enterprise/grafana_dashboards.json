{
  "__meta": {
    "version": "1.0.0",
    "generated": "2025-01-24",
    "description": "Grafana dashboard configurations for Lumen Cortex monitoring"
  },

  "datasources": {
    "prometheus": {
      "name": "Prometheus",
      "type": "prometheus",
      "url": "http://prometheus:9090",
      "access": "proxy",
      "isDefault": true
    },
    "loki": {
      "name": "Loki",
      "type": "loki",
      "url": "http://loki:3100",
      "access": "proxy"
    }
  },

  "dashboards": {
    "overview": {
      "uid": "lumen-cortex-overview",
      "title": "Lumen Cortex - System Overview",
      "description": "High-level system health and performance metrics",
      "tags": ["lumen-cortex", "overview"],
      "refresh": "30s",
      "time": {
        "from": "now-1h",
        "to": "now"
      },
      "panels": [
        {
          "id": 1,
          "title": "Request Rate",
          "type": "stat",
          "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
          "targets": [
            {
              "expr": "sum(rate(lumen_cortex_http_requests_total[5m]))",
              "legendFormat": "Requests/s"
            }
          ],
          "options": {
            "colorMode": "value",
            "graphMode": "area"
          }
        },
        {
          "id": 2,
          "title": "Error Rate",
          "type": "stat",
          "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
          "targets": [
            {
              "expr": "sum(rate(lumen_cortex_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(lumen_cortex_http_requests_total[5m])) * 100",
              "legendFormat": "Error %"
            }
          ],
          "options": {
            "colorMode": "value",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        },
        {
          "id": 3,
          "title": "P95 Latency",
          "type": "stat",
          "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(lumen_cortex_http_request_duration_seconds_bucket[5m])) by (le))",
              "legendFormat": "P95 (s)"
            }
          ],
          "options": {
            "unit": "s"
          }
        },
        {
          "id": 4,
          "title": "Active Connections",
          "type": "stat",
          "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
          "targets": [
            {
              "expr": "sum(lumen_cortex_db_connections_active)",
              "legendFormat": "Active"
            }
          ]
        },
        {
          "id": 5,
          "title": "Request Rate by Endpoint",
          "type": "timeseries",
          "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
          "targets": [
            {
              "expr": "sum(rate(lumen_cortex_http_requests_total[5m])) by (path)",
              "legendFormat": "{{path}}"
            }
          ],
          "options": {
            "legend": { "displayMode": "table" }
          }
        },
        {
          "id": 6,
          "title": "Latency Distribution",
          "type": "heatmap",
          "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
          "targets": [
            {
              "expr": "sum(increase(lumen_cortex_http_request_duration_seconds_bucket[5m])) by (le)",
              "legendFormat": "{{le}}"
            }
          ]
        },
        {
          "id": 7,
          "title": "Cache Hit Rate",
          "type": "gauge",
          "gridPos": { "x": 0, "y": 12, "w": 8, "h": 6 },
          "targets": [
            {
              "expr": "sum(rate(lumen_cortex_cache_hits_total[5m])) / (sum(rate(lumen_cortex_cache_hits_total[5m])) + sum(rate(lumen_cortex_cache_misses_total[5m]))) * 100",
              "legendFormat": "Hit Rate %"
            }
          ],
          "options": {
            "showThresholdLabels": true,
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 70 },
                { "color": "green", "value": 90 }
              ]
            }
          }
        },
        {
          "id": 8,
          "title": "Database Pool Status",
          "type": "bargauge",
          "gridPos": { "x": 8, "y": 12, "w": 8, "h": 6 },
          "targets": [
            {
              "expr": "lumen_cortex_db_connections_active",
              "legendFormat": "Active - {{pool}}"
            },
            {
              "expr": "lumen_cortex_db_connections_idle",
              "legendFormat": "Idle - {{pool}}"
            }
          ]
        },
        {
          "id": 9,
          "title": "Documents Processed",
          "type": "timeseries",
          "gridPos": { "x": 16, "y": 12, "w": 8, "h": 6 },
          "targets": [
            {
              "expr": "sum(rate(lumen_cortex_documents_processed_total[5m])) by (status)",
              "legendFormat": "{{status}}"
            }
          ]
        }
      ]
    },

