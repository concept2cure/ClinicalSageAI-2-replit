  "alertRules": {
    "high_error_rate": {
      "name": "High Error Rate",
      "condition": "sum(rate(lumen_cortex_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(lumen_cortex_http_requests_total[5m])) > 0.05",
      "for": "5m",
      "severity": "critical",
      "annotations": {
        "summary": "High error rate detected",
        "description": "Error rate is above 5% for the last 5 minutes"
      }
    },
    "high_latency": {
      "name": "High Latency",
      "condition": "histogram_quantile(0.95, sum(rate(lumen_cortex_http_request_duration_seconds_bucket[5m])) by (le)) > 5",
      "for": "5m",
      "severity": "warning",
      "annotations": {
        "summary": "High P95 latency",
        "description": "P95 latency is above 5 seconds"
      }
    },
    "low_cache_hit_rate": {
      "name": "Low Cache Hit Rate",
      "condition": "sum(rate(lumen_cortex_cache_hits_total[5m])) / (sum(rate(lumen_cortex_cache_hits_total[5m])) + sum(rate(lumen_cortex_cache_misses_total[5m]))) < 0.7",
      "for": "10m",
      "severity": "warning",
      "annotations": {
        "summary": "Low cache hit rate",
        "description": "Cache hit rate is below 70%"
      }
    },
    "db_connection_pool_exhausted": {
      "name": "DB Connection Pool Exhausted",
      "condition": "lumen_cortex_db_connections_idle == 0",
      "for": "2m",
      "severity": "critical",
      "annotations": {
        "summary": "Database connection pool exhausted",
        "description": "No idle connections available in pool"
      }
    },
    "high_llm_latency": {
      "name": "High LLM Latency",
      "condition": "histogram_quantile(0.95, sum(rate(lumen_cortex_llm_request_duration_seconds_bucket[5m])) by (le)) > 30",
      "for": "5m",
      "severity": "warning",
      "annotations": {
        "summary": "High LLM request latency",
        "description": "LLM P95 latency is above 30 seconds"
      }
    },
    "compliance_failures": {
      "name": "Compliance Check Failures",
      "condition": "sum(rate(lumen_cortex_compliance_checks_total{result=\"fail\"}[1h])) > 10",
      "for": "1h",
      "severity": "warning",
      "annotations": {
        "summary": "Multiple compliance failures",
        "description": "More than 10 compliance check failures in the last hour"
      }
    },
    "auth_failures": {
      "name": "Authentication Failures",
      "condition": "sum(rate(lumen_cortex_auth_attempts_total{result=\"failure\"}[5m])) > 10",
      "for": "5m",
      "severity": "warning",
      "annotations": {
        "summary": "High authentication failure rate",
        "description": "More than 10 auth failures per minute"
      }
    }
  }
}
