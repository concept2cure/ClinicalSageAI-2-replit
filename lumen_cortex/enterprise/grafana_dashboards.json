          ]
        },
        {
          "id": 8,
          "title": "Token Usage by Model",
          "type": "piechart",
          "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
          "targets": [
            {
              "expr": "sum(increase(lumen_cortex_llm_tokens_used_total[24h])) by (model)",
