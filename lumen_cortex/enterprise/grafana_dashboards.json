          "title": "Embedding Batch Sizes",
          "type": "histogram",
          "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
          "targets": [
            {
              "expr": "sum(rate(lumen_cortex_embedding_batch_size_bucket[5m])) by (le)",
              "legendFormat": "{{le}}"
