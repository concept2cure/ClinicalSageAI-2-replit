# Health Canada API Configuration
HEALTH_CANADA_API_KEY=""  # Optional - Health Canada doesn't require API key for public data
USE_HEALTH_CANADA_PROXY=false  # Set to true if using external proxy service
HEALTH_CANADA_PROXY_URL=""  # e.g., https://your-proxy-service.com/api

# For CodeSpace development (uses fallback)
NODE_ENV=development
