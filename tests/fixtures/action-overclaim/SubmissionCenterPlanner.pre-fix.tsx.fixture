// Pre-fix SubmissionCenter Planner card (recovered). The label promises a
// governed generative act; the handler delivers a sentence to the chat rail.
export function PlannerCard({ sub, onAsk }: any) {
  return (
    <div className="cm-pushbar sc-mt">
      <button
        type="button"
        className="sp-primary sc-btn"
        onClick={() =>
          onAsk(
            `Plan the ${regL(sub.primaryRegion)} ${appL(sub.applicationType)} submission for ${sub.title} from the region profile.`
          )
        }
      >
        {I.sparkles} Generate plan (plan_submission)
      </button>
    </div>
  );
}
