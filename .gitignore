node_modules/
# Also match a node_modules SYMLINK. The rule above ends in a slash, so it
# matches directories ONLY — a worktree or CI checkout that symlinks
# node_modules at a shared install is not covered by it, and `git add -A` will
# happily stage the link. That has already put one into history once.
node_modules
dist/
.cache/
.cerv2_program_id

# Secrets & environment files — never commit real values.
# Ignore all .env variants but keep the *.example templates tracked.
.env
.env.*
!.env.example
!.env*.example
!.env.beta.example

# Private keys, certificates, and credential bundles
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
secrets.json
secrets.*.json
*.secret

# Stray runtime artifacts (not part of source)
tmp/
uploads/
logs/
bun.lock
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
*.egg-info/
.DS_Store
kimi-cli/
*.pyc
__pycache__/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Build outputs
coverage/
*.log
npm-debug.log*
.turbo
.env.local

# AI tooling
.ai/
.worktrees/

# OS
Thumbs.db

# Temporary/build marker files
.buildcomplete
Used

# Accidental shell output files
ole.log*
t"
*"
*.log(*)
pool.end*
# Commit lockfile when registry/auth policy allows generation.
staging-report.json
postmerge-report.json
test-results/
playwright-report/
test-artifacts/
generated_documents/
.claude/worktrees/
.gstack/

# Tesseract decompressed-data cache (the vendored *.traineddata.gz is tracked)
/*.traineddata
tesseract-cache/

# Generated SBOM (produced in CI, published as an artifact)
sbom.cyclonedx.json
/release-evidence/
docs/reports/workflow-audit-results.json

# Golden-journey run artifacts (regenerated every run; the committed docs in
# docs/proof/golden-journeys describe the journeys, the manifests prove a run)
tests/golden-journeys/__reports__/
# Export-contract proof packets (regenerated every run; the tests are the truth)
tests/export-contract/__reports__/

# generated report intermediates
docs/audit-2026-07/evidence/.report-*.html

# eCTD qualification reports (generated by `npm run qualify:ectd`)
qualification-reports/

# Visual-QA working artifacts: captured surface markup, screenshots.
# Regenerate with scripts/visual-qa/ — never committed.
.visual-qa/

# Throwaway reproduction probes. Diagnosing a surface crash means mounting it
# under a scratch vitest config, and vitest cannot load a config from outside
# the project root — so both land here. They are transient by construction and
# must never be committed; ignoring the pattern is what stops a half-finished
# probe from riding along in someone else's commit.
probe.config.ts
scripts/visual-qa/probe-*.spec.tsx

# Plaintext database dumps must never ride along in a commit. scripts/backup.sh
# writes unencrypted pg_dump output here; the deploy path no longer invokes it,
# but the directory pattern is ignored so a stray local backup can never be
# committed or pushed with the source. (See SUPPLY-CHAIN / PRIVACY hardening.)
.backups/
*.sql.gz

# DR restore drill evidence (local runs; CI uploads it as an artifact)
.dr-evidence/

# ESLint JSON report: the CI lint step writes it so the warning ratchet can
# reuse that run instead of linting twice. A plain filename, not a trailing
# slash — `node_modules/` matched directories only, which is exactly how a
# symlink of that name slipped into history.
eslint-report.json
.scratch/
