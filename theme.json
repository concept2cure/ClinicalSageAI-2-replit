{
  "variant": "professional",
  "primary": "hsl(18, 60%, 60%)",
  "secondary": "hsl(100, 20%, 46%)",
  "accent": "hsl(18, 50%, 55%)",
  "appearance": "light",
  "radius": 0.5,
  "fontFamily": {
    "sans": "'Söhne', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
    "serif": "'Söhne Breit', Georgia, 'Times New Roman', serif",
    "mono": "'Söhne Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
  },
  "animation": {
    "default": "200ms cubic-bezier(0.2, 0, 0, 1)",
    "fast": "120ms cubic-bezier(0.2, 0, 0, 1)",
    "slow": "300ms cubic-bezier(0.2, 0, 0, 1)"
  },
  "shadows": {
    "sm": "0 1px 3px 0 rgba(0, 0, 0, 0.04)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.06), 0 2px 4px -2px rgba(0, 0, 0, 0.04)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.06), 0 4px 6px -4px rgba(0, 0, 0, 0.04)"
  }
}
