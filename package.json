{
  "name": "concept2cure-riai",
  "version": "1.0.0",
  "description": "Enterprise-grade regulatory intelligence platform for life sciences",
  "type": "module",
  "license": "MIT",
  "author": "Concept2Cure <info@concept2cure.pro>",
  "repository": {
    "type": "git",
    "url": "https://github.com/concept2cure/Concept2Cure.RI-2-replit.git"
  },
  "keywords": [
    "regulatory",
    "clinical",
    "fda",
    "510k",
    "cer",
    "ectd",
    "life-sciences",
    "medical-device"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "bash -lc 'source scripts/startup.sh && main && NODE_OPTIONS=\"--trace-warnings\" tsx --inspect=0 server/index.ts'",
    "dev:local": "bash -lc 'source scripts/startup.sh && main && NODE_OPTIONS=\"--trace-warnings\" tsx --inspect=0 server/index.ts'",
    "db:ensure": "tsx server/db/ensureCoreTables.ts",
    "db:check-assembly": "node scripts/check_assembly_docs.mjs",
    "smoke:e2e-assembly": "node scripts/e2e_smoke_assembly.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "NODE_OPTIONS=\"--max-old-space-size=6144\" tsc",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=6144\" tsc --noEmit",
    "check:security-patterns": "tsx scripts/check-security-patterns.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern scripts --ignore-pattern client/src --ignore-pattern tests/integration/api/vault.test.js --ignore-pattern server/events/eventBus.js --ignore-pattern server/routes/fda510k-routes.ts --ignore-pattern server/services/pdfGenerator.js",
    "lint:fix": "eslint . --fix --ignore-pattern dist --ignore-pattern scripts --ignore-pattern client/src --ignore-pattern tests/integration/api/vault.test.js --ignore-pattern server/events/eventBus.js --ignore-pattern server/routes/fda510k-routes.ts --ignore-pattern server/services/pdfGenerator.js",
    "test": "jest --config scripts/jest.config.js && NODE_OPTIONS=\"--max-old-space-size=4096\" vitest run --config vitest.config.ts",
    "ci:ban-new-pool": "bash scripts/ci/ban-new-pool.sh",
    "ci:migration-prefix-collisions": "node scripts/ci/check-migration-prefix-collisions.mjs",
    "ci:migration-prefix-collisions:strict": "node scripts/ci/check-migration-prefix-collisions.mjs --strict",
    "ci:migration-prefix-collisions:write-baseline": "node scripts/ci/check-migration-prefix-collisions.mjs --write-baseline",
    "ci:rls-allowlist-sync": "node scripts/ci/check-rls-allowlist-sync.mjs",
    "ci:tenant-column-types": "node scripts/ci/check-tenant-column-types.mjs",
    "ci:typecheck:no-regression": "node scripts/ci/typecheck-no-regression.mjs",
    "ci:typecheck:write-baseline": "node scripts/ci/typecheck-no-regression.mjs --write-baseline",
    "ci:governed-export-routes": "node scripts/ci/check-governed-export-routes.mjs",
    "ci:governed-export-consequence-shape": "node scripts/ci/check-governed-export-consequence-shape.mjs",
    "ci:check-docx-runtime": "node scripts/ci/check-docx-runtime-canonicality.mjs",
    "ci:check-pdf-runtime": "node scripts/ci/check-pdf-runtime-canonicality.mjs",
    "ci:check-embedding-runtime": "node scripts/ci/check-embedding-runtime-canonicality.mjs",
    "ci:jwt-verify-pinned": "node scripts/ci/check-jwt-verify-pinned.mjs",
    "ci:tenant-isolation": "node scripts/ci/check-tenant-isolation.mjs",
    "ci:tenant-isolation:no-regression": "node scripts/ci/check-tenant-isolation.mjs --strict-no-regression",
    "ci:tenant-isolation:strict": "node scripts/ci/check-tenant-isolation.mjs --strict",
    "ci:tenant-isolation:write-baseline": "node scripts/ci/check-tenant-isolation.mjs --write-baseline",
    "audit:orphaned-endpoints": "node scripts/audits/detect-orphaned-endpoints.mjs",
    "audit:orphaned-endpoints:strict": "node scripts/audits/detect-orphaned-endpoints.mjs --threshold 900",
    "audit:evidence-pack": "node scripts/audits/generate-evidence-pack.mjs",
    "ci:check-editor-integrity": "node scripts/ci/check-editor-extension-integrity.mjs",
    "ci:check-legacy-dep-quarantine": "node scripts/ci/check-legacy-dep-quarantine.mjs",
    "ci:audit-route-mounts": "node scripts/ci/audit-route-mounts.mjs",
    "ci:audit-route-mounts:no-regression": "node scripts/ci/audit-route-mounts.mjs --strict-no-regression --baseline docs/reports/route-mount-audit-baseline.json --owners docs/reports/route-mount-owners.json --write-json docs/reports/route-mount-audit-latest.json",
    "ci:audit-route-mounts:strict": "node scripts/ci/audit-route-mounts.mjs --strict-no-regression --baseline docs/reports/route-mount-audit-baseline.json --owners docs/reports/route-mount-owners.json --write-json docs/reports/route-mount-audit-latest.json",
    "ci:audit-route-mounts:full-strict": "node scripts/ci/audit-route-mounts.mjs --max-warnings 0 --owners docs/reports/route-mount-owners.json --write-json docs/reports/route-mount-audit-latest.json",
    "ci:no-mock-in-prod-routes": "node scripts/ci/check-no-mock-in-prod-routes.mjs",
    "ci:no-dev-auth-in-prod": "node scripts/ci/check-no-dev-auth-in-prod.mjs",
    "ci:no-dev-auth-in-prod:strict": "node scripts/ci/check-no-dev-auth-in-prod.mjs --strict",
    "ci:password-hygiene": "node scripts/ci/check-password-hygiene.mjs",
    "ci:password-hygiene:strict": "node scripts/ci/check-password-hygiene.mjs --strict",
    "db:seed:founder": "node scripts/seed-founder.mjs",
    "ci:token-cascade": "node scripts/ci/check-token-cascade.mjs",
    "ci:route-ownership-matrix": "node scripts/ci/check-route-ownership-matrix.mjs",
    "ci:route-ownership-matrix:check": "node scripts/ci/check-route-ownership-matrix.mjs --check",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/seed-ga-demo.mjs",
    "db:seed:admin": "node scripts/seed-admin.mjs",
    "db:seed:mdx-beta": "node scripts/seed-mdx-beta.mjs",
    "db:seed:mdx-content": "node scripts/seed-mdx-content.mjs",
    "db:seed:mdx-templates": "node scripts/seed-mdx-templates.mjs",
    "audit:archive": "tsx scripts/run-audit-archive.mjs",
    "audit:verify:24h": "node scripts/run-chain-verify.mjs --window=24h",
    "audit:verify:full": "node scripts/run-chain-verify.mjs --window=full",
    "db:check": "node scripts/db_check.js",
    "db:status": "node scripts/db_status.js",
    "db:readiness": "node scripts/db/readiness-audit.mjs",
    "readiness:check": "node scripts/readiness-check.mjs",
    "readiness:check:strict": "node scripts/readiness-check.mjs --strict",
    "db:readiness:strict": "node scripts/db/readiness-audit.mjs --strict-warn",
    "db:sync-manifest": "node scripts/db/sync-migration-manifest.mjs",
    "db:sync-manifest:check": "node scripts/db/sync-migration-manifest.mjs --check",
    "smoke:cerv2-workbench": "node scripts/smoke_cerv2_workbench.js",
    "cerv2:seed-demo": "node scripts/cerv2_seed_demo.js",
    "cerv2:verify": "node scripts/verify_cerv2_workbench.js",
    "cerv2:staging-verify": "node scripts/cerv2_staging_verify.mjs",
    "cerv2:deploy-rc": "bash scripts/cerv2_deploy_rc.sh",
    "cerv2:postmerge-verify": "node scripts/cerv2_postmerge_verify.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:test": "test-storybook",
    "prepare": "[ -n \"$CI\" ] || husky",
    "generate:risk-codes": "tsx scripts/generate-risk-code-types.ts",
    "ci:risk-codes": "npx tsx scripts/generate-risk-code-types.ts --check",
    "validate:ectd-stubs": "npx tsx scripts/validate-ectd-stubs-bundle.ts",
    "ci:ectd-stubs": "npx tsx scripts/validate-ectd-stubs-bundle.ts",
    "test:ana": "bash -lc 'DATABASE_URL=${DATABASE_URL:-postgres://user:pass@localhost:5432/testdb} SKIP_DB_STARTUP_TEST=${SKIP_DB_STARTUP_TEST:-true} vitest run tests/routes/ana-ri-health.test.ts tests/routes/ana-gap-analysis.test.ts tests/resolution/ana-orchestrator.test.ts server/services/__tests__/ana-ri.test.ts'",
    "ci:reasoning-tier-ga-readiness": "node scripts/ci/check-reasoning-tier-ga-readiness.mjs",
    "ci:reasoning-tier-uat-evidence": "node scripts/ci/check-reasoning-tier-uat-evidence.mjs",
    "ci:reasoning-tier-uat-evidence:strict": "node scripts/ci/check-reasoning-tier-uat-evidence.mjs --strict",
    "ci:reasoning-tier-readiness": "node scripts/ci/check-reasoning-tier-readiness-suite.mjs",
    "ci:reasoning-tier-readiness:strict": "node scripts/ci/check-reasoning-tier-readiness-suite.mjs --strict-uat-evidence",
    "ci:report-branch-drift": "node scripts/ci/report-branch-drift.mjs",
    "audit:last-20-prs": "node scripts/audits/generate-last-pr-wiring-audit.mjs --limit 20",
    "audit:last-20-prs:plan": "node scripts/audits/execute-last-pr-audit-build-plan.mjs --limit 20",
    "audit:last-20-prs:plan:strict": "node scripts/audits/execute-last-pr-audit-build-plan.mjs --limit 20 --strict",
    "audit:last-20-prs:plan:auto-install": "node scripts/audits/execute-last-pr-audit-build-plan.mjs --limit 20 --auto-install",
    "test:ops-audits": "node --test tests/ops/*.test.mjs",
    "audit:prune-artifacts": "node scripts/audits/prune-generated-audit-artifacts.mjs --retain-days 14",
    "audit:dead-code": "npx knip --no-exit-code --reporter compact",
    "audit:bundle": "ANALYZE=true vite build",
    "audit:repo-health": "node scripts/audits/repo-health-scan.mjs",
    "audit:repo-health:strict": "node scripts/audits/repo-health-scan.mjs --strict --owners docs/reports/repo-health-owners.json --write-markdown docs/reports/repo-health-scan-latest.md",
    "audit:repo-health:no-regression": "node scripts/audits/repo-health-scan.mjs --strict-no-regression --baseline docs/reports/repo-health-scan-latest.json --owners docs/reports/repo-health-owners.json --write-markdown docs/reports/repo-health-scan-latest.md",
    "audit:repo-health:full-strict": "node scripts/audits/repo-health-scan.mjs --strict --owners docs/reports/repo-health-owners.json --write-markdown docs/reports/repo-health-scan-latest.md",
    "beta:seed:510k": "node scripts/seed-beta-510k-workspace.mjs",
    "beta:typecheck": "NODE_OPTIONS=\"--max-old-space-size=4096\" tsc --noEmit -p tsconfig.beta-slice.json",
    "beta:founder-proof": "npx playwright test tests/e2e/510k-founder-path.e2e.spec.ts",
    "beta:proof": "node scripts/run-beta-founder-proof.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=0"
    ]
  },
