  "scripts": {
    "dev": "node cleanup-toastify.js && NODE_OPTIONS=\"--trace-warnings\" tsx --inspect server/index.ts",
    "dev:local": "bash -c 'source scripts/startup.sh && node cleanup-toastify.js && tsx --inspect server/index.ts'",
    "db:ensure": "tsx server/db/ensureCoreTables.ts",
    "build": "node cleanup-toastify.js && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "local-dev": "node server/local-dev.cjs",
    "validate": "python3 analysis/analysis.py data/sample_study/sample.csv && python3 analysis/check_metrics.py analysis/results/metrics.json 0.99 0.985",
    "validate:ci": "bash -lc 'pip install -r analysis/requirements.txt && python3 analysis/analysis.py data/sample_study/sample.csv && python3 analysis/check_metrics.py analysis/results/metrics.json 0.99 0.985 && python3 analysis/plot_metrics.py data/sample_study/sample.csv analysis/results/plot.png'",
    "check": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "db:push": "drizzle-kit push",
    "db:check": "node scripts/db_check.js",
    "db:status": "node scripts/db_status.js",
    "smoke:cerv2-workbench": "node scripts/smoke_cerv2_workbench.js",
    "cerv2:seed-demo": "node scripts/cerv2_seed_demo.js",
