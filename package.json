{
  "name": "clinicalsageai",
  "version": "1.0.0",
  "description": "Enterprise-grade regulatory intelligence platform for life sciences",
  "type": "module",
  "license": "MIT",
  "author": "Concept2Cure <info@concept2cure.pro>",
  "repository": {
    "type": "git",
    "url": "https://github.com/concept2cure/ClinicalSageAI-2-replit.git"
  },
  "keywords": [
    "regulatory",
    "clinical",
    "fda",
    "510k",
    "cer",
    "ectd",
    "life-sciences",
    "medical-device"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "bash -lc 'source scripts/startup.sh && main && NODE_OPTIONS=\"--trace-warnings\" tsx --inspect=0 server/index.ts'",
    "dev:local": "bash -lc 'source scripts/startup.sh && main && NODE_OPTIONS=\"--trace-warnings\" tsx --inspect=0 server/index.ts'",
    "db:ensure": "tsx server/db/ensureCoreTables.ts",
    "db:check-assembly": "node scripts/check_assembly_docs.mjs",
    "smoke:e2e-assembly": "node scripts/e2e_smoke_assembly.mjs",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "NODE_OPTIONS=\"--max-old-space-size=6144\" tsc",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=6144\" tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern scripts --ignore-pattern server/middleware/_archived --ignore-pattern client/src --ignore-pattern client/src/components/_deprecated --ignore-pattern client/src/pages/clean_temp.jsx --ignore-pattern client/src/pages/full_backup.jsx --ignore-pattern tests/integration/api/vault.test.js --ignore-pattern server/events/eventBus.js --ignore-pattern server/routes/fda510k-routes.ts --ignore-pattern server/routes/vault-dms.js --ignore-pattern server/services/pdfGenerator.js",
    "lint:fix": "eslint . --fix --ignore-pattern dist --ignore-pattern scripts --ignore-pattern server/middleware/_archived --ignore-pattern client/src --ignore-pattern client/src/components/_deprecated --ignore-pattern client/src/pages/clean_temp.jsx --ignore-pattern client/src/pages/full_backup.jsx --ignore-pattern tests/integration/api/vault.test.js --ignore-pattern server/events/eventBus.js --ignore-pattern server/routes/fda510k-routes.ts --ignore-pattern server/routes/vault-dms.js --ignore-pattern server/services/pdfGenerator.js",
    "test": "jest --config scripts/jest.config.js && vitest run --config vitest.config.ts",
    "ci:ban-new-pool": "bash scripts/ci/ban-new-pool.sh",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/seed-ga-demo.mjs",
    "db:seed:admin": "node scripts/seed-admin.mjs",
    "db:check": "node scripts/db_check.js",
    "db:status": "node scripts/db_status.js",
    "smoke:cerv2-workbench": "node scripts/smoke_cerv2_workbench.js",
    "cerv2:seed-demo": "node scripts/cerv2_seed_demo.js",
    "cerv2:verify": "node scripts/verify_cerv2_workbench.js",
    "cerv2:staging-verify": "node scripts/cerv2_staging_verify.mjs",
    "cerv2:deploy-rc": "bash scripts/cerv2_deploy_rc.sh",
    "cerv2:postmerge-verify": "node scripts/cerv2_postmerge_verify.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:test": "test-storybook",
    "prepare": "[ -n \"$CI\" ] || husky",
    "generate:risk-codes": "tsx scripts/generate-risk-code-types.ts",
    "ci:risk-codes": "tsx scripts/generate-risk-code-types.ts --check",
    "validate:ectd-stubs": "tsx scripts/validate-ectd-stubs-bundle.ts",
    "ci:ectd-stubs": "tsx scripts/validate-ectd-stubs-bundle.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=0"
    ]
  },
