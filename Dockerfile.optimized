# Multi-stage Docker build for reduced image size
# Build stage
FROM node:22-slim AS builder

WORKDIR /app

# Copy package files and npm config
COPY package*.json .npmrc ./

# Install all dependencies (including devDependencies for build)
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Build the application
RUN npm run build

# The production stage installs with --omit=dev, and the server bundle keeps
# every npm package external, so an import of a devDependency that survives
# into dist/index.js kills every container at module linking — which is what
# `vite` did until 2026-09-24. Refuse to produce that image: this reads the
# bundle's imports and the same lockfile the production stage installs from.
RUN node scripts/ci/check-server-bundle-prod-imports.mjs

# Production stage
FROM node:22-slim AS production

WORKDIR /app

# Install LibreOffice headless for DOCX-to-PDF conversion, and ocrmypdf for
# scanned-PDF OCR (pulls in tesseract-ocr, qpdf, unpaper as dependencies).
#
# PDF/A toolchain (runbook blocker B15, 2026-09-20). server/services/ectd/
# pdfa-pipeline.ts shells out to `gs` (convert to PDF/A-1b) and `verapdf`
# (validate), and xml-validator.ts to `xmllint`; each degrades to a silent
# no-op when its binary is absent, which is exactly what ECTD_REQUIRE_PDFA=true
# then turns into a hard production block. ghostscript was already here;
# libxml2-utils provides xmllint; default-jre-headless is the JRE veraPDF runs
# on (veraPDF is Java; the CLI jar below targets Java 8+). ca-certificates is
# explicit because curl's TLS trust is only a Recommends under
# --no-install-recommends.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libreoffice-common \
      libreoffice-writer \
      fonts-liberation \
      ghostscript \
      ocrmypdf \
      tesseract-ocr \
      curl \
      ca-certificates \
      default-jre-headless \
      libxml2-utils \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# veraPDF, pinned. The veraPDF Consortium publishes the CLI as a self-contained
# jar on Maven Central (org.verapdf.apps:cli — Main-Class
# org.verapdf.apps.GreenfieldCliWrapper). The checksum is the value published
# beside the artifact (cli-<version>.jar.sha256 on Maven Central), verified
# against the downloaded bytes on 2026-09-20; a build whose download does not
# match it FAILS rather than shipping an unverified validator. Bump the version
# and checksum together. /usr/local/bin/verapdf is the launcher pdfa-pipeline.ts
# (VERAPDF_BINARY, default `verapdf`) and pilot-go-no-go.mjs (VERAPDF_COMMAND)
# both resolve from PATH.
ARG VERAPDF_VERSION=1.30.2
ARG VERAPDF_SHA256=287cc9c9757f99dcff4a2d39b68268245b48103fb6af443162d5a29df2afa332
RUN set -eu; \
    mkdir -p /opt/verapdf; \
    curl -fsSL -o /opt/verapdf/verapdf-cli.jar \
      "https://repo1.maven.org/maven2/org/verapdf/apps/cli/${VERAPDF_VERSION}/cli-${VERAPDF_VERSION}.jar"; \
    echo "${VERAPDF_SHA256}  /opt/verapdf/verapdf-cli.jar" | sha256sum -c -; \
    printf '#!/bin/sh\nexec java -Djava.awt.headless=true -jar /opt/verapdf/verapdf-cli.jar "$@"\n' \
      > /usr/local/bin/verapdf; \
    chmod 0755 /usr/local/bin/verapdf

# The Amazon RDS certificate bundle (B11, 2026-09-23). Production verifies the
# database server's certificate — server/db/ssl.ts returns
# { rejectUnauthorized: true } in production, and the migration scripts verify
# for every non-local host (scripts/db/connection.mjs). RDS certificates chain to
# Amazon's RDS root CAs, and NONE of Node's 144 bundled roots is one of them
# (checked 2026-09-23: tls.rootCertificates contains no "Amazon RDS"). Without
# this file every connection from the API, the worker and the migration task
# fails with "self-signed certificate in certificate chain" — the same failure
# the CI production boot smoke avoids by setting NODE_EXTRA_CA_CERTS to its own
# server certificate (ci.yml, "Start PostgreSQL with TLS").
#
# Set in the IMAGE, not a task definition, so every container of it — including
# the migration task deploy-aws.yml derives — inherits it. Pinned the same way
# as veraPDF above: the checksum is of the global bundle fetched on 2026-09-23
# (108 certificates, 165,408 bytes). When AWS adds a CA the download will stop
# matching and the build FAILS; refresh the checksum deliberately, then confirm
# the instance's ca_cert_identifier chains to a certificate in the new bundle.
ARG RDS_CA_BUNDLE_SHA256=e5bb2084ccf45087bda1c9bffdea0eb15ee67f0b91646106e466714f9de3c7e3
RUN set -eu; \
    curl -fsSL -o /etc/ssl/certs/rds-global-bundle.pem \
      https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem; \
    echo "${RDS_CA_BUNDLE_SHA256}  /etc/ssl/certs/rds-global-bundle.pem" | sha256sum -c -
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem
# libpq (psql, and anything else linked against it) does not read
# NODE_EXTRA_CA_CERTS; with sslmode=verify-full it looks for
# ~/.postgresql/root.crt and fails. The same bundle, for the same reason.
ENV PGSSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem

# Build-time proof that the toolchain the pipeline invokes is present AND works:
# gs --version / verapdf --version / xmllint, then a real render → PDF/A-1b
# conversion → veraPDF PASS round-trip (and a FAIL on the unconverted source,
# so a validator that passes everything cannot pass this). An image that cannot
# do this is not built. See scripts/ops/check-pdfa-toolchain.sh.
COPY scripts/ops/check-pdfa-toolchain.sh /usr/local/bin/check-pdfa-toolchain
RUN chmod 0755 /usr/local/bin/check-pdfa-toolchain && \
    PDFA_CHECK_STRICT_PIPELINE_ARGS=1 VERAPDF_EXPECTED_VERSION="${VERAPDF_VERSION}" check-pdfa-toolchain

# Copy package files and npm config
COPY package*.json .npmrc ./

# Install production dependencies only
RUN npm ci --legacy-peer-deps --omit=dev && npm cache clean --force

# Copy built application from builder stage
COPY --from=builder /app/dist ./dist

# Copy necessary runtime files
COPY --from=builder /app/server ./server
COPY --from=builder /app/shared ./shared

# Migration payload. `npm run db:migrate:deploy` (scripts/db/deploy-migrate.mjs)
# runs from THIS image as a one-off ECS task before the services roll — see the
# `migrate` job in .github/workflows/deploy-aws.yml. It reads .sql out of BOTH
# trees, so both must be present or the deploy-time migration has nothing to
# apply. db/migrations was previously absent, which is one reason no production
# migration mechanism could exist.
#
# Only `pg` and `dotenv` are needed at runtime and both are production
# dependencies. install-fresh.mjs is deliberately NOT usable here — it shells out
# to drizzle-kit, a devDependency pruned by `npm ci --omit=dev`; from-scratch
# provisioning runs from a repo checkout, and deploy-migrate.mjs fails closed
# (exit 3) rather than pretending it can bootstrap a blank database.
COPY --from=builder /app/migrations ./migrations
COPY --from=builder /app/db/migrations ./db/migrations
COPY --from=builder /app/scripts/db ./scripts/db

# Vendored agency artifacts, read from disk at RUNTIME by cwd-relative
# drop-points that all resolve under `assets/`:
#
#   assets/estar-templates/        the official FDA eSTAR PDFs, pinned by their
#                                  checksums.txt — estar-template-registry.ts
#   assets/ectd-dtd/               eCTD DTDs — ectd/dtd-bundler.ts
#   assets/ectd-schema/            eCTD schemas — ectd/schema-bundler.ts
#   assets/fda-recognized-standards/  FDA's recognition list
#
# Without this the directory does not exist in the image, `listVendoredTemplates`
# returns [] and every produce answers 422 with "the official template is not
# vendored. Place it in assets/estar-templates/" — an instruction the client
# cannot act on, because it names a path inside a container they do not have.
# The whole official-eSTAR path was dead in the deployed product and worked only
# from a repo checkout. The escape hatches (ESTAR_TEMPLATE_DIR, ECTD_DTD_DIR,
# ECTD_SCHEMA_DIR) are set by no deployment surface — not deploy-aws.yml, not the
# ECS task definition, not either compose file — so nothing was covering for it.
#
# 11 MB, almost all of it the two eSTAR PDFs. They are committed and pinned;
# .dockerignore excludes only *.md here, so the PDFs and checksums.txt both ship
# and template integrity still verifies at runtime.
COPY --from=builder /app/assets ./assets

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser && chown -R appuser:appuser /app

# Expose port
EXPOSE 5000

# Switch to non-root user
USER appuser

# Docker's own health status, for docker compose (depends_on: service_healthy).
# NOT what ECS uses: ECS ignores this instruction and runs the task
# definition's healthCheck, which probes /healthz (liveness) on purpose —
# terraform/modules/ecs-fargate/main.tf says why a readiness probe there would
# replace every task whenever AnA or the database is down. Here, where an
# unhealthy container is reported rather than killed, readiness is the useful
# answer: /readyz fails closed on a down database or a verified missing schema.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD ["node", "-e", "const h=require('http');h.get('http://localhost:'+(process.env.PORT||5000)+'/readyz',r=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"]

# Start the application
CMD ["npm", "run", "start"]
