<document xmlns="urn:hl7-org:v3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <code code="51725-7" codeSystem="2.16.840.1.113883.6.1" displayName="Human Prescription Drug Labeling"/>
  <setId root="2.16.840.1.113883.19.000.9999.001.001.SPL"/>
  <versionNumber value="1.0"/>
