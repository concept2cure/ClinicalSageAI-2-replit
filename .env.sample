BASE_URL=http://localhost:3000

# ─── Neon Database Configuration ────────────────────────────────────
# Get your connection string from the Neon Console → "Connection Details".
# Paste the full postgresql:// URL below (do NOT include "psql " or quotes).
#
# Pooler endpoint (for the running application):
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Direct endpoint for migrations (optional — must NOT contain ".pooler."):
# DATABASE_URL_ADMIN=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.REGION.aws.neon.tech/neondb?sslmode=require

# Authentication Secrets
# Secret for signing JWT access tokens (use a strong random string, min 32 characters)
JWT_SECRET=your-jwt-secret-here-change-in-production
# Secret for signing JWT refresh tokens (use a different strong random string)
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here-change-in-production

# Redis Configuration
REDIS_URL=redis://redis:6379

# SMTP Configuration for Password Reset Emails
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Notifications
TEAMS_WEBHOOK_URL=
