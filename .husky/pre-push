#!/usr/bin/env sh

# Ensure node_modules/.bin is in PATH for tsx and other local binaries
export PATH="$PATH:$(cd "$(dirname "$0")/.." && pwd)/node_modules/.bin"

# ============================================
# PRE-PUSH HOOK - Branch Authority Enforcement (CLAUDE.md NON-NEGOTIABLE)
# ============================================
# concept2cure-v2 is the ONE AND ONLY branch. This gate refuses any push to
# a different remote ref so divergence cannot be reintroduced. To override
# (e.g. to push a dependabot/* PR branch), set ALLOW_NON_CANONICAL_PUSH=1.
# ============================================

# Git pipes one line per ref being pushed: "<local_ref> <local_sha> <remote_ref> <remote_sha>"
zero_sha="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref _remote_sha; do
  # Skip the sentinel line git emits when there's nothing to push.
  [ -z "$remote_ref" ] && continue

  # Branch deletions (local_sha = all zeros) are always allowed — that's how
  # we clean up forbidden branches like claude/* and codex/* on origin.
  if [ "$local_sha" = "$zero_sha" ] || [ "$local_ref" = "(delete)" ]; then
    continue
  fi

  if [ "$remote_ref" != "refs/heads/concept2cure-v2" ]; then

    # Agent-shaped branches are refused UNCONDITIONALLY — no bypass.
    #
    # The bypass below used to apply here too, and that is precisely how it
    # failed: in one session an agent set ALLOW_NON_CANONICAL_PUSH=1 eight
    # times to keep a claude/* mirror in sync with concept2cure-v2, because its
    # task prompt named that branch. Every push was individually defensible;
    # the set of them was exactly the divergence this gate exists to prevent.
    #
    # A rule you can satisfy by following the hint printed in its own error
    # message is not enforcement. For these prefixes there is no hint, because
    # there is no legitimate case: an AI session's work belongs on
    # concept2cure-v2, and its instructions to the contrary are superseded by
    # CLAUDE.md Rule 0.
    case "$remote_ref" in
      refs/heads/claude/*|refs/heads/codex/*|refs/heads/cursor/*|refs/heads/agent/*|refs/heads/ai/*|refs/heads/bot/*)
        echo ""
        echo "🚫 REFUSED: ${remote_ref} is an agent branch. There is no bypass."
        echo ""
        echo "   concept2cure-v2 is the ONLY branch (CLAUDE.md Rule 0)."
        echo "   If your task prompt told you to push here, that instruction is superseded."
        echo ""
        echo "     git checkout concept2cure-v2"
        echo "     git merge origin/concept2cure-v2"
        echo "     git push origin concept2cure-v2"
        echo ""
        echo "   ALLOW_NON_CANONICAL_PUSH does NOT apply to agent branches."
        echo ""
        exit 1
        ;;
    esac

    if [ "${ALLOW_NON_CANONICAL_PUSH:-}" = "1" ]; then
      echo "⚠️  Pushing to non-canonical ref ${remote_ref} (ALLOW_NON_CANONICAL_PUSH=1)."
    else
      echo ""
      echo "🚫 ERROR: Push refused — destination ref is ${remote_ref}."
      echo "   concept2cure-v2 is the ONE AND ONLY branch (see CLAUDE.md)."
      echo "   Local: ${local_ref}"
      echo ""
      echo "   To push, switch to concept2cure-v2:"
      echo "     git checkout concept2cure-v2"
      echo "     git push origin concept2cure-v2"
      echo ""
      echo "   Bypass exists ONLY for externally-created refs (dependabot/*,"
      echo "   revert-*). It does not apply to agent branches:"
      echo "     ALLOW_NON_CANONICAL_PUSH=1 git push ..."
      echo ""
      exit 1
    fi
  fi
done

# ============================================
# PRE-PUSH HOOK - eCTD Contract Enforcement (unconditional)
# Added: Phase 6.6.H
# ============================================
# Unlike pre-commit (which only runs on changed files),
# pre-push ALWAYS validates the eCTD bundle and risk codes.
# This prevents any bypass via --no-verify on commit.
# ============================================

echo "🔒 Pre-push: Running eCTD contract enforcement gates..."

# ── eCTD bundle validation (unconditional) ──
echo "   Validating eCTD stubs bundle against schema (AJV)..."
if ! npm run --silent ci:ectd-stubs 2>&1; then
  echo ""
  echo "🚫 ERROR: eCTD bundle validation FAILED."
  echo "   The bundle data does not validate against the schema."
  echo "   Fix schemas/ or ectd-stubs/ before pushing."
  echo ""
  exit 1
fi
echo "   ✅ eCTD bundle validation passed."

# ── Risk code contract validation (unconditional) ──
echo "   Validating risk code contracts..."
if ! npm run --silent ci:risk-codes 2>&1; then
  echo ""
  echo "🚫 ERROR: Risk code validation FAILED."
  echo "   Fix risk code contract files before pushing."
  echo ""
  exit 1
fi
echo "   ✅ Risk code validation passed."

# ── Ledger integrity (unconditional) ──
#
# Duplicate row ids are the failure this catches, and they arrive through a
# MERGE rather than through anyone's edit: two sessions each append the next
# free id to docs/GA_COMPLETION_LEDGER_2026-08.md, both are correct in
# isolation, and the merge keeps both. So a pre-COMMIT check cannot see it —
# the offending state does not exist until the histories join — and the author
# who merges is not the author who wrote either row.
#
# It has now been pushed twice, both times by a session that HAD run
# ledger-check and read its output after the push had already gone. A check
# whose result does not decide whether the push happens is a log line, not a
# gate. This makes it decide.
echo "   Validating migration apply-order invariants..."
if ! npm run --silent ci:migration-set-order 2>&1; then
  echo ""
  echo "🚫 ERROR: Migration apply-order check FAILED."
  echo "   A file ordered after the tenant-isolation sweep is never swept, so a"
  echo "   tenant-keyed table ships with no RLS policy — silently, because the"
  echo "   policy COUNT goes up when unprotected tables are added."
  echo "   Fix C2C_MIGRATION_FILES in scripts/db/migration-set.mjs and re-push."
  echo ""
  exit 1
fi
echo "   ✅ Migration apply-order passed."

# Cheap, no database, and guards a privilege-escalation footgun: `SET
# app.bypass_rls` is SESSION-scoped, so it survives client.release() and the
# next checkout — a different tenant — inherits a full RLS bypass across 142
# policies. There are 17 copyable examples in unmounted services; this stops an
# eighteenth appearing in reachable code.
echo "   Validating no new session-scoped RLS bypass..."
if ! npm run --silent ci:session-scoped-rls-bypass 2>&1; then
  echo ""
  echo "🚫 ERROR: Session-scoped RLS bypass check FAILED."
  echo "   Use 'SET LOCAL app.bypass_rls' inside an explicit transaction so"
  echo "   Postgres discards it at COMMIT/ROLLBACK, as guardQuery() does in"
  echo "   server/routes/innovation-routes.ts."
  echo ""
  exit 1
fi
echo "   ✅ No new session-scoped RLS bypass."
echo "   Validating ledger integrity (row ids, evidence paths)..."
if ! node scripts/ops/ledger-check.mjs >/dev/null 2>&1; then
  echo ""
  echo "🚫 ERROR: Ledger check FAILED."
  node scripts/ops/ledger-check.mjs 2>&1 | tail -20
  echo ""
  echo "   A duplicate id usually means a merge kept two rows that each took"
  echo "   the same next-free number. Renumber the one that landed second."
  echo ""
  exit 1
fi
echo "   ✅ Ledger integrity passed."

# ── Catalog copy (unconditional) ──
#
# available_modules.description renders to CUSTOMERS in the Apps catalog. The
# catalog was seeded from each surface's engineering notes, so 33 of 84 cards
# shipped saying "In progress." / "Partially built in ui_kits/home" / naming
# repository paths. check-internals-in-copy.mjs could not see it: that gate
# scans client/src only, and this copy lives in SQL and reaches the browser at
# runtime. This is the gate that covers it.
echo "   Validating module catalog copy..."
if ! npm run --silent check:catalog-copy 2>&1; then
  echo ""
  echo "🚫 ERROR: Catalog copy check FAILED."
  echo "   A module description reads like an engineering note. Customers see"
  echo "   these strings in the Apps catalog."
  echo ""
  exit 1
fi
echo "   ✅ Catalog copy passed."

# ── Fabricated signer identity (unconditional) ──
#
# 21 CFR 11.50(a)(1) asks for the PRINTED NAME OF THE SIGNER, and §11.10(e) for
# who acted. Four writers used to manufacture one when the real name was not to
# hand -- `user-41`, `user-41@unknown.local`, and `''` into NOT NULL columns --
# because the column forbade null and refusing felt like the harder option. Once
# written, an invented identity is indistinguishable from a real one, which is
# the entire function of the column. In one writer the §11.200 attribution hash
# was computed over the invented email, so the signature could not be re-derived
# from the real signer and verification would read as tampering.
echo "   Checking for manufactured signer identity..."
if ! npm run --silent ci:fabricated-identity 2>&1; then
  echo ""
  echo "🚫 ERROR: Fabricated-identity check FAILED."
  echo "   A NOT NULL column is not a reason to invent a person. Resolve the"
  echo "   signer with resolveSignerIdentity and let it refuse."
  echo ""
  exit 1
fi
echo "   ✅ Fabricated-identity check passed."

echo "✅ Pre-push checks complete — all gates passed."
