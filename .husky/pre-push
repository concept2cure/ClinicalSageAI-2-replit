#!/usr/bin/env sh

# Ensure node_modules/.bin is in PATH for tsx and other local binaries
export PATH="$PATH:$(cd "$(dirname "$0")/.." && pwd)/node_modules/.bin"

# ============================================
# PRE-PUSH HOOK - Branch Authority Enforcement (CLAUDE.md NON-NEGOTIABLE)
# ============================================
# concept2cure-v2 is the ONE AND ONLY branch. This gate refuses any push to
# a different remote ref so divergence cannot be reintroduced. To override
# (e.g. to push a dependabot/* PR branch), set ALLOW_NON_CANONICAL_PUSH=1.
# ============================================

# Git pipes one line per ref being pushed: "<local_ref> <local_sha> <remote_ref> <remote_sha>"
zero_sha="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref _remote_sha; do
  # Skip the sentinel line git emits when there's nothing to push.
  [ -z "$remote_ref" ] && continue

  # Branch deletions (local_sha = all zeros) are always allowed — that's how
  # we clean up forbidden branches like claude/* and codex/* on origin.
  if [ "$local_sha" = "$zero_sha" ] || [ "$local_ref" = "(delete)" ]; then
    continue
  fi

  if [ "$remote_ref" != "refs/heads/concept2cure-v2" ]; then

    # Agent-shaped branches are refused UNCONDITIONALLY — no bypass.
    #
    # The bypass below used to apply here too, and that is precisely how it
    # failed: in one session an agent set ALLOW_NON_CANONICAL_PUSH=1 eight
    # times to keep a claude/* mirror in sync with concept2cure-v2, because its
    # task prompt named that branch. Every push was individually defensible;
    # the set of them was exactly the divergence this gate exists to prevent.
    #
    # A rule you can satisfy by following the hint printed in its own error
    # message is not enforcement. For these prefixes there is no hint, because
    # there is no legitimate case: an AI session's work belongs on
    # concept2cure-v2, and its instructions to the contrary are superseded by
    # CLAUDE.md Rule 0.
    case "$remote_ref" in
      refs/heads/claude/*|refs/heads/codex/*|refs/heads/cursor/*|refs/heads/agent/*|refs/heads/ai/*|refs/heads/bot/*)
        echo ""
        echo "🚫 REFUSED: ${remote_ref} is an agent branch. There is no bypass."
        echo ""
        echo "   concept2cure-v2 is the ONLY branch (CLAUDE.md Rule 0)."
        echo "   If your task prompt told you to push here, that instruction is superseded."
        echo ""
        echo "     git checkout concept2cure-v2"
        echo "     git merge origin/concept2cure-v2"
        echo "     git push origin concept2cure-v2"
        echo ""
        echo "   ALLOW_NON_CANONICAL_PUSH does NOT apply to agent branches."
        echo ""
        exit 1
        ;;
    esac

    if [ "${ALLOW_NON_CANONICAL_PUSH:-}" = "1" ]; then
      echo "⚠️  Pushing to non-canonical ref ${remote_ref} (ALLOW_NON_CANONICAL_PUSH=1)."
    else
      echo ""
      echo "🚫 ERROR: Push refused — destination ref is ${remote_ref}."
      echo "   concept2cure-v2 is the ONE AND ONLY branch (see CLAUDE.md)."
      echo "   Local: ${local_ref}"
      echo ""
      echo "   To push, switch to concept2cure-v2:"
      echo "     git checkout concept2cure-v2"
      echo "     git push origin concept2cure-v2"
      echo ""
      echo "   Bypass exists ONLY for externally-created refs (dependabot/*,"
      echo "   revert-*). It does not apply to agent branches:"
      echo "     ALLOW_NON_CANONICAL_PUSH=1 git push ..."
      echo ""
      exit 1
    fi
  fi
done

# ============================================
# PRE-PUSH HOOK - eCTD Contract Enforcement (unconditional)
# Added: Phase 6.6.H
# ============================================
# Unlike pre-commit (which only runs on changed files),
# pre-push ALWAYS validates the eCTD bundle and risk codes.
# This prevents any bypass via --no-verify on commit.
# ============================================

echo "🔒 Pre-push: Running eCTD contract enforcement gates..."

# ── eCTD bundle validation (unconditional) ──
echo "   Validating eCTD stubs bundle against schema (AJV)..."
if ! npm run --silent ci:ectd-stubs 2>&1; then
  echo ""
  echo "🚫 ERROR: eCTD bundle validation FAILED."
  echo "   The bundle data does not validate against the schema."
  echo "   Fix schemas/ or ectd-stubs/ before pushing."
  echo ""
  exit 1
fi
echo "   ✅ eCTD bundle validation passed."

# ── Risk code contract validation (unconditional) ──
echo "   Validating risk code contracts..."
if ! npm run --silent ci:risk-codes 2>&1; then
  echo ""
  echo "🚫 ERROR: Risk code validation FAILED."
  echo "   Fix risk code contract files before pushing."
  echo ""
  exit 1
fi
echo "   ✅ Risk code validation passed."

# ── Ledger integrity (unconditional) ──
#
# Duplicate row ids are the failure this catches, and they arrive through a
# MERGE rather than through anyone's edit: two sessions each append the next
# free id to docs/GA_COMPLETION_LEDGER_2026-08.md, both are correct in
# isolation, and the merge keeps both. So a pre-COMMIT check cannot see it —
# the offending state does not exist until the histories join — and the author
# who merges is not the author who wrote either row.
#
# It has now been pushed twice, both times by a session that HAD run
# ledger-check and read its output after the push had already gone. A check
# whose result does not decide whether the push happens is a log line, not a
# gate. This makes it decide.
echo "   Validating migration apply-order invariants..."
if ! npm run --silent ci:migration-set-order 2>&1; then
  echo ""
  echo "🚫 ERROR: Migration apply-order check FAILED."
  echo "   A file ordered after the tenant-isolation sweep is never swept, so a"
  echo "   tenant-keyed table ships with no RLS policy — silently, because the"
  echo "   policy COUNT goes up when unprotected tables are added."
  echo "   Fix C2C_MIGRATION_FILES in scripts/db/migration-set.mjs and re-push."
  echo ""
  exit 1
fi
echo "   ✅ Migration apply-order passed."

# The sibling hazard to apply-order, and the same shape of invisible: the
# applier re-executes EVERY file on every deploy (scripts/db/migration-set.mjs
# applyMigrationFiles — no skip branch; the journal records a drift status the
# caller discards). So a DROP of something another file in the set re-creates
# either reverts on the next deploy or re-runs forever, and the deploy is green
# both ways. Cheap: it reads the files, no database.
echo "   Validating DROPs are replay-safe..."
if ! npm run --silent ci:migration-drop-safety 2>&1; then
  echo ""
  echo "🚫 ERROR: Replay-safe DROP check FAILED."
  echo "   Every migration re-runs on every deploy, so a DROP cannot remove what"
  echo "   another file in the set re-creates. Amend the creating migration in"
  echo "   place (CLAUDE.md RULE 1) instead of appending a DROP."
  echo ""
  exit 1
fi
echo "   ✅ Replay-safe DROPs passed."

# One level below table reachability: a column the server queries must be added
# by a migration an applier runs. A file that only ALTERs creates no table, so
# the table guard never sees it — six columns shipped that way, each a 42703 on
# every execution. Reads files only, no database (~1.5s).
echo "   Validating queried columns are reachable..."
if ! npm run --silent ci:column-reachability 2>&1; then
  echo ""
  echo "🚫 ERROR: Column reachability check FAILED."
  echo "   A column the server queries is added only by a migration nothing runs."
  echo "   Wire the migration after the file that creates its table (CLAUDE.md"
  echo "   RULE 1), or delete the dead reference. Never wire db/migrations/_consolidated/."
  echo ""
  exit 1
fi
echo "   ✅ Column reachability passed."

# Schema is created by an applier, never by a request. Production's runtime role
# cannot CREATE in public and owns no table, and PostgreSQL checks that BEFORE
# IF NOT EXISTS — so a runtime CREATE TABLE is refused in production even when
# the table exists, and succeeds on every developer machine. That is how the
# enterprise onboarding intake lost every request in production. Reads files
# only, no database (~1.5s).
echo "   Validating server code runs no DDL on the runtime connection..."
if ! npm run --silent ci:runtime-ddl 2>&1; then
  echo ""
  echo "🚫 ERROR: Runtime DDL check FAILED."
  echo "   Server code issues DDL that production's runtime role cannot run."
  echo "   Create the object in a migration listed in C2C_MIGRATION_FILES"
  echo "   (CLAUDE.md RULE 1); where a table might be missing, verify it with"
  echo "   to_regclass and fail loudly. Never create schema at request time."
  echo ""
  exit 1
fi
echo "   ✅ No runtime DDL."

# The third migration invariant, and the only one nothing was enforcing: every
# .sql file in db/migrations must appear in migrations_manifest.json, which is
# what orders them for the appliers that read it. `db:sync-manifest:check`
# existed and passed on demand, but ran nowhere automatic — so a migration added
# without running the sync simply drifted, and the drift was found by whoever
# next ran the check by hand. It had accumulated twice in one day by the time it
# was noticed. Cheap: it reads a directory listing and a JSON file, no database.
echo "   Validating the migration manifest tracks db/migrations..."
if ! npm run --silent db:sync-manifest:check 2>&1; then
  echo ""
  echo "🚫 ERROR: Migration manifest is out of sync with db/migrations/."
  echo "   Run:  npm run db:sync-manifest"
  echo "   then commit db/migrations/migrations_manifest.json with your migration."
  echo ""
  exit 1
fi
echo "   ✅ Migration manifest in sync."

# The Drizzle blind spot. check-security-patterns and the raw-SQL tenant scanner
# read string literals; a query built with the Drizzle query builder is invisible
# to both, which is how five of seven handlers in routes/c2c/tasks.ts shipped
# filtering on a serial projectId alone. Ratcheted against a baseline of 151
# pre-existing sites: this fails only on a NEW one.
echo "   Validating no new unscoped Drizzle query on tenant data..."
if ! npm run --silent ci:drizzle-tenant-scope 2>&1; then
  echo ""
  echo "🚫 ERROR: Drizzle tenant-scope check FAILED."
  echo "   A route handler takes its ids from the URL and a serial id is enumerable"
  echo "   across the estate. Constrain the organization in the statement."
  echo ""
  exit 1
fi
echo "   ✅ Drizzle tenant scope passed."

# A className that no stylesheet defines styles NOTHING, and nothing else in the
# pipeline says so: a test that drives a form never asks whether the form was
# visible, and `className` takes any string so the typechecker is silent too. A
# filing dialog shipped with six invented names and rendered with no backdrop,
# no dialog box, no header and no footer, with a green suite. Baselined against
# the two known-harmless semantic hooks: this fails only on a NEW one.
echo "   Validating every v2 className is defined in a stylesheet..."
if ! npm run --silent ci:undefined-css-classes 2>&1; then
  echo ""
  echo "🚫 ERROR: undefined CSS class check FAILED."
  echo "   The element renders unstyled and no test will tell you. Use the existing"
  echo "   vocabulary, or baseline the name WITH A REASON if it is a deliberate hook."
  echo ""
  exit 1
fi
echo "   ✅ v2 class names passed."

# `credentials: 'include'` is not authentication here: the /api gate reads the
# Authorization header and nothing else. Seven client call sites shipped without
# the bearer token, among them the shared e-signature modal (no signer could be
# verified) and every vault upload. authBoundary is 'warn' outside production, so
# a missing token can pass on a laptop and 401 for every user — and URLs passed
# as parameters or `${BASE}${path}` templates hid three of them from a sweep.
# This checks every raw fetch() whatever its URL, against the SERVER's own
# public allowlist. Cheap: no database, no build.
echo "   Validating every raw client fetch() sends the bearer token..."
if ! npm run --silent ci:unauthenticated-fetch 2>&1; then
  echo ""
  echo "🚫 ERROR: unauthenticated fetch check FAILED."
  echo "   Send headers: { ...getAuthHeaders() } (or buildAuthHeaders()), or use apiRequest."
  echo "   A public endpoint belongs on PUBLIC_API_ALLOWLIST, not in the gate's baseline."
  echo ""
  exit 1
fi
echo "   ✅ Client fetch() authentication passed."

# Cheap, no database, and guards a privilege-escalation footgun: `SET
# app.bypass_rls` is SESSION-scoped, so it survives client.release() and the
# next checkout — a different tenant — inherits a full RLS bypass across 142
# policies. There are 17 copyable examples in unmounted services; this stops an
# eighteenth appearing in reachable code.
echo "   Validating no new session-scoped RLS bypass..."
if ! npm run --silent ci:session-scoped-rls-bypass 2>&1; then
  echo ""
  echo "🚫 ERROR: Session-scoped RLS bypass check FAILED."
  echo "   Use 'SET LOCAL app.bypass_rls' inside an explicit transaction so"
  echo "   Postgres discards it at COMMIT/ROLLBACK, as guardQuery() does in"
  echo "   server/routes/innovation-routes.ts."
  echo ""
  exit 1
fi
echo "   ✅ No new session-scoped RLS bypass."
echo "   Validating ledger integrity (row ids, evidence paths)..."
if ! node scripts/ops/ledger-check.mjs >/dev/null 2>&1; then
  echo ""
  echo "🚫 ERROR: Ledger check FAILED."
  node scripts/ops/ledger-check.mjs 2>&1 | tail -20
  echo ""
  echo "   A duplicate id usually means a merge kept two rows that each took"
  echo "   the same next-free number. Renumber the one that landed second."
  echo ""
  exit 1
fi
echo "   ✅ Ledger integrity passed."

# ── Catalog copy (unconditional) ──
#
# available_modules.description renders to CUSTOMERS in the Apps catalog. The
# catalog was seeded from each surface's engineering notes, so 33 of 84 cards
# shipped saying "In progress." / "Partially built in ui_kits/home" / naming
# repository paths. check-internals-in-copy.mjs could not see it: that gate
# scans client/src only, and this copy lives in SQL and reaches the browser at
# runtime. This is the gate that covers it.
echo "   Validating module catalog copy..."
if ! npm run --silent check:catalog-copy 2>&1; then
  echo ""
  echo "🚫 ERROR: Catalog copy check FAILED."
  echo "   A module description reads like an engineering note. Customers see"
  echo "   these strings in the Apps catalog."
  echo ""
  exit 1
fi
echo "   ✅ Catalog copy passed."

# ── Fixture and mock data reaching a tenant (unconditional) ──
#
# docs/LAUNCH_DEFINITION_OF_DONE.md row D2 requires `ci:fixture-fallback` and
# `ci:no-mock-in-prod-routes` "set to block". Both ran only in ci.yml's `lint`
# job, which under RULE 0 (every change pushed straight to concept2cure-v2, no
# PRs) blocks nothing: a reintroduced fixture lands on the only branch and CI
# turns red afterwards. This hook is the one place that runs BEFORE the code
# lands, so this is where "block" is true.
#
# The two defects they catch are the ones a regulated tenant cannot detect:
# `live ?? FIXTURE` substitutes example rows on exactly the occasions the read
# failed (an empty tenant, an expired token, a 500), and a MOCK_* constant in a
# route handler ships invented records as the tenant's own. Both were shown
# failing on a launch file before this was added (periodic review 2026-09-24:
# `live ?? FIXTURE_DOCS` in Vault.tsx and `MOCK_PROGRAMS` in
# taskManagement.routes.ts, each rc=1, each restored byte-identical). ~0.5 s each.
echo "   Checking for fixture fallback in client surfaces..."
if ! npm run --silent ci:fixture-fallback 2>&1; then
  echo ""
  echo "🚫 ERROR: Ungated fixture fallback FAILED."
  echo "   A surface falls back to example rows when its read fails. Use"
  echo "   useSampleRows(live, fixture) behind the explicit sample-mode boundary."
  echo ""
  exit 1
fi
echo "   ✅ No ungated fixture fallback."

echo "   Checking for mock data in production routes..."
if ! npm run --silent ci:no-mock-in-prod-routes 2>&1; then
  echo ""
  echo "🚫 ERROR: Mock data in a production route FAILED."
  echo "   A route handler ships invented records. Fail closed instead."
  echo ""
  exit 1
fi
echo "   ✅ No mock data in production routes."

# ── Fabricated signer identity (unconditional) ──
#
# 21 CFR 11.50(a)(1) asks for the PRINTED NAME OF THE SIGNER, and §11.10(e) for
# who acted. Four writers used to manufacture one when the real name was not to
# hand -- `user-41`, `user-41@unknown.local`, and `''` into NOT NULL columns --
# because the column forbade null and refusing felt like the harder option. Once
# written, an invented identity is indistinguishable from a real one, which is
# the entire function of the column. In one writer the §11.200 attribution hash
# was computed over the invented email, so the signature could not be re-derived
# from the real signer and verification would read as tampering.
echo "   Checking for manufactured signer identity..."
if ! npm run --silent ci:fabricated-identity 2>&1; then
  echo ""
  echo "🚫 ERROR: Fabricated-identity check FAILED."
  echo "   A NOT NULL column is not a reason to invent a person. Resolve the"
  echo "   signer with resolveSignerIdentity and let it refuse."
  echo ""
  exit 1
fi
echo "   ✅ Fabricated-identity check passed."

# ── A Part 11 audit row written and its outcome discarded (unconditional) ──
#
# `auditService.logAction` does not reject when persistence fails. That is
# deliberate -- an audit-trail outage must not break the action it records -- so
# it RESOLVES an AuditWriteResult and says what happened in `persisted`.
# Two syntaxes throw that away: `void auditService.logAction(...)` and a
# statement-position `await auditService.logAction(...)`. Either way the call has
# two possible outcomes and one observable result: the caller, the HTTP envelope
# and the surface are byte-identical whether the §11.10(e) record exists or does
# not. Awaiting and ignoring reports no more than not awaiting at all -- the gate
# caught only the `void` form until 19 Sep 2026, when the awaited form turned out
# to be 134 sites against 0 remaining void ones.
#
# WO-16C finding 133 converted the PDEV approval and IND-clearance path. The
# baseline caps the rest per file WITH ITS COUNT, so a baselined file cannot
# quietly grow and a clean file cannot become dirty. Shrink it; never grow it.
echo "   Checking for a discarded Part 11 audit-write outcome..."
if ! npm run --silent ci:discarded-audit-write 2>&1; then
  echo ""
  echo "🚫 ERROR: Discarded audit-write outcome FAILED."
  echo "   Await the write and report it: if (!audit.persisted) log.error(...)."
  echo "   Where a client is answered, carry the outcome to it -- see"
  echo "   recordAuditRow in server/services/pdev/pdev-audit-record.ts."
  echo ""
  exit 1
fi
echo "   ✅ No discarded audit-write outcome."

# ── One source for a request's client address (D6) ───────────────────────────
#
# Until 23 Sep 2026 about twenty sites read X-Forwarded-For by hand and took its
# left-most entry -- the one every client writes -- into electronic_signatures,
# QMS approvals and the 11.10(e) trail. The client address is req.ip, resolved
# by the trust-proxy hop count (server/config/trust-proxy.ts) and read through
# server/utils/client-ip.ts.
echo "   Checking that the client address has one source..."
if ! npm run --silent ci:client-ip-single-source 2>&1; then
  echo ""
  echo "🚫 ERROR: A forwarding header is read, or trust proxy is set, outside its one place."
  echo "   Use clientIpOf(req) / req.ip / req.protocol (server/utils/client-ip.ts)."
  echo ""
  exit 1
fi
echo "   ✅ One source for the client address."

# ── A `sign` ledger row must come from a signature ceremony ──────────────────
#
# recordGovernedAction(…, command: 'sign') is read by an inspector as an
# electronic signature, and the primitive checks nothing. Until 2026-09-23 the
# protocol finalize and review-disposition routes, and an AnA tool, wrote such
# rows with no password re-entry and no electronic_signatures row. The baseline
# caps the remaining sites per file, each with a written reason; never grow it.
echo "   Checking that every sign ledger row comes from a signature ceremony..."
if ! npm run --silent ci:sign-ceremony 2>&1; then
  echo ""
  echo "🚫 ERROR: a sign ledger write without the signature ceremony."
  echo "   Re-verify the signer (verifyReauth) and write the signature row on the same"
  echo "   transaction -- see server/services/protocol-development/protocol-signature.ts."
  echo ""
  exit 1
fi
echo "   ✅ Every new sign ledger row has its ceremony."

# ── The commit has to build for somebody other than you ──────────────────────
#
# On 19 Sep 2026 an unanchored `uploads/` in .gitignore -- meant for the runtime
# directory at the repo root -- silently excluded `server/services/uploads/`,
# source added that minute. `git add -A` skipped it without a word, `git status`
# showed nothing, and the commit shipped a route importing a module that was not
# in the repository. Typecheck, 6,117 unit tests and the dbtests all passed,
# because every one of them reads the WORKING TREE. Only the index disagreed,
# and nothing consulted the index.
#
# This asks git, not the filesystem, whether each relative import in the pushed
# files resolves. It is scoped to what the push changes, so a lane answers for
# its own code and not the repo's backlog.
echo "   Checking that pushed imports resolve to tracked files..."
if ! npm run --silent ci:untracked-imports 2>&1; then
  echo ""
  echo "🚫 ERROR: An import resolves to a file git does not have."
  echo "   Usually a .gitignore pattern matching a source directory:"
  echo "     git check-ignore -v <path>"
  echo "   Anchor a root-directory pattern with a leading slash (/uploads/)."
  echo ""
  exit 1
fi
echo "   ✅ Pushed imports all resolve to tracked files."

# ── ESLint ERRORS, before the push rather than after ─────────────────────────
#
# ci:eslint-warning-ratchet gates the WARNING total across 1,790 files; it counts
# errors, prints them and passes, on the grounds that the Run ESLint step fails on
# those. True -- and that step runs in CI only, and the ratchet is too slow to be
# a pre-push gate, so nothing ran ESLint before a push at all. Two lanes shipped
# the same `no-regex-spaces` error to trunk within an hour on 19 Sep 2026, and
# each time the next person to push had to bisect somebody else's commit.
#
# Errors only -- warnings are the ratchet's job -- and only in the files this push
# changes, which is ~1.4s rather than minutes.
echo "   Checking for ESLint errors in the pushed files..."
if ! npm run --silent ci:pushed-lint-errors 2>&1; then
  echo ""
  echo "🚫 ERROR: ESLint errors in the files this push changes."
  echo "   These fail the Run ESLint step in CI; fix them here instead."
  echo ""
  exit 1
fi
echo "   ✅ No ESLint errors in the pushed files."

# ── TypeScript, before the push rather than after ────────────────────────────
#
# CI fails on ANY type error (.typecheck-baseline.json is ratcheted to 0). But
# Rule 0 means no PRs — every push lands on concept2cure-v2 directly — so CI
# only ever reports a type error AFTER it is on trunk. Nothing here typechecked.
# Twice on 19 Sep 2026 a red typecheck reached trunk that way, both tests not
# updated when a signature tightened, and each time the next person to push had
# to fix somebody else's error before their own would go green.
#
# This runs the SAME gate CI runs (typecheck-no-regression, with its guards for a
# compiler that died of OOM and a tsconfig that checked zero files), in its
# --incremental mode, and only when the push changes something that can change a
# type — .ts/.tsx (deletions included), typed JSON, tsconfig, package manifests.
# A docs- or SQL-only push skips it and says so. ~45 s warm, ~95 s after editing
# a widely imported file, ~5 min once after an install while the cache builds.
echo "   Typechecking (only if this push can change a type)..."
if ! npm run --silent ci:pushed-typecheck 2>&1; then
  echo ""
  echo "🚫 ERROR: The typecheck gate failed."
  echo "   This is the check CI would fail on — after the push had already landed."
  echo "   Fix the errors above and re-push."
  echo ""
  exit 1
fi
echo "   ✅ Typecheck passed (or nothing type-relevant was pushed)."

echo "✅ Pre-push checks complete — all gates passed."
