#!/usr/bin/env sh

# ============================================
# PRE-COMMIT HOOK - Tech Debt Prevention + eCTD Contract Enforcement
# Added: 2026-01-24 | Updated: Phase 6.6.H
# ============================================

echo "🔍 Running pre-commit checks..."

# Check for console.log in staged files (excluding tests, deprecated, and config files)
CONSOLE_LOGS=$(git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | grep -v '_deprecated' | grep -v '\.test\.' | grep -v '__tests__' | grep -v '\.config\.' | grep -v 'eslintrc' | xargs grep -l 'console\.log' 2>/dev/null || true)

if [ -n "$CONSOLE_LOGS" ]; then
  echo ""
  echo "⚠️  WARNING: console.log found in staged files:"
  echo "$CONSOLE_LOGS"
  echo ""
  echo "Consider using the logger utility instead:"
  echo "  import { logger } from '@/server/utils/logger';"
  echo "  logger.info('message');"
  echo ""
  echo "To bypass this check (not recommended): git commit --no-verify"
  echo ""
fi

# Check for actual imports from deprecated folders (not just the word "deprecated")
DEPRECATED_IMPORTS=$(git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | grep -v '_deprecated' | grep -v 'eslintrc' | xargs grep -lE "from ['\"].*/_deprecated/" 2>/dev/null || true)

if [ -n "$DEPRECATED_IMPORTS" ]; then
  echo ""
  echo "🚫 ERROR: Import from deprecated folder detected!"
  echo "$DEPRECATED_IMPORTS"
  echo ""
  echo "Deprecated folders should not be imported from."
  echo "See docs/ARCHITECTURE.md for the correct module structure."
  echo ""
  exit 1
fi

# Check file sizes for new/modified files
echo "📏 Checking file sizes..."
LARGE_FILES=""
for file in $(git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$'); do
  if [ -f "$file" ]; then
    LINES=$(wc -l < "$file")
    if [ "$LINES" -gt 500 ]; then
      LARGE_FILES="$LARGE_FILES\n  $file ($LINES lines)"
    fi
  fi
done

if [ -n "$LARGE_FILES" ]; then
  echo ""
  echo "⚠️  WARNING: Large files detected (>500 lines):"
  echo -e "$LARGE_FILES"
  echo ""
  echo "Consider splitting into smaller modules."
  echo "See docs/ARCHITECTURE.md for guidance."
  echo ""
fi

# ── Phase 6.6.H: eCTD Contract Enforcement ──────────────────────────────
# Run ci:ectd-stubs when schemas, ectd-stubs data, or contract files change.
# This is a HARD GATE — if the bundle data drifts from the schema, commit is blocked.

ECTD_CHANGED=$(git diff --cached --name-only | grep -E '(^schemas/|^ectd-stubs/|proof_pack_zip\.py|contract_hashes\.py|validate-ectd-stubs-bundle\.ts)' || true)

if [ -n "$ECTD_CHANGED" ]; then
  echo ""
  echo "🔒 eCTD contract files changed — running AJV bundle validation..."
  if ! npm run --silent ci:ectd-stubs 2>&1; then
    echo ""
    echo "🚫 ERROR: eCTD bundle validation FAILED."
    echo "   The bundle data does not validate against the schema."
    echo "   Fix schemas/ or ectd-stubs/ before committing."
    echo ""
    exit 1
  fi
  echo "✅ eCTD bundle validation passed."
fi

# Run ci:risk-codes when risk code contract files change.
RISK_CHANGED=$(git diff --cached --name-only | grep -E '(risk_codes|risk_vocab|predicate_intel/)' || true)

if [ -n "$RISK_CHANGED" ]; then
  echo ""
  echo "🔒 Risk code contract files changed — running risk code validation..."
  if ! npm run --silent ci:risk-codes 2>&1; then
    echo ""
    echo "🚫 ERROR: Risk code validation FAILED."
    echo "   Fix risk code contract files before committing."
    echo ""
    exit 1
  fi
  echo "✅ Risk code validation passed."
fi

echo "✅ Pre-commit checks complete"
