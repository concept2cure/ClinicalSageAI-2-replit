# ============================================================================
# Concept2Cure.RI — Beta Environment Configuration
# ============================================================================
# Copy this to .env.beta and fill in real values before deploying.
# Usage: cp .env.beta.example .env.beta && docker compose -f docker-compose.beta.yml --env-file .env.beta up --build
# ============================================================================

# ---------- REQUIRED ----------

# Database (if using docker-compose.beta.yml, these configure the local PG container)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=concept2cure
DB_PORT=5432

# External database URL (overrides local DB — use for Neon/RDS)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Auth
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# AI — at least one required
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ---------- OPTIONAL ----------

# Email
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
VITE_SENTRY_DSN=

# Storage (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Redis (auto-configured in docker-compose.beta.yml)
# REDIS_URL=redis://localhost:6379

# App
APP_PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# Beta-specific
BETA_MODE=true
VITE_SHOW_DEMO_LOGIN=true
ENABLE_DEBUG_ENDPOINTS=false
