# ============================================================================
# Concept2Cure.RI — Beta Environment Configuration
# ============================================================================
# Copy this to .env.beta and fill in real values before deploying.
# Usage: cp .env.beta.example .env.beta && docker compose -f docker-compose.beta.yml --env-file .env.beta up --build
# ============================================================================

# ---------- REQUIRED ----------

# Database (if using docker-compose.beta.yml, these configure the local PG container)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=concept2cure
DB_PORT=5432

# External database URL (overrides local DB — use for Neon/RDS)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Non-superuser runtime role. The beta stack runs NODE_ENV=production, and
# production requires RLS_ENFORCE=on, under which the boot posture probe REFUSES
# a superuser / BYPASSRLS runtime role — so the request-serving pool cannot be
# the DB owner above. Mint the role once against this database with
#   APP_SERVICE_DB_PASSWORD=... node scripts/db/install-fresh.mjs
# then point the app at it. docker-compose.beta.yml requires both.
APP_SERVICE_DB_PASSWORD=CHANGE_ME_MIN_12_CHARS
APP_DATABASE_URL=postgresql://app_service:CHANGE_ME_MIN_12_CHARS@db:5432/concept2cure?sslmode=require
# Literal `on` only — aliases are rejected by the production kill-switch.
RLS_ENFORCE=on

# ---------- Auth & crypto (the production boot contract) ----------
# NODE_ENV=production below means the server EXITS at startup if any of these is
# missing or invalid — it never boots degraded. See .env.example for the
# per-variable source references. Generate each INDEPENDENTLY; reusing one value
# across two collapses separate trust domains (and REFRESH_TOKEN_SECRET is
# explicitly rejected when it equals JWT_SECRET):
#   openssl rand -base64 48 | tr -d '\n='
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
SESSION_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_STRING
REFRESH_TOKEN_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_STRING
MFA_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_STRING
AUDIT_HMAC_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_STRING
AUDIT_HMAC_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_STRING
CONNECTOR_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_STRING

# AI — at least one required
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ---------- OPTIONAL ----------

# Email
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
VITE_SENTRY_DSN=

# Storage (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Redis (auto-configured in docker-compose.beta.yml)
# REDIS_URL=redis://localhost:6379

# App
APP_PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# Beta-specific
BETA_MODE=true
VITE_SHOW_DEMO_LOGIN=true
ENABLE_DEBUG_ENDPOINTS=false

# Boot-time invariant checks (decision register #727 item 7).
# Staging-first rollout: enable here, watch for invariant noise, then enable
# in production once a full release cycle passes with zero false halts.
STRICT_STARTUP_INVARIANTS=true

# Security-alert forwarding (decision register #727 item 9).
# When set, [SECURITY]-class events (tenant impersonation blocks, tenant
# header mismatches, retention notify failures) POST to this JSON webhook.
SECURITY_ALERT_WEBHOOK_URL=
