{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "server/index.ts",
    "client/src/main.tsx",
    "client/src/concept2cure/ZenApp.tsx"
  ],
  "project": [
    "server/**/*.ts",
    "client/src/**/*.{ts,tsx}",
    "shared/**/*.ts"
  ],
  "ignore": [
    "**/node_modules/**",
    "dist/**",
    "scripts/**",
    "tests/**",
    "**/_archived/**",
    "**/_deprecated/**",
    "**/migrations/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.figma.tsx",
    "services/**",
    "backend/**",
    "workers/**",
    "agents/**",
    "agent/**",
    "lumen_cortex/**",
    "lumen_reports_backend/**",
    "analytics-engine/**",
    "shadow_service/**",
    "ind_automation/**",
    "drizzle.config.ts"
  ],
  "ignoreDependencies": [
    "@types/*",
    "tsx",
    "esbuild",
    "drizzle-kit",
    "autoprefixer",
    "postcss",
    "tailwindcss",
    "tailwindcss-animate",
    "@tailwindcss/*",
    "@replit/*",
    "@vitejs/*",
    "vite",
    "typescript",
    "husky",
    "eslint*",
    "@typescript-eslint/*",
    "babel-jest",
    "ts-jest",
    "jest*",
    "vitest",
    "@testing-library/*",
    "@babel/*",
    "supertest",
    "ajv*"
  ],
  "ignoreBinaries": ["bash", "node", "npx"]
}
