// datasource & generator
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Priority { 
  LOW 
  MEDIUM 
  HIGH 
  CRITICAL 
}

enum TaskStatus { 
  OPEN 
  IN_REVIEW 
  BLOCKED 
  DONE 
}

enum GateStatus { 
  NOT_STARTED 
  IN_PROGRESS 
  BLOCKED 
  READY_FOR_QA 
  APPROVED 
}

enum Severity { 
  INFO 
  WARNING 
  ERROR 
}

enum IssueStatus { 
  OPEN 
  WAIVED 
  CLOSED 
}

enum Impact { 
  LOW 
  MEDIUM 
  HIGH 
}

enum Probability { 
  LOW 
  MEDIUM 
  HIGH 
}

enum MethodStatus { 
  DRAFT 
  IN_VALIDATION 
  APPROVED 
}

model CmcTask {
  id        String     @id @default(uuid()) @db.Uuid
  productId String
  section   String?
  title     String
  why       String?
  owner     String
  role      String?
  priority  Priority
  status    TaskStatus @default(OPEN)
  dueDate   DateTime?  @db.Timestamptz
  link      String?
  createdAt DateTime   @default(now()) @db.Timestamptz

  @@index([productId, dueDate], map: "idx_cmc_tasks_prod_due")
}

model CmcStageGate {
  id        String     @id @default(uuid()) @db.Uuid
  productId String
  name      String
  owner     String
  status    GateStatus
  startDate DateTime?  @db.Timestamptz
  dueDate   DateTime?  @db.Timestamptz
  progress  Int        @default(0)
  createdAt DateTime   @default(now()) @db.Timestamptz

  @@index([productId, dueDate], map: "idx_cmc_stage_prod_due")
}

model CmcValidationIssue {
  id        String     @id @default(uuid()) @db.Uuid
  productId String
  section   String
  ruleId    String
  severity  Severity
  title     String
  owner     String?
  createdAt DateTime   @default(now()) @db.Timestamptz
  status    IssueStatus @default(OPEN)

  @@index([productId, severity], map: "idx_cmc_issues_prod_sev")
}

model CmcRisk {
  id          String     @id @default(uuid()) @db.Uuid
  productId   String
  title       String
  owner       String
  impact      Impact
  probability Probability
  mitigation  String?
  status      String     @default("OPEN")
  createdAt   DateTime   @default(now()) @db.Timestamptz
}

model CmcMethod {
  id        String       @id @default(uuid()) @db.Uuid
  productId String
  name      String
  status    MethodStatus @default(DRAFT)
  createdAt DateTime     @default(now()) @db.Timestamptz
}

// --- Models added to preserve existing DB tables and avoid destructive sync ---
model AiTokenBudget {
  id         Int      @id
  daily_limit BigInt? @db.BigInt
  tokens_used BigInt? @db.BigInt
  reset_at   DateTime? @db.Timestamptz
  created_at DateTime? @default(now()) @db.Timestamptz
  updated_at DateTime? @default(now()) @db.Timestamptz

  @@map("ai_token_budget")
}

model CoauthorValidationRules {
  id                 Int      @id @default(autoincrement())
  rule_id            String   @unique
  organization_id    Int?
  module             String
  section            String?
  agency             String
  category           String
  rule_type          String
  severity           String
  rule_name          String
  description        String
  check_logic        Json
  remediation_text   String
  auto_fix_available Boolean? @default(false)
  auto_fix_logic     Json?
  is_active          Boolean? @default(true)
  created_at         DateTime? @default(now()) @db.Timestamptz
  updated_at         DateTime? @default(now()) @db.Timestamptz

  @@map("coauthor_validation_rules")
  @@index([module], map: "validation_rules_module_idx")
  @@index([agency], map: "validation_rules_agency_idx")
  @@index([severity], map: "validation_rules_severity_idx")
  @@index([category], map: "validation_rules_category_idx")
  @@index([rule_type], map: "validation_rules_type_idx")
}

model Permission {
  id                  Int      @id @default(autoincrement())
  is_system_permission Boolean? @default(false)
  created_at          DateTime? @default(now()) @db.Timestamp
  resource            String
  action              String
  description         String?

  @@map("permissions")
}

model Role {
  id            Int      @id @default(autoincrement())
  updated_at    DateTime? @default(now()) @db.Timestamp
  level         Int?     @default(10)
  is_global     Boolean? @default(false)
  is_external   Boolean? @default(false)
  permissions   Json?    @default("{}")
  is_system_role Boolean? @default(false)
  created_at    DateTime? @default(now()) @db.Timestamp
  name          String
  description   String?
  icon          String?
  color_code    String?  @default("#6B7280")

  @@map("roles")
}