// datasource & generator
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Priority { 
  LOW 
  MEDIUM 
  HIGH 
  CRITICAL 
}

enum TaskStatus { 
  OPEN 
  IN_REVIEW 
  BLOCKED 
  DONE 
}

enum GateStatus { 
  NOT_STARTED 
  IN_PROGRESS 
  BLOCKED 
  READY_FOR_QA 
  APPROVED 
}

enum Severity { 
  INFO 
  WARNING 
  ERROR 
}

enum IssueStatus { 
  OPEN 
  WAIVED 
  CLOSED 
}

enum Impact { 
  LOW 
  MEDIUM 
  HIGH 
}

enum Probability { 
  LOW 
  MEDIUM 
  HIGH 
}

enum MethodStatus { 
  DRAFT 
  IN_VALIDATION 
  APPROVED 
}

model CmcTask {
  id        String     @id @default(uuid()) @db.Uuid
  productId String
  section   String?
  title     String
  why       String?
  owner     String
  role      String?
  priority  Priority
  status    TaskStatus @default(OPEN)
  dueDate   DateTime?  @db.Timestamptz
  link      String?
  createdAt DateTime   @default(now()) @db.Timestamptz

  @@index([productId, dueDate], map: "idx_cmc_tasks_prod_due")
}

model CmcStageGate {
  id        String     @id @default(uuid()) @db.Uuid
  productId String
  name      String
  owner     String
  status    GateStatus
  startDate DateTime?  @db.Timestamptz
  dueDate   DateTime?  @db.Timestamptz
  progress  Int        @default(0)
  createdAt DateTime   @default(now()) @db.Timestamptz

  @@index([productId, dueDate], map: "idx_cmc_stage_prod_due")
}

model CmcValidationIssue {
  id        String     @id @default(uuid()) @db.Uuid
  productId String
  section   String
  ruleId    String
  severity  Severity
  title     String
  owner     String?
  createdAt DateTime   @default(now()) @db.Timestamptz
  status    IssueStatus @default(OPEN)

  @@index([productId, severity], map: "idx_cmc_issues_prod_sev")
}

model CmcRisk {
  id          String     @id @default(uuid()) @db.Uuid
  productId   String
  title       String
  owner       String
  impact      Impact
  probability Probability
  mitigation  String?
  status      String     @default("OPEN")
  createdAt   DateTime   @default(now()) @db.Timestamptz
}

model CmcMethod {
  id        String       @id @default(uuid()) @db.Uuid
  productId String
  name      String
  status    MethodStatus @default(DRAFT)
  createdAt DateTime     @default(now()) @db.Timestamptz
}