  isActive      Boolean   @default(true) @map("is_active")
  messageCount  Int       @default(0) @map("message_count")
  
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastMessageAt DateTime  @default(now()) @map("last_message_at") @db.Timestamptz
  
  messages      RagMessage[]

  @@index([userId])
  @@index([orgId])
  @@map("rag_conversations")
  @@schema("ai")
}

model RagMessage {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  conversation    RagConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  role            String
  content         String
  
  retrievedChunks String[]  @map("retrieved_chunks") @db.Uuid
  retrievalScores Decimal[] @map("retrieval_scores")
  
  modelUsed       String?   @map("model_used")
  promptTokens    Int?      @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  
  isHelpful       Boolean?  @map("is_helpful")
  userCorrection  String?   @map("user_correction")
  
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([conversationId])
  @@map("rag_messages")
  @@schema("ai")
}
