# --- AI Providers (Server-side) ---
# DO NOT commit real keys. Put secrets in .env.local (gitignored) or your deployment secrets manager.

# Gemini / Google Generative Language API
# Either works; GEMINI_API_KEY is preferred.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Force-disable Gemini entirely (useful if your Google key/quota is problematic)
DISABLE_GEMINI=

# Optional (non-secret) metadata for visibility/debugging (safe to commit as placeholders)
GEMINI_KEY_NAME=
GEMINI_PROJECT_ID=
GEMINI_PROJECT_NUMBER=

# Preferred Gemini model (server will fall back if preview not available)
GEMINI_MODEL=gemini-3-flash-preview

# OpenAI
OPENAI_API_KEY=


# DocuShare OEM Integration Configuration
DOCUSHARE_API_URL=https://docushare.yourcompany.com/docushare/dsweb/Services
DOCUSHARE_API_VERSION=7.5
DOCUSHARE_API_KEY=your_secure_api_key_from_xerox
DOCUSHARE_OEM_ID=your_oem_id_from_xerox
DOCUSHARE_USERNAME=trialsage_service_account
DOCUSHARE_PASSWORD=your_secure_password
DOCUSHARE_DOMAIN=your_domain
DOCUSHARE_COLLECTION_ID=1
DOCUSHARE_TENANT_ISOLATION=true
DOCUSHARE_ENCRYPTION_KEY=your_32_character_encryption_key

# DocuShare Security Settings
DOCUSHARE_SSL_VERIFY=true
DOCUSHARE_SESSION_TIMEOUT=3600
DOCUSHARE_MAX_FILE_SIZE=104857600
DOCUSHARE_ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt,.xml,.zip,.csv,.xlsx
DOCUSHARE_CONNECTION_TIMEOUT=30000
DOCUSHARE_RETRY_ATTEMPTS=3
DOCUSHARE_RATE_LIMIT_REQUESTS=100
DOCUSHARE_RATE_LIMIT_WINDOW=60000

# OEM Customization Settings
DOCUSHARE_CUSTOM_FIELDS=project_id,regulatory_phase,submission_type,study_id,protocol_version
DOCUSHARE_AUDIT_ENABLED=true
DOCUSHARE_VERSIONING_ENABLED=true
DOCUSHARE_WORKFLOW_ENABLED=true
DOCUSHARE_HEALTH_CHECK_INTERVAL=300000

# Backend Integration Settings
DOCUSHARE_BACKEND_HOST=0.0.0.0
DOCUSHARE_BACKEND_PORT=5000
DOCUSHARE_LOG_LEVEL=info
DOCUSHARE_METRICS_ENABLED=true
