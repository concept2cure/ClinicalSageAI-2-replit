# Concept2Cure.RI Environment Configuration
# Copy this file to .env and fill in the values

# ─── Neon Database Configuration ────────────────────────────────────
# Get your connection string from the Neon Console: https://console.neon.tech
#
# Steps:
#   1. Log into the Neon Console and select your project.
#   2. Go to "Connection Details" → copy the connection string.
#   3. Paste it below as DATABASE_URL (remove any leading "psql " or quotes).
#
# Example (pooler endpoint — used by the application):
#   DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-name-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# For migrations only (optional — direct endpoint, not pooler):
#   DATABASE_URL_ADMIN=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-name.us-east-1.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini / Nano Banana (image generation, presentations)
# Get a free key at https://aistudio.google.com/apikey (50 req/day free tier)
GOOGLE_GEMINI_API_KEY=

# Server
BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=5000
FASTAPI_SERVER=http://localhost:8000

# Auth (JWT_SECRET is REQUIRED — server will not start without it)
SESSION_SECRET=your-secret-here
JWT_SECRET=your-jwt-secret-here-change-in-production
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here-change-in-production

# Redis Configuration
REDIS_URL=redis://redis:6379

# LiteLLM gateway (optional)
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL_MAP_JSON=
LITELLM_TIMEOUT_MS=45000

# Langfuse observability (optional)
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=concept2cure-server
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# OPA policy engine (optional)
OPA_ENABLED=false
OPA_MODE=observe
OPA_BASE_URL=http://localhost:8181
OPA_POLICY_PATH=concept2cure/allow
OPA_TIMEOUT_MS=3000

# LLM Routing Policy Defaults (multi-provider-llm)
# INTERACTIVE | BATCH (default: INTERACTIVE)
LLM_ROUTING_DEFAULT_WORKLOAD_CLASS=INTERACTIVE
# Optional soft budget per 1k tokens (e.g., 0.01)
LLM_ROUTING_MAX_COST_PER_1K_TOKENS=
# true/false; if unset defaults by workload class
LLM_ROUTING_PREFER_LOW_LATENCY=true
# Optional admission-control caps by workload class
LLM_ROUTING_INTERACTIVE_MAX_TOKENS=4096
LLM_ROUTING_BATCH_MAX_TOKENS=8192

# Embedding Cache Controls (vectorization worker)
# Cache TTL in ms (default: 900000)
EMBEDDING_CACHE_TTL_MS=900000
# Max cache entries (default: 10000)
EMBEDDING_CACHE_MAX_ENTRIES=10000
# Emit cache hit/miss log every N lookups (default: 20)
EMBEDDING_CACHE_LOG_EVERY=20

# Stripe Billing (Checkout + Link)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP Configuration for Password Reset Emails
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Notifications
TEAMS_WEBHOOK_URL=

# DocuShare OEM Integration Configuration
DOCUSHARE_API_URL=https://docushare.yourcompany.com/docushare/dsweb/Services
DOCUSHARE_API_VERSION=7.5
DOCUSHARE_API_KEY=your_secure_api_key_from_xerox
DOCUSHARE_OEM_ID=your_oem_id_from_xerox
DOCUSHARE_USERNAME=trialsage_service_account
DOCUSHARE_PASSWORD=your_secure_password
DOCUSHARE_DOMAIN=your_domain
DOCUSHARE_COLLECTION_ID=1
DOCUSHARE_TENANT_ISOLATION=true
DOCUSHARE_ENCRYPTION_KEY=your_32_character_encryption_key

# DocuShare Security Settings
DOCUSHARE_SSL_VERIFY=true
DOCUSHARE_SESSION_TIMEOUT=3600
DOCUSHARE_MAX_FILE_SIZE=104857600
DOCUSHARE_ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt,.xml,.zip,.csv,.xlsx
DOCUSHARE_CONNECTION_TIMEOUT=30000
DOCUSHARE_RETRY_ATTEMPTS=3
DOCUSHARE_RATE_LIMIT_REQUESTS=100
DOCUSHARE_RATE_LIMIT_WINDOW=60000

# OEM Customization Settings
DOCUSHARE_CUSTOM_FIELDS=project_id,regulatory_phase,submission_type,study_id,protocol_version
DOCUSHARE_AUDIT_ENABLED=true
DOCUSHARE_VERSIONING_ENABLED=true
DOCUSHARE_WORKFLOW_ENABLED=true
DOCUSHARE_HEALTH_CHECK_INTERVAL=300000

# Backend Integration Settings
DOCUSHARE_BACKEND_HOST=0.0.0.0
DOCUSHARE_BACKEND_PORT=5000
DOCUSHARE_LOG_LEVEL=info
DOCUSHARE_METRICS_ENABLED=true

# CERV2 workbench smoke test
CERV2_PROGRAM_ID=replace-with-program-id
CERV2_BASE_URL=http://localhost:3000

# Signature Configuration (21 CFR Part 11)
CONCEPT2CURE_SIGNER_MODE=dev  # dev | hsm_kms | hsm_vault
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/abc123
AWS_REGION=us-east-1
KMS_CERT_PATH=/secure/certs/signing.crt
KMS_KEY_CUSTODY_SOP=SOP-SEC-001
KMS_ROTATION_POLICY=annual
DEV_KEY_PATH=/optional/dev-key.pem
DEV_CERT_PATH=/optional/dev-cert.pem
