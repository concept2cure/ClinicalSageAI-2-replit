# Staging tfvars — do NOT commit secrets here.
# Staging is terraform/stack at smaller sizes (environments/staging/main.tf). Use
# different values from production for every secret, and a staging domain.
# Pass secrets via: terraform apply -var="jwt_secret=..." -var="openai_api_key=..."
# Or use TF_VAR_jwt_secret and TF_VAR_openai_api_key environment variables.
# cloudfront_origin_secret likewise, e.g. TF_VAR_cloudfront_origin_secret="$(openssl rand -hex 32)".
#
# The production boot contract (D1 brief B3). Each has no default, so plan stops
# until it is supplied. Generate as SOP-SEC-001 §4 describes; each is >= 32
# characters, and the pairs noted must differ:
#   TF_VAR_jwt_secret                  openssl rand -hex 32
#   TF_VAR_refresh_token_secret        openssl rand -hex 32   (must differ from jwt_secret)
#   TF_VAR_mfa_encryption_key          openssl rand -hex 32
#   TF_VAR_audit_hmac_key              openssl rand -hex 32   (must differ from audit_hmac_secret)
#   TF_VAR_audit_hmac_secret           openssl rand -hex 32
#   TF_VAR_connector_encryption_key    openssl rand -hex 32
#   TF_VAR_smtp_user / TF_VAR_smtp_pass  from the SMTP provider (login OTP delivery)
# The database passwords are generated by Terraform (random_password) and never
# need to be supplied.
#
# AI provider placement (D1 brief B4) is the founder's compliance decision; there
# is deliberately no example value. It is the JSON object
# server/services/ai-gateway/sensitive-placement-policy.ts reads. Record the
# chosen value and the date in the D1 evidence.
#   TF_VAR_ai_provider_placement_approvals='{...}'

region          = "us-east-1"
vpc_cidr        = "10.9.0.0/16"
public_subnets  = ["10.9.101.0/24", "10.9.102.0/24"]
private_subnets = ["10.9.1.0/24", "10.9.2.0/24"]
azs             = ["us-east-1a", "us-east-1b"]

rds_instance_class = "db.t3.small"
api_cpu            = 512
api_memory         = 1024
api_desired_count  = 1
worker_desired_count = 0

# Replace with your actual ACM certificate ARN
acm_certificate_arn       = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/REPLACE_ME"
cloudfront_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/REPLACE_ME"
# Required: the API is reachable through CloudFront alone, and CloudFront checks
# the ALB's certificate against these names, so acm_certificate_arn must cover them too.
domain_aliases             = ["staging.example.com"] # REPLACE_ME

# Login OTP is the mandatory second factor: without working SMTP no one can sign
# in. Port 465 (implicit TLS) is the only one accepted. The sender's domain must
# be verified with the provider. After apply, prove delivery to a real inbox:
#   npm run pilot:verify-otp -- <external-address>
smtp_host = "email-smtp.us-east-1.amazonaws.com" # REPLACE_ME
smtp_from = "noreply@example.com"                # REPLACE_ME
